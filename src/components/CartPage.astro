</style>

<script
  is:inline
  define:vars={{ suggestionData: suggestionPayload }}
>
  (async () => {
  const cartApi = window.RivaCart || await window.RivaCartReady;
  const cartRoot = document.querySelector('[data-cart-root]');

  if (cartRoot) {
    const cartCountEls = document.querySelectorAll('[data-cart-count]');
    const emptyState = cartRoot.querySelector('[data-cart-empty]');
    const grid = cartRoot.querySelector('[data-cart-grid]');
    const itemsWrap = cartRoot.querySelector('[data-cart-items]');
    const noteTextarea = cartRoot.querySelector('[data-cart-note]');
    const noteStatus = cartRoot.querySelector('[data-note-status]');
    const giftToggle = cartRoot.querySelector('[data-gift-toggle]');
    const giftBody = cartRoot.querySelector('[data-gift-body]');
    const subtotalEl = cartRoot.querySelector('[data-cart-subtotal]');
    const totalEl = cartRoot.querySelector('[data-cart-total]');
    const checkoutTotalEl = cartRoot.querySelector('[data-checkout-total]');
    const discountRow = cartRoot.querySelector('[data-discount-row]');
    const discountEl = cartRoot.querySelector('[data-cart-discount]');
    const shippingEl = cartRoot.querySelector('[data-cart-shipping]');
    const taxEl = cartRoot.querySelector('[data-cart-tax]');
    const freeShippingRow = cartRoot.querySelector('[data-free-shipping-row]');
    const freeShippingMessage = cartRoot.querySelector('[data-free-shipping-message]');
    const checkoutLink = cartRoot.querySelector('[data-checkout-link]');
    const promoInput = cartRoot.querySelector('[data-promo-input]');
    const promoApply = cartRoot.querySelector('[data-promo-apply]');
    const promoMessage = cartRoot.querySelector('[data-promo-message]');
    const upsellWrap = cartRoot.querySelector('[data-upsell-wrap]');
    const upsellItems = cartRoot.querySelector('[data-upsell-items]');

    let cartState = null;
    let currentDiscountCode = '';
    let noteTimer = null;
    let defaultAddressPromise = null;

    const formatMoney = (amount, currency = 'INR') => new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency,
      maximumFractionDigits: 2,
    }).format(Number(amount) || 0);

    const getCartLines = (cart) => cart?.lines?.edges?.map((edge) => edge.node) || [];
    const getDeliveryGroups = (cart) => cart?.deliveryGroups?.edges?.map((edge) => edge.node) || [];
    const CURRENCY_COUNTRY_MAP = {
      INR: 'IN',
      USD: 'US',
      EUR: 'ES',
      GBP: 'GB',
      AED: 'AE',
    };

    const getDetectedCountryCode = (cart) => {
      const currencyCountryCode = CURRENCY_COUNTRY_MAP[cart?.cost?.totalAmount?.currencyCode || ''];
      if (currencyCountryCode) return currencyCountryCode;

      const locales = [
        ...(Array.isArray(navigator.languages) ? navigator.languages : []),
        navigator.language,
      ].filter(Boolean);

      for (const locale of locales) {
        try {
          const region = new Intl.Locale(locale).region;
          if (region && region.length === 2) return region.toUpperCase();
        } catch {
        }

        const match = String(locale).match(/[-_]([A-Za-z]{2})\b/);
        if (match?.[1]) return match[1].toUpperCase();
      }

      return null;
    };

    const getSignedInDefaultAddress = async () => {
      if (defaultAddressPromise !== null) return defaultAddressPromise;

      defaultAddressPromise = (async () => {
        try {
          const customerApi = window.RivaCustomer || await window.RivaCustomerReady;
          if (typeof customerApi?.getDefaultAddress !== 'function') return null;
          return await customerApi.getDefaultAddress();
        } catch {
          return null;
        }
      })();

      return defaultAddressPromise;
    };

    const getPricingAddressPreference = async (cart) => {
      const defaultAddress = await getSignedInDefaultAddress();
      const detectedCountryCode = getDetectedCountryCode(cart);
      const countryCode = String(defaultAddress?.countryCode || detectedCountryCode || '').trim().toUpperCase();
      if (!countryCode) return null;

      const deliveryAddress = { countryCode };
      const hasDetailedAddress = Boolean(
        defaultAddress?.address1 ||
        defaultAddress?.city ||
        defaultAddress?.zip ||
        defaultAddress?.provinceCode
      );

      if (defaultAddress?.firstName) deliveryAddress.firstName = defaultAddress.firstName;
      if (defaultAddress?.lastName) deliveryAddress.lastName = defaultAddress.lastName;
      if (defaultAddress?.address1) deliveryAddress.address1 = defaultAddress.address1;
      if (defaultAddress?.city) deliveryAddress.city = defaultAddress.city;
      if (defaultAddress?.provinceCode) deliveryAddress.provinceCode = defaultAddress.provinceCode;
      if (defaultAddress?.zip) deliveryAddress.zip = defaultAddress.zip;

      return {
        countryCode,
        deliveryAddressPreferences: [
          {
            deliveryAddress,
            deliveryAddressValidationStrategy: hasDetailedAddress ? 'STRICT' : 'COUNTRY_CODE_ONLY',
            oneTimeUse: true,
          },
        ],
      };
    };

    const ensureCartPricing = async (cart) => {
      let nextCart = cart;
      if (!nextCart) return nextCart;

      const pricingAddressPreference = await getPricingAddressPreference(nextCart);
      const preferredCountryCode = pricingAddressPreference?.countryCode || null;
      const buyerCountryCode = nextCart.buyerIdentity?.countryCode || null;
      const deliveryGroups = getDeliveryGroups(nextCart);
      const hasAnyDeliveryOptions = deliveryGroups.some((group) => group.deliveryOptions?.length > 0);
      const hasSelectedDeliveryOption = deliveryGroups.some((group) => group.selectedDeliveryOption);
      const pricingLooksUnresolved =
        Number(nextCart.cost.totalAmount.amount || 0) <= Number(nextCart.cost.subtotalAmount.amount || 0) &&
        Math.max(Number(nextCart.cost.totalTaxAmount?.amount || 0), 0) === 0 &&
        !hasSelectedDeliveryOption;
      const shouldRefreshBuyerIdentity =
        pricingAddressPreference &&
        (
          !buyerCountryCode ||
          buyerCountryCode !== preferredCountryCode ||
          !hasAnyDeliveryOptions ||
          pricingLooksUnresolved
        );

      if (shouldRefreshBuyerIdentity && typeof cartApi.updateCartBuyerIdentity === 'function') {
        try {
          nextCart = await cartApi.updateCartBuyerIdentity(pricingAddressPreference);
        } catch {
        }
      }

      const selectedDeliveryOptions = getDeliveryGroups(nextCart)
        .filter((group) => !group.selectedDeliveryOption && group.deliveryOptions?.length)
        .map((group) => ({
          deliveryGroupId: group.id,
          deliveryOptionHandle: group.deliveryOptions[0].handle,
        }));

      if (selectedDeliveryOptions.length && typeof cartApi.updateCartSelectedDeliveryOptions === 'function') {
        try {
          nextCart = await cartApi.updateCartSelectedDeliveryOptions(selectedDeliveryOptions);
        } catch {
        }
      }

      return nextCart;
    };

    const getCartDiscount = (cart) => getCartLines(cart).reduce((total, line) => {
      const compareAt = Number(line.cost.compareAtAmountPerQuantity?.amount || 0);
      const price = Number(line.cost.amountPerQuantity.amount || 0);
      if (compareAt <= price) return total;
      return total + (compareAt - price) * line.quantity;
    }, 0);

    const setNavCartCount = (count) => {
      const cartLink = document.querySelector('.rv-nav-right a[aria-label="Cart"]');
      if (!cartLink) return;
      let badge = cartLink.querySelector('.rv-cart-nav-badge');
      if (count > 0) {
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'rv-cart-nav-badge';
          cartLink.appendChild(badge);
        }
        badge.textContent = String(count);
      } else if (badge) {
        badge.remove();
      }
    };

    const escapeHtml = (value) => String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

    const getItemImage = (item) => {
      if (item.featured_image?.url) return item.featured_image.url;
      if (typeof item.image === 'string') return item.image;
      return '';
    };

    const getItemBadge = (item) => {
      const matchedProduct = suggestionData.find((product) => product.handle === item.merchandise.product.handle);
      const merged = (matchedProduct?.tags || []).map((tag) => String(tag).toLowerCase());
      if (merged.includes('new') || merged.includes('new-in')) return { text: 'New In', cls: 'new' };
      if (merged.includes('bestseller')) return { text: 'Best Seller', cls: '' };
      return null;
    };

    const getVariantProps = (item) => {
      return (item.merchandise.selectedOptions || [])
        .filter((option) => option.value && option.value !== 'Default Title')
        .map((option) => `${escapeHtml(option.name)}: ${escapeHtml(option.value)}`);
    };

    const renderItems = (cart) => {
      const currency = cart.cost.totalAmount.currencyCode || 'INR';
      const lines = getCartLines(cart);
      if (!itemsWrap) return;

      if (!lines.length) {
        itemsWrap.innerHTML = '';
        return;
      }

      itemsWrap.innerHTML = lines.map((item) => {
        const imageUrl = item.merchandise.image?.url || item.merchandise.product.featuredImage?.url || '';
        const props = getVariantProps(item);
        const badge = getItemBadge(item);
        const compareAt = Number(item.cost.compareAtAmountPerQuantity?.amount || 0);
        const price = Number(item.cost.amountPerQuantity.amount || 0);
        const savings = compareAt > price ? (compareAt - price) * item.quantity : 0;
        const originalLineAmount = compareAt > price ? compareAt * item.quantity : 0;
        return `
          <div class="rv-cart-item" data-cart-item data-line-id="${escapeHtml(item.id)}">
            <a href="/products/${escapeHtml(item.merchandise.product.handle)}" class="rv-cart-item-img-wrap">
              ${imageUrl ? `<img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(item.merchandise.product.title)}" loading="lazy">` : `<div style="width:100%;aspect-ratio:3/4;background:#edebe6;"></div>`}
              ${badge ? `<span class="rv-cart-item-img-badge ${badge.cls}">${badge.text}</span>` : ''}
            </a>
            <div class="rv-cart-item-body">
              <div class="rv-cart-item-top">
                <span class="rv-cart-item-vendor">${escapeHtml(item.merchandise.product.productType || item.merchandise.product.vendor || 'Leather Goods')}</span>
                <a href="/products/${escapeHtml(item.merchandise.product.handle)}" class="rv-cart-item-name">${escapeHtml(item.merchandise.product.title)}</a>
                ${props.length ? `<div class="rv-cart-item-variant">
                  ${props.map((prop) => `<span class="rv-cart-item-prop">${prop}</span>`).join('')}
                </div>` : ''}
              </div>
              <div class="rv-cart-item-bottom">
                <div class="rv-cart-item-price-wrap">
                  <span class="rv-cart-item-price">${formatMoney(item.cost.totalAmount.amount, currency)}</span>
                  ${originalLineAmount > Number(item.cost.totalAmount.amount) ? `<span class="rv-cart-item-price-old">${formatMoney(originalLineAmount, currency)}</span>` : ''}
                  ${savings > 0 ? `<span class="rv-cart-item-price-save">Save ${formatMoney(savings, currency)}</span>` : ''}
                </div>
                <div class="rv-cart-item-actions">
                  <div class="rv-qty">
                    <button type="button" class="rv-qty-btn" data-qty-change="-1" data-line-id="${escapeHtml(item.id)}" aria-label="Decrease quantity">−</button>
                    <input class="rv-qty-val" type="number" min="0" max="20" value="${item.quantity}" data-qty-input data-line-id="${escapeHtml(item.id)}" aria-label="Quantity">
                    <button type="button" class="rv-qty-btn" data-qty-change="1" data-line-id="${escapeHtml(item.id)}" aria-label="Increase quantity">+</button>
                  </div>
                  <button type="button" class="rv-cart-remove" data-remove-item data-line-id="${escapeHtml(item.id)}" aria-label="Remove ${escapeHtml(item.merchandise.product.title)}">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    Remove
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');

      Array.from(itemsWrap.querySelectorAll('[data-cart-item]')).forEach((item, index) => {
        window.setTimeout(() => item.classList.add('in'), 100 + index * 80);
      });
    };

    const renderSuggestions = (cart) => {
      if (!cart.totalQuantity) {
        if (upsellWrap) upsellWrap.hidden = true;
        if (upsellItems) upsellItems.innerHTML = '';
        return;
      }

      const cartHandles = new Set(getCartLines(cart).map((item) => item.merchandise.product.handle));
      const filtered = suggestionData.filter((product) => !cartHandles.has(product.handle));
      const upsells = filtered.slice(0, 2);

      if (upsellWrap && upsellItems) {
        if (upsells.length) {
          upsellWrap.hidden = false;
          upsellItems.innerHTML = upsells.map((product) => `
            <div class="rv-cart-upsell-item" data-upsell-card data-handle="${escapeHtml(product.handle)}">
              ${product.imageUrl ? `<img class="rv-cart-upsell-img" src="${escapeHtml(product.imageUrl)}" alt="${escapeHtml(product.imageAlt)}">` : `<div class="rv-cart-upsell-img"></div>`}
              <div class="rv-cart-upsell-info">
                <a href="/products/${escapeHtml(product.handle)}" class="rv-cart-upsell-name">${escapeHtml(product.title)}</a>
                <span class="rv-cart-upsell-price">${escapeHtml(product.priceLabel)}</span>
              </div>
              <button type="button" class="rv-cart-upsell-add" data-upsell-add data-handle="${escapeHtml(product.handle)}">+ Add</button>
            </div>
          `).join('');
        } else {
          upsellWrap.hidden = true;
          upsellItems.innerHTML = '';
        }
      }
    };

    const updateSummary = (cart) => {
      const currency = cart.cost.totalAmount.currencyCode || 'INR';
      const discountAmount = getCartDiscount(cart);
      const subtotalAmount = Number(cart.cost.subtotalAmount.amount || 0);
      const totalAmount = Number(cart.cost.totalAmount.amount || 0);
      const taxAmount = Math.max(Number(cart.cost.totalTaxAmount?.amount || 0), 0);
      const deliveryGroups = getDeliveryGroups(cart);
      const selectedShippingAmount = deliveryGroups.reduce((sum, group) => {
        return sum + Number(group.selectedDeliveryOption?.estimatedCost.amount || 0);
      }, 0);
      const shippingAmount = selectedShippingAmount > 0
        ? selectedShippingAmount
        : Math.max(totalAmount - subtotalAmount - taxAmount, 0);
      const resolvedTotalAmount = Math.max(totalAmount, subtotalAmount + shippingAmount + taxAmount);
      cartCountEls.forEach((el) => {
        el.textContent = `${cart.totalQuantity} ${cart.totalQuantity === 1 ? 'piece' : 'pieces'} selected`;
      });
      if (subtotalEl) subtotalEl.textContent = formatMoney(cart.cost.subtotalAmount.amount, currency);
      if (totalEl) totalEl.textContent = formatMoney(resolvedTotalAmount, currency);
      if (checkoutTotalEl) checkoutTotalEl.textContent = formatMoney(resolvedTotalAmount, currency);
      if (discountRow && discountEl) {
        const hasDiscount = discountAmount > 0;
        discountRow.hidden = !hasDiscount;
        discountEl.textContent = hasDiscount ? `− ${formatMoney(discountAmount, currency)}` : '';
      }
      if (shippingEl) {
        shippingEl.textContent = formatMoney(shippingAmount, currency);
        shippingEl.classList.toggle('green', shippingAmount === 0);
      }
      if (taxEl) {
        taxEl.textContent = formatMoney(taxAmount, currency);
      }
      if (freeShippingRow && freeShippingMessage) {
        freeShippingRow.hidden = true;
        freeShippingMessage.textContent = '';
      }
      if (noteTextarea && document.activeElement !== noteTextarea) {
        noteTextarea.value = cart.note || '';
      }
      if (checkoutLink) {
        const checkoutUrl = new URL(cart.checkoutUrl);
        if (currentDiscountCode) checkoutUrl.searchParams.set('discount', currentDiscountCode);
        checkoutLink.href = checkoutUrl.toString();
      }
      setNavCartCount(cart.totalQuantity);
    };

    const applyCartVisibility = (cart) => {
      const isEmpty = cart.totalQuantity === 0;
      if (emptyState) emptyState.hidden = !isEmpty;
      if (grid) grid.hidden = isEmpty;
    };

    const renderCart = (cart) => {
      cartState = cart;
      updateSummary(cart);
      applyCartVisibility(cart);
      renderItems(cart);
      renderSuggestions(cart);
      observeReveals(cartRoot.querySelectorAll('.rv-reveal'));
    };

    const loadCart = async () => {
      try {
        const cart = await cartApi.getCart();
        if (!cart) throw new Error('Cart request failed');
        const pricedCart = await ensureCartPricing(cart);
        renderCart(pricedCart);
      } catch {
        if (itemsWrap) itemsWrap.innerHTML = '<div class="rv-cart-loading">We could not load your bag right now.</div>';
        cartCountEls.forEach((el) => { el.textContent = 'Bag unavailable'; });
      }
    };

    const updateLineItem = async (lineId, quantity) => {
      if (!cartState) return;
      const itemEl = itemsWrap?.querySelector(`[data-line-id="${CSS.escape(lineId)}"]`);
      if (quantity === 0 && itemEl) itemEl.classList.add('removing');
      const cart = quantity === 0
        ? await cartApi.removeCartLine(lineId)
        : await cartApi.updateCartLine(lineId, quantity);
      const pricedCart = await ensureCartPricing(cart);
      renderCart(pricedCart);
    };

    const addUpsell = async (handle, button) => {
      const product = suggestionData.find((item) => item.handle === handle);
      if (!product?.firstVariantId) return;

      await cartApi.addToCart(product.firstVariantId, 1);

      button.textContent = 'Added ✓';
      button.disabled = true;
      const cart = await cartApi.getCart();
      if (!cart) return;
      const pricedCart = await ensureCartPricing(cart);
      renderCart(pricedCart);
    };

    const applyPromo = () => {
      const code = String(promoInput?.value || '').trim().toUpperCase();
      if (!promoMessage || !checkoutLink) return;
      if (!code) {
        promoMessage.textContent = 'Please enter a promo code.';
        promoMessage.style.color = '#b8b0a6';
        return;
      }
      currentDiscountCode = code;
      promoMessage.textContent = `Code "${code}" will be applied at checkout.`;
      promoMessage.style.color = '#3d5c35';
      const url = new URL(checkoutLink.href, window.location.origin);
      url.searchParams.set('discount', code);
      checkoutLink.href = url.pathname + url.search;
    };

    const observeReveals = (elements) => {
      if (!('IntersectionObserver' in window)) {
        Array.from(elements).forEach((el) => el.classList.add('in'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.06 });
      Array.from(elements).forEach((el) => {
        if (!el.classList.contains('in')) observer.observe(el);
      });
    };

    cartRoot.addEventListener('click', async (event) => {
      const qtyButton = event.target.closest('[data-qty-change]');
      if (qtyButton) {
        const lineId = qtyButton.getAttribute('data-line-id');
        const delta = Number(qtyButton.getAttribute('data-qty-change'));
        const item = getCartLines(cartState).find((entry) => entry.id === lineId);
        if (!item) return;
        const nextQty = Math.max(item.quantity + delta, 0);
        try {
          await updateLineItem(lineId, nextQty);
        } catch {}
        return;
      }

      const removeButton = event.target.closest('[data-remove-item]');
      if (removeButton) {
        const lineId = removeButton.getAttribute('data-line-id');
        if (!lineId) return;
        try {
          await updateLineItem(lineId, 0);
        } catch {}
        return;
      }

      const upsellButton = event.target.closest('[data-upsell-add]');
      if (upsellButton) {
        const handle = upsellButton.getAttribute('data-handle');
        if (!handle) return;
        try {
          await addUpsell(handle, upsellButton);
        } catch {}
        return;
      }
    });

    cartRoot.addEventListener('change', async (event) => {
      const qtyInput = event.target.closest('[data-qty-input]');
      if (qtyInput) {
        const lineId = qtyInput.getAttribute('data-line-id');
        const nextQty = Math.max(Number(qtyInput.value) || 0, 0);
        if (!lineId) return;
        try {
          await updateLineItem(lineId, nextQty);
        } catch {}
      }
    });

    giftToggle?.addEventListener('click', () => {
      giftToggle.classList.toggle('open');
      giftBody?.classList.toggle('open');
    });

    noteTextarea?.addEventListener('input', () => {
      if (noteStatus) {
        noteStatus.textContent = 'Saving message…';
        noteStatus.style.color = '#8a7660';
      }
      window.clearTimeout(noteTimer);
      noteTimer = window.setTimeout(async () => {
        try {
          const cart = await cartApi.updateCartNote(noteTextarea.value);
          renderCart(cart);
          if (noteStatus) {
            noteStatus.textContent = 'Gift message saved';
            noteStatus.style.color = '#3d5c35';
          }
        } catch {
          if (noteStatus) {
            noteStatus.textContent = 'Could not save message';
            noteStatus.style.color = '#8b3a2a';
          }
        }
      }, 500);
    });

    promoApply?.addEventListener('click', applyPromo);
    promoInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        applyPromo();
      }
    });

    loadCart();
  }
  })();
</script>
