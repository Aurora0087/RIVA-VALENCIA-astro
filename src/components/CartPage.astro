---
import { formatPrice, type ShopifyProduct } from '@/lib/shopify';
import { CartRelatedProducts } from '@/components/CartRelatedProducts';

interface Props {
  suggestions: ShopifyProduct[];
}

const { suggestions } = Astro.props;

const suggestionPayload = suggestions.map((product) => {
  const image = product.images.edges[0]?.node;
  const price = product.priceRange.minVariantPrice;
  const firstVariant = product.variants.edges.find(({ node }) => node.availableForSale)?.node ?? product.variants.edges[0]?.node;
  return {
    id: product.id,
    handle: product.handle,
    title: product.title,
    vendor: product.vendor,
    productType: product.productType,
    imageUrl: image?.url ?? '',
    imageAlt: image?.altText ?? product.title,
    priceLabel: formatPrice(price.amount, price.currencyCode),
    firstVariantId: firstVariant?.id ?? '',
    tags: product.tags,
  };
});
---

<div class="rv-cart-page" data-cart-root>
  <div class="rv-cart-header rv-reveal">
    <div>
      <span class="rv-cart-eyebrow">Your Selection</span>
      <span class="rv-cart-title">Your Bag</span>
    </div>
    <div class="rv-cart-header-right">
      <span class="rv-cart-count" data-cart-count>Loading your selection</span>
      <a href="/collections/all" class="rv-cart-continue">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Continue Shopping
      </a>
    </div>
  </div>

  <div class="rv-cart-empty" data-cart-empty hidden>
    <div class="rv-cart-empty-ornament"><span>✦</span></div>
    <span class="rv-cart-empty-title">Your Bag is Empty</span>
    <span class="rv-cart-empty-sub">Discover our handcrafted Spanish leather collections</span>
    <a href="/collections/all" class="rv-cart-empty-btn">Explore the Collections →</a>
  </div>

  <div class="rv-cart-grid" data-cart-grid hidden>
    <div>
      <div class="rv-cart-items" data-cart-items>
        <div class="rv-cart-loading">Loading your bag…</div>
      </div>

      <div class="rv-cart-gift">
        <button type="button" class="rv-cart-gift-toggle" data-gift-toggle>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add a Gift Message
        </button>
        <div class="rv-cart-gift-body" data-gift-body>
          <textarea class="rv-cart-gift-textarea" data-cart-note rows="3" placeholder="Write your personal message here…"></textarea>
          <span class="rv-cart-gift-note">Your message will be printed on a luxury Riva Valencia card included with your order.</span>
          <span class="rv-cart-note-status" data-note-status></span>
        </div>
      </div>
    </div>

    <div class="rv-cart-summary rv-reveal">
      <span class="rv-cart-summary-title">Order Summary</span>

      <div class="rv-cart-summary-rows">
        <div class="rv-cart-summary-row">
          <span class="rv-cart-summary-label">Subtotal</span>
          <span class="rv-cart-summary-val" data-cart-subtotal>₹0</span>
        </div>
        <div class="rv-cart-summary-row" data-discount-row hidden>
          <span class="rv-cart-summary-label">Discount</span>
          <span class="rv-cart-summary-val green" data-cart-discount>₹0</span>
        </div>
        <div class="rv-cart-summary-row">
          <span class="rv-cart-summary-label">Shipping</span>
          <span class="rv-cart-summary-val" data-cart-shipping>₹0</span>
        </div>
        <div class="rv-cart-summary-row">
          <span class="rv-cart-summary-label">Estimated taxes</span>
          <span class="rv-cart-summary-val" data-cart-tax>₹0</span>
        </div>
        <div class="rv-cart-summary-row rv-cart-summary-row-note" data-free-shipping-row hidden>
          <span data-free-shipping-message></span>
        </div>
      </div>

      <div class="rv-cart-total-row">
        <span class="rv-cart-total-label">Total</span>
        <span class="rv-cart-total-price" data-cart-total>₹0</span>
      </div>
      <span class="rv-cart-total-tax">Shipping and estimated taxes are based on your current cart and may change after you choose your delivery address at checkout.</span>

      <div class="rv-cart-promo">
        <span class="rv-cart-promo-label">Promo Code</span>
        <div class="rv-cart-promo-row">
          <input type="text" class="rv-cart-promo-input" placeholder="Enter code" data-promo-input>
          <button type="button" class="rv-cart-promo-btn" data-promo-apply>Apply</button>
        </div>
        <span class="rv-cart-promo-msg" data-promo-message></span>
      </div>

      <a href="/checkout" class="rv-cart-checkout" data-checkout-link>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 01-8 0"></path>
        </svg>
        Proceed to Checkout — <span data-checkout-total>₹0</span>
      </a>

      <div class="rv-cart-pay-logos">
        <span class="rv-cart-pay-logo">UPI</span>
        <span class="rv-cart-pay-sep"></span>
        <span class="rv-cart-pay-logo">Visa</span>
        <span class="rv-cart-pay-logo">Mastercard</span>
        <span class="rv-cart-pay-sep"></span>
        <span class="rv-cart-pay-logo">Razorpay</span>
        <span class="rv-cart-pay-sep"></span>
        <span class="rv-cart-pay-logo">Klarna</span>
      </div>

      <div class="rv-cart-secure">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="11" width="18" height="11" rx="2"></rect>
          <path d="M7 11V7a5 5 0 0110 0v4"></path>
        </svg>
        256-bit SSL · Secure Checkout
      </div>

      <div class="rv-cart-upsell" data-upsell-wrap hidden>
        <span class="rv-cart-upsell-label">You May Also Love</span>
        <div data-upsell-items></div>
      </div>
    </div>
  </div>
</div>

<CartRelatedProducts products={suggestions} client:load />

<div class="rv-payment rv-reveal">
  <span class="rv-payment-logo">VISA</span>
  <span class="rv-payment-logo">MASTERCARD</span>
  <span class="rv-payment-sep"></span>
  <span class="rv-payment-logo">AMEX</span>
  <span class="rv-payment-sep"></span>
  <span class="rv-payment-logo">RAZORPAY</span>
</div>

<style is:global>
