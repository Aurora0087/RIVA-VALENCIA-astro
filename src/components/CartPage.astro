  .rv-payment{background:#f2eee8;border-top:1px solid #e8e4de;border-bottom:1px solid #e8e4de;padding:20px 48px;display:flex;align-items:center;justify-content:center;gap:32px;flex-wrap:wrap}
  .rv-payment-logo{font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:#8a7660;font-weight:500;opacity:0.7;transition:opacity 0.2s}
