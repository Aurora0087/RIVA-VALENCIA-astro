  @media(max-width:960px){
    .rv-cart-page{padding:40px 20px 80px}
    .rv-cart-grid{grid-template-columns:1fr;gap:40px}
    .rv-cart-summary{position:relative;top:0;padding:28px 24px}
    .rv-cart-header{flex-direction:column;align-items:flex-start;gap:12px}
