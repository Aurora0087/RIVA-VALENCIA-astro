    .pd-rev-grid,.pd-rev-grid.is-single{grid-template-columns:1fr;gap:12px}
    .pd-rev-card{padding:24px 22px 22px;min-height:auto}
    .pd-rev-card-title{font-size:22px}
    .pd-rev-card-text{font-size:14px}
    .rv-trust{grid-template-columns:1fr 1fr}
    .rv-ti{border-right:none;border-bottom:1px solid #e8e4de}
