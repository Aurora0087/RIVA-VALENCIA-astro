  .pd-rev-more{text-align:center;padding-top:2px}
  .pd-rev-more-btn{display:inline-flex;align-items:center;gap:8px;border:1px solid #2f2418;color:#2f2418;font-size:9px;letter-spacing:0.28em;text-transform:uppercase;padding:14px 32px;font-family:'Jost',sans-serif;cursor:pointer;background:rgba(255,255,255,0.64);transition:all 0.35s}
