---
import { formatPrice, type ShopifyConnectionStatus, type ShopifyProduct, type ShopifyVariant } from '@/lib/shopify';

interface Props {
  product: ShopifyProduct | null;
  recommendedProducts: ShopifyProduct[];
  status: ShopifyConnectionStatus;
}

const { product, recommendedProducts, status } = Astro.props;

const reviewEntries = [
  {
    title: 'A lifelong investment',
    text: 'The leather is so supple and rich. It gets more beautiful with every use and still feels immaculate after months of wear.',
    author: 'Priya S., Mumbai',
    date: 'March 2026',
  },
  {
    title: 'Beyond expectations',
    text: 'The craftsmanship is extraordinary and the packaging felt as refined as the bag itself. It arrived ready to gift.',
    author: 'Ananya R., Delhi',
    date: 'February 2026',
  },
  {
    title: 'Still perfect after 2 years',
    text: 'No loud branding, just beautiful leather and clean construction. It looks even better now than the day I bought it.',
    author: 'Meera K., Bangalore',
    date: 'January 2026',
  },
  {
    title: 'Elegant and practical',
    text: 'I can carry my laptop, daily essentials and still keep the silhouette sleek. It feels thoughtful rather than oversized.',
    author: 'Sara D., Pune',
    date: 'December 2025',
  },
  {
    title: 'The stitching is flawless',
    text: 'Every seam, edge and hardware detail feels considered. It has the kind of finish you usually only find at much higher prices.',
    author: 'Nikita T., Hyderabad',
    date: 'November 2025',
  },
  {
    title: 'My new daily companion',
    text: 'I bought it for work and ended up using it every weekend too. It works with everything and the leather smells incredible.',
    author: 'Rhea B., Chennai',
    date: 'October 2025',
  },
];

function getProductBadge(currentProduct: ShopifyProduct) {
  const tags = currentProduct.tags.map((tag) => tag.toLowerCase());
  const price = parseFloat(currentProduct.priceRange.minVariantPrice.amount);
  const compareAt = parseFloat(currentProduct.compareAtPriceRange.minVariantPrice.amount);

  if (tags.includes('new') || tags.includes('new-in')) return { label: 'New In', sale: false };
  if (compareAt > price) return { label: 'Sale', sale: true };
  if (tags.includes('bestseller')) return { label: 'Best Seller', sale: false };
  return { label: 'Spring 2026', sale: false };
}

function getSwatchColor(value: string) {
  const normalized = value.toLowerCase().replace(/\s+/g, '');
  const swatches: Record<string, string> = {
    black: '#1a1008',
    tan: '#c9b99a',
    camel: '#c9a96e',
    cognac: '#b7793f',
    cognactan: '#c9b99a',
    burgundy: '#8b3a2a',
    bordeaux: '#8b3a2a',
    forest: '#2c4a3e',
    olive: '#556b2f',
    ivory: '#e8e4de',
    tobacco: '#5a4a3a',
    sand: '#d4c9b8',
    navy: '#1e2d4a',
    brown: '#5c3d1e',
    beige: '#e0d4bc',
    cream: '#f5f0e6',
    grey: '#9a9a9a',
    gray: '#9a9a9a',
    white: '#f0efed',
    red: '#9b2335',
    green: '#476b57',
    blue: '#365c8d',
  };

  return swatches[normalized] ?? 'linear-gradient(135deg, #f0efed 0%, #d8d2c9 100%)';
}

function getVariantOptionValue(variant: ShopifyVariant | null, optionName: string) {
  return variant?.selectedOptions?.find((option) => option.name === optionName)?.value ?? '';
}

const imageNodes = product?.images.edges.map(({ node }) => node) ?? [];
const productVariants = product?.variants.edges.map(({ node }) => node) ?? [];
const primaryVariant = productVariants.find((variant) => variant.availableForSale) ?? productVariants[0] ?? null;
const primaryCollection = product?.collections?.edges[0]?.node ?? null;
const productBadge = product ? getProductBadge(product) : { label: '', sale: false };
const configurableOption = product?.options?.find((option) => option.values.length > 1) ?? null;
const colorOptionNames = new Set(['color', 'colour']);
const optionIsColor = configurableOption ? colorOptionNames.has(configurableOption.name.toLowerCase()) : false;
const selectedOptionValue = configurableOption ? getVariantOptionValue(primaryVariant, configurableOption.name) || configurableOption.values[0] : '';
const mainImages = imageNodes.filter((_, index) => index % 2 === 0);
const sideImages = imageNodes.filter((_, index) => index % 2 === 1);
const detailImages = sideImages.length > 0 ? sideImages : imageNodes.slice(1);
const galleryImages = imageNodes.length > 0 ? imageNodes : [{ url: '', altText: '', width: 0, height: 0 }];
const fallbackRecommendations = recommendedProducts.filter((item) => item.handle !== product?.handle).slice(0, 6);
const relatedProducts = fallbackRecommendations;
const variantPayload = productVariants.map((variant) => ({
  id: variant.id,
  title: variant.title,
  sku: variant.sku ?? '',
  availableForSale: variant.availableForSale,
  price: variant.price,
  compareAtPrice: variant.compareAtPrice ?? null,
  selectedOptions: variant.selectedOptions ?? [],
  imageUrl: variant.image?.url ?? '',
}));
const imagePayload = galleryImages.map((image) => image.url).filter(Boolean);
const wishlistBasePayload = product ? {
  id: product.id,
  productId: product.id,
  handle: product.handle,
  title: product.title,
  type: product.productType || 'Leather Goods',
  vendor: product.vendor || '',
  url: `/products/${product.handle}`,
  image: imageNodes[0]?.url ?? '',
  imageAlt: imageNodes[0]?.altText ?? product.title,
  availableForSale: product.availableForSale,
  currencyCode: product.priceRange.minVariantPrice.currencyCode,
  tags: product.tags,
} : null;
---

{!product ? (
  <section class="pd-missing">
    <h1>Product unavailable</h1>
    <p>{status.ok ? 'This product could not be found.' : status.message}</p>
    <a href="/collections/all" class="pd-missing-link">Back to all products</a>
  </section>
) : (
  <div class="pd-page" data-pd-root>
    <div class="rv-ann">
      <div class="rv-ann-track">
        <span>
          Free delivery on orders above ₹5,000 &nbsp;·&nbsp; Handcrafted in Spain &nbsp;·&nbsp;
          Easy 30-day returns &nbsp;·&nbsp; Secure payment &nbsp;·&nbsp; New arrivals Spring 2026 &nbsp;·&nbsp;
          Free delivery on orders above ₹5,000 &nbsp;·&nbsp; Handcrafted in Spain &nbsp;·&nbsp;
          Easy 30-day returns &nbsp;·&nbsp; Secure payment &nbsp;·&nbsp; New arrivals Spring 2026
        </span>
      </div>
    </div>

    <div class="pd-crumb">
      <a href="/">Home</a>
      <span class="pd-crumb-sep">›</span>
      {primaryCollection ? (
        <>
          <a href={`/collections/${primaryCollection.handle}`}>{primaryCollection.title}</a>
          <span class="pd-crumb-sep">›</span>
        </>
      ) : (
        <>
          <a href="/collections/all">All Products</a>
          <span class="pd-crumb-sep">›</span>
        </>
      )}
      <span class="pd-current-crumb">{product.title}</span>
    </div>

    <div class="pd-layout">
      <div class="pd-gallery">
        <div class="pd-img-grid">
          <div class="pd-img-main">
            {(mainImages.length > 0 ? mainImages : galleryImages).map((image, index) => {
              const sourceIndex = imageNodes.findIndex((node) => node.url === image.url);
              const galleryIndex = sourceIndex >= 0 ? sourceIndex : index;
              return (
                <div
                  class="pd-img-main-item"
                  data-open-lightbox={galleryIndex}
                  role="button"
                  tabindex={0}
                >
                  {image.url ? (
                    <img
                      src={image.url}
                      alt={image.altText ?? product.title}
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  ) : (
                    <div class="pd-img-ph">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <polyline points="21 15 16 10 5 21" />
                      </svg>
                    </div>
                  )}
                  {index === 0 && (
                    <>
                      <span class:list={['pd-img-badge', productBadge.sale && 'sale-b']}>{productBadge.label}</span>
                      <button type="button" class="pd-view-look" data-scroll-to-recommended>View Look</button>
                      <button type="button" class="pd-img-wish" data-wishlist-toggle aria-label="Save product" aria-pressed="false">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                          <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                        </svg>
                      </button>
                    </>
                  )}
                  <span class="pd-img-num">{galleryIndex + 1} / {galleryImages.length}</span>
                </div>
              );
            })}
          </div>

          <div class="pd-img-side">
            {(detailImages.length > 0 ? detailImages : galleryImages.slice(0, 2)).map((image, index) => {
              const sourceIndex = imageNodes.findIndex((node) => node.url === image.url);
              const galleryIndex = sourceIndex >= 0 ? sourceIndex : index;
              return (
                <div
                  class="pd-img-side-item"
                  data-open-lightbox={galleryIndex}
                  role="button"
                  tabindex={0}
                >
                  {image.url ? (
                    <img src={image.url} alt={(image.altText ?? product.title) + ' detail'} loading="lazy" />
                  ) : (
                    <div class="pd-img-ph pd-img-ph-side"></div>
                  )}
                  <span class="pd-img-num">{galleryIndex + 1} / {galleryImages.length}</span>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <div class="pd-info">
        <div class="pd-info-toprow">
          <span class="pd-info-new-tag">{productBadge.label}</span>
          <button type="button" class="pd-info-viewlook" data-scroll-to-recommended>View Look</button>
        </div>

        <span class="pd-info-title">{product.title}</span>

        <div class="pd-price-row">
          <span class="pd-price" data-pd-price>{formatPrice(primaryVariant?.price.amount ?? product.priceRange.minVariantPrice.amount, primaryVariant?.price.currencyCode ?? product.priceRange.minVariantPrice.currencyCode)}</span>
          <span class="pd-price-old" data-pd-compare hidden>
            {primaryVariant?.compareAtPrice ? formatPrice(primaryVariant.compareAtPrice.amount, primaryVariant.compareAtPrice.currencyCode) : ''}
          </span>
          <button type="button" class="pd-wish-link" data-wishlist-toggle aria-label="Bookmark product" aria-pressed="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" />
            </svg>
          </button>
        </div>
        <span class="pd-tax">MRP incl. of all taxes</span>
        <span class="pd-ref" data-pd-ref>Ref. {primaryVariant?.sku || product.id.split('/').pop()}</span>

        <div class="pd-divider"></div>

        {configurableOption && (
          <>
            <div class="pd-opt-label">
              {optionIsColor ? 'Colour' : configurableOption.name}:
              <span class="pd-opt-label-val" data-option-label-value>{selectedOptionValue}</span>
            </div>

            {optionIsColor ? (
              <div class="pd-swatches">
                {configurableOption.values.map((value) => (
                  <button
                    type="button"
                    class:list={['pd-swatch', selectedOptionValue === value && 'active']}
                    data-option-value={value}
                    data-option-name={configurableOption.name}
                    title={value}
                    style={`background:${getSwatchColor(value)};`}
                  />
                ))}
              </div>
            ) : (
              <div class="pd-choice-row">
                {configurableOption.values.map((value) => (
                  <button
                    type="button"
                    class:list={['pd-choice-pill', selectedOptionValue === value && 'active']}
                    data-option-value={value}
                    data-option-name={configurableOption.name}
                  >
                    {value}
                  </button>
                ))}
              </div>
            )}
          </>
        )}

        <div class="pd-form">
          <input type="hidden" data-variant-id value={primaryVariant?.id ?? ''} />
          <button
            type="button"
            class:list={['pd-atc', !primaryVariant?.availableForSale && 'is-disabled']}
            data-pd-add
            disabled={!primaryVariant?.availableForSale}
          >
            {primaryVariant?.availableForSale ? 'Add to Basket' : 'Sold Out'}
          </button>
          <span class="pd-form-msg" data-cart-message aria-live="polite"></span>
        </div>

        <span class="pd-delivery-note">Free store shipping &nbsp;|&nbsp; Free home delivery on orders over ₹6,500</span>

        {product.description && (
          <div class="pd-body-copy">{product.description}</div>
        )}

        <div class="pd-acc">
          <div class="pd-acc-item">
            <button type="button" class="pd-acc-btn" data-accordion-trigger>
              See Measurement Table <i class="pd-acc-chevron"></i>
            </button>
            <div class="pd-acc-body">
              <div class="pd-acc-inner">
                <ul>
                  <li>XS — Width: 26 cm · Height: 20 cm · Depth: 8 cm</li>
                  <li>S — Width: 30 cm · Height: 22 cm · Depth: 10 cm</li>
                  <li>M — Width: 34 cm · Height: 26 cm · Depth: 12 cm</li>
                  <li>L — Width: 38 cm · Height: 30 cm · Depth: 14 cm</li>
                  <li>All measurements are approximate and may vary slightly.</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="pd-acc-item">
            <button type="button" class="pd-acc-btn" data-accordion-trigger>
              Fabric and Care <i class="pd-acc-chevron"></i>
            </button>
            <div class="pd-acc-body">
              <div class="pd-acc-inner">
                <ul>
                  <li>Full-grain leather construction with a soft hand feel.</li>
                  <li>Natural tonal shifts are part of the material character.</li>
                  <li>Condition every 3–4 months with a leather cream.</li>
                  <li>Store in a dust bag away from direct sunlight.</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="pd-acc-item">
            <button type="button" class="pd-acc-btn" data-accordion-trigger>
              Shipping, Exchanges and Returns <i class="pd-acc-chevron"></i>
            </button>
            <div class="pd-acc-body">
              <div class="pd-acc-inner">
                <ul>
                  <li>Free delivery across India on orders above ₹5,000.</li>
                  <li>Standard: 4–6 business days.</li>
                  <li>Express: 2–3 business days.</li>
                  <li>Free returns within 30 days of receipt.</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="pd-acc-item">
            <button type="button" class="pd-acc-btn" data-accordion-trigger>
              In-Store Availability <i class="pd-acc-chevron"></i>
            </button>
            <div class="pd-acc-body">
              <div class="pd-acc-inner">
                <ul>
                  <li>Available in select Riva Valencia stores and by appointment.</li>
                  <li>Call ahead to confirm stock before visiting.</li>
                  <li>Bespoke orders can be placed in-store with our specialists.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="pd-rev" id="pdRevs">
      <div class="pd-rev-head rv-reveal">
        <div>
          <span class="pd-rev-eyebrow">Verified Reviews</span>
          <span class="pd-rev-title">What Our Clients Say</span>
          <div class="pd-rev-avg">
            <span class="pd-rev-stars">★★★★★</span>
            <span class="pd-rev-num">4.9</span>
            <span class="pd-rev-sub">142 reviews</span>
          </div>
          <button type="button" class="pd-rev-write" data-review-toggle>Write a Review →</button>
        </div>
        <div class="pd-rev-bars">
          <div class="pd-rev-bar"><span class="pd-rev-bar-lbl">5 ★</span><div class="pd-rev-bar-track"><div class="pd-rev-bar-fill" data-width="88%"></div></div><span class="pd-rev-bar-cnt">125</span></div>
          <div class="pd-rev-bar"><span class="pd-rev-bar-lbl">4 ★</span><div class="pd-rev-bar-track"><div class="pd-rev-bar-fill" data-width="8%"></div></div><span class="pd-rev-bar-cnt">11</span></div>
          <div class="pd-rev-bar"><span class="pd-rev-bar-lbl">3 ★</span><div class="pd-rev-bar-track"><div class="pd-rev-bar-fill" data-width="3%"></div></div><span class="pd-rev-bar-cnt">4</span></div>
          <div class="pd-rev-bar"><span class="pd-rev-bar-lbl">2 ★</span><div class="pd-rev-bar-track"><div class="pd-rev-bar-fill" data-width="1%"></div></div><span class="pd-rev-bar-cnt">1</span></div>
          <div class="pd-rev-bar"><span class="pd-rev-bar-lbl">1 ★</span><div class="pd-rev-bar-track"><div class="pd-rev-bar-fill" data-width="0%"></div></div><span class="pd-rev-bar-cnt">0</span></div>
        </div>
      </div>

      <div class="pd-rev-form-wrap" data-review-panel hidden>
        <form class="pd-rev-form" data-review-form>
          <input class="pd-rev-input" type="text" name="name" placeholder="Your name" required />
          <select class="pd-rev-input" name="rating" required>
            <option value="5">5 stars</option>
            <option value="4">4 stars</option>
            <option value="3">3 stars</option>
            <option value="2">2 stars</option>
            <option value="1">1 star</option>
          </select>
          <input class="pd-rev-input" type="text" name="title" placeholder="Review title" required />
          <textarea class="pd-rev-input pd-rev-textarea" name="message" placeholder="Share your experience" required></textarea>
          <button type="submit" class="pd-rev-submit">Submit Review</button>
          <span class="pd-rev-submit-msg" data-review-message aria-live="polite"></span>
        </form>
      </div>

      <div class="pd-rev-grid" data-review-grid>
        {reviewEntries.map((review, index) => (
          <article class:list={['pd-rev-card', 'rv-reveal', index === 1 && 'd1', index === 2 && 'd2']} data-extra-review={index > 2 ? 'true' : 'false'} hidden={index > 2}>
            <div class="pd-rev-stars-sm">★★★★★</div>
            <div class="pd-rev-card-title">"{review.title}"</div>
            <p class="pd-rev-card-text">{review.text}</p>
            <div class="pd-rev-card-author">— {review.author}</div>
            <div class="pd-rev-card-date">{review.date}</div>
            <div class="pd-rev-verified">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              Verified Purchase
            </div>
          </article>
        ))}
      </div>

      <div class="pd-rev-more rv-reveal">
        <button type="button" class="pd-rev-more-btn" data-review-more>Load More Reviews →</button>
      </div>
    </div>

    {relatedProducts.length > 0 && (
      <>
        <div class="rv-orn rv-reveal"><span>✦</span></div>
        <div class="rv-sh rv-reveal" id="pdRecommended">
          <h2>You May Also Love</h2>
          <p>Recommended from our Shopify catalogue</p>
        </div>
        <div class="rv-hscroll">
          <div class="rv-htrack">
            {relatedProducts.map((item) => {
              const image = item.images.edges[0]?.node;
              const price = item.priceRange.minVariantPrice;
              return (
                <div class="rv-hcard">
                  <a class="rv-pc" href={`/products/${item.handle}`}>
                    <div class="rv-pc-img">
                      {image ? (
                        <img src={image.url} alt={image.altText ?? item.title} loading="lazy" />
                      ) : (
                        <div class="rv-pc-ph"></div>
                      )}
                      {getProductBadge(item).label === 'Best Seller' && <span class="rv-pc-badge">Best Seller</span>}
                    </div>
                    <div class="rv-pc-info">
                      <span class="rv-pc-cat">{item.productType || item.vendor || 'Leather Goods'}</span>
                      <span class="rv-pc-name">{item.title}</span>
                      <span class="rv-pc-price">{formatPrice(price.amount, price.currencyCode)}</span>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        </div>
      </>
    )}

    <div class="rv-trust">
      <div class="rv-ti rv-reveal">
        <span class="rv-ti-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <rect x="1" y="3" width="15" height="13" rx="1"></rect>
            <path d="M16 8h3l4 4v4h-7V8z"></path>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </span>
        <h3>Delivery</h3>
        <p>Worldwide shipping with great rates.</p>
      </div>
      <div class="rv-ti rv-reveal d1">
        <span class="rv-ti-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <rect x="1" y="4" width="22" height="16" rx="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        </span>
        <h3>Secure Payment</h3>
        <p>Pay in 3 or 4 installments.</p>
      </div>
      <div class="rv-ti rv-reveal d2">
        <span class="rv-ti-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"></path>
          </svg>
        </span>
        <h3>Returns</h3>
        <p>Easy returns within 30 days.</p>
      </div>
      <div class="rv-ti rv-reveal d3">
        <span class="rv-ti-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"></path>
          </svg>
        </span>
        <h3>Customer Service</h3>
        <p>Our team is here to help.</p>
      </div>
    </div>

    <div class="rv-pay rv-reveal">
      <span>VISA</span><span>MASTERCARD</span><span class="rv-pay-sep"></span><span>AMEX</span>
      <span class="rv-pay-sep"></span><span>APPLE PAY</span><span>GOOGLE PAY</span><span class="rv-pay-sep"></span>
      <span>PAYPAL</span><span>KLARNA</span><span class="rv-pay-sep"></span><span>UPI</span><span>RAZORPAY</span>
    </div>

    <div class="rv-nl rv-reveal">
      <span class="rv-nl-tag">Stay in the know</span>
      <h2>Join the World of Riva Valencia</h2>
      <span class="rv-nl-sub">New arrivals, exclusive offers &amp; stories from Spain</span>
      <form class="rv-nl-form" data-newsletter-form>
        <input class="rv-nl-input" type="email" name="email" placeholder="Your email address" required />
        <button type="submit">Subscribe</button>
      </form>
      <p class="rv-nl-note" data-newsletter-message>By subscribing you agree to our <a href="/pages/privacy" class="rv-inline-link">Privacy Policy</a>.</p>
    </div>

    <div class="pd-lb" data-lightbox>
      <button type="button" class="pd-lb-close" data-lightbox-close aria-label="Close gallery">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <button type="button" class="pd-lb-nav pd-lb-prev" data-lightbox-nav="-1" aria-label="Previous image">
