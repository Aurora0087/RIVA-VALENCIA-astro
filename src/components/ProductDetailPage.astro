  .rv-nl-tag{font-size:9px;letter-spacing:0.36em;text-transform:uppercase;color:#999;margin-bottom:12px;display:block;font-weight:400}
  .rv-nl h2{font-family:'Bebas Neue',sans-serif;font-size:clamp(26px,3.8vw,48px);letter-spacing:0.12em;color:#1a1008;margin-bottom:10px;font-weight:400}
  .rv-nl-sub{font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#aaa;margin-bottom:30px;display:block;font-weight:300}
  .rv-nl-form{display:flex;max-width:440px;margin:0 auto;border-bottom:1.5px solid #1a1008}
  .rv-nl-input{flex:1;border:none;outline:none;font-family:'Jost',sans-serif;font-size:14px;font-weight:300;background:transparent;color:#1a1008;padding:12px 4px}
  .rv-nl-input::placeholder{color:#ccc}
  .rv-nl-form button{background:none;border:none;cursor:pointer;color:#1a1008;font-size:9px;letter-spacing:0.28em;text-transform:uppercase;font-family:'Jost',sans-serif;padding:12px 14px;font-weight:600;transition:letter-spacing 0.3s}
  .rv-nl-form button:hover{letter-spacing:0.34em}
