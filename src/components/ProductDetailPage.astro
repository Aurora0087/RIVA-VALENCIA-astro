  .rv-ti h3{font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:#1a1008;margin-bottom:7px;font-weight:600}
  .rv-ti p{font-size:12px;color:#888;line-height:1.7;font-weight:300}
  .rv-pay{background:#f7f5f2;border-top:1px solid #e8e4de;border-bottom:1px solid #e8e4de;padding:14px 48px;display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap}
  .rv-pay span{font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#999;font-weight:400;opacity:0.8;transition:opacity 0.2s}
  .rv-pay span:hover{opacity:1}
  .rv-pay-sep{width:1px;height:12px;background:#ddd;flex-shrink:0}
