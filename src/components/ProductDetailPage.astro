<script
  is:inline
  define:vars={{
    optionName: configurableOption?.name ?? '',
    initialVariantId: primaryVariant?.id ?? '',
    variantData: variantPayload,
    imageData: imagePayload,
    productTitle: product?.title ?? '',
    wishlistBase: wishlistBasePayload,
  }}
>
  (async () => {
  const cartApi = window.RivaCart || await window.RivaCartReady;
  const wishlistApi = window.RivaWishlist || await window.RivaWishlistReady;
  const root = document.querySelector('[data-pd-root]');

  if (root) {
    const optionButtons = Array.from(root.querySelectorAll('[data-option-value]'));
    const priceEl = root.querySelector('[data-pd-price]');
    const compareEl = root.querySelector('[data-pd-compare]');
    const refEl = root.querySelector('[data-pd-ref]');
    const optionValueEl = root.querySelector('[data-option-label-value]');
    const variantInput = root.querySelector('[data-variant-id]');
    const addButton = root.querySelector('[data-pd-add]');
    const cartMessage = root.querySelector('[data-cart-message]');
    const wishlistButtons = Array.from(root.querySelectorAll('[data-wishlist-toggle]'));
    const reviewPanel = root.querySelector('[data-review-panel]');
    const reviewToggle = root.querySelector('[data-review-toggle]');
    const reviewForm = root.querySelector('[data-review-form]');
    const reviewGrid = root.querySelector('[data-review-grid]');
    const reviewMessage = root.querySelector('[data-review-message]');
    const reviewMoreButton = root.querySelector('[data-review-more]');
    const newsletterForm = root.querySelector('[data-newsletter-form]');
    const newsletterMessage = root.querySelector('[data-newsletter-message]');
    const recommendedSection = root.querySelector('#pdRecommended');
    const accordionButtons = Array.from(root.querySelectorAll('[data-accordion-trigger]'));
    const lightbox = root.querySelector('[data-lightbox]');
    const lightboxImage = root.querySelector('[data-lightbox-image]');
    const lightboxCount = root.querySelector('[data-lightbox-count]');
    const lightboxOpeners = Array.from(root.querySelectorAll('[data-open-lightbox]'));
    const lightboxNavs = Array.from(root.querySelectorAll('[data-lightbox-nav]'));
    const lightboxClose = root.querySelector('[data-lightbox-close]');
    const reviewBars = Array.from(root.querySelectorAll('.pd-rev-bar-fill'));

    let wished = false;
    let currentVariant = variantData.find((variant) => variant.id === initialVariantId) || variantData[0] || null;
    let lightboxIndex = 0;

    const formatMoney = (amount, currency) => new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency,
    }).format(Number(amount));

    const syncWishlist = () => {
      wishlistButtons.forEach((button) => {
        button.classList.toggle('wished', wished);
        button.setAttribute('aria-pressed', String(wished));
        const icon = button.querySelector('svg');
        if (icon) {
          icon.setAttribute('fill', wished ? '#8b3a2a' : 'none');
          icon.setAttribute('stroke', wished ? '#8b3a2a' : 'currentColor');
        }
      });
    };

    const refreshWishlist = () => {
      wished = Boolean(wishlistBase?.id && wishlistApi.isWishlisted(wishlistBase.id));
      syncWishlist();
    };

    const buildWishlistItem = () => ({
      ...wishlistBase,
      variantId: currentVariant?.id || initialVariantId || '',
      image: currentVariant?.imageUrl || wishlistBase?.image || '',
      imageAlt: wishlistBase?.imageAlt || productTitle,
      availableForSale: Boolean(currentVariant?.availableForSale),
      priceAmount: currentVariant?.price?.amount || '0',
      compareAtAmount: currentVariant?.compareAtPrice?.amount || '0',
      currencyCode: currentVariant?.price?.currencyCode || wishlistBase?.currencyCode || 'INR',
      addedAt: Date.now(),
    });

    const updateVariantUi = () => {
      if (!currentVariant) return;

      if (variantInput) variantInput.value = currentVariant.id;
      if (optionValueEl && optionName) {
        const selectedOption = currentVariant.selectedOptions.find((option) => option.name === optionName);
        if (selectedOption) optionValueEl.textContent = selectedOption.value;
      }
      if (priceEl) priceEl.textContent = formatMoney(currentVariant.price.amount, currentVariant.price.currencyCode);
      if (compareEl) {
        const hasCompare = currentVariant.compareAtPrice && Number(currentVariant.compareAtPrice.amount) > Number(currentVariant.price.amount);
        compareEl.textContent = hasCompare ? formatMoney(currentVariant.compareAtPrice.amount, currentVariant.compareAtPrice.currencyCode) : '';
        compareEl.hidden = !hasCompare;
      }
      if (refEl) refEl.textContent = `Ref. ${currentVariant.sku || currentVariant.id.split('/').pop()}`;
      if (addButton) {
        addButton.disabled = !currentVariant.availableForSale;
        addButton.classList.toggle('is-disabled', !currentVariant.availableForSale);
        addButton.textContent = currentVariant.availableForSale ? 'Add to Basket' : 'Sold Out';
      }

      optionButtons.forEach((button) => {
        const isActive = button.getAttribute('data-option-value') === optionValueEl?.textContent;
        button.classList.toggle('active', isActive);
      });
    };

    const findVariantForOption = (value) => {
      if (!optionName) return null;
      return variantData.find((variant) => variant.selectedOptions.some((option) => option.name === optionName && option.value === value && variant.availableForSale))
        || variantData.find((variant) => variant.selectedOptions.some((option) => option.name === optionName && option.value === value))
        || null;
    };

    const openLightbox = (index) => {
      if (!imageData.length || !lightbox || !lightboxImage || !lightboxCount) return;
      lightboxIndex = (index + imageData.length) % imageData.length;
      lightboxImage.src = imageData[lightboxIndex];
      lightboxImage.alt = `${productTitle} image ${lightboxIndex + 1}`;
      lightboxCount.textContent = `${lightboxIndex + 1} / ${imageData.length}`;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    };

    optionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-option-value');
        if (!value) return;
        const match = findVariantForOption(value);
        if (!match) return;
        currentVariant = match;
        updateVariantUi();
      });
    });

    if (addButton) {
      addButton.addEventListener('click', async () => {
        if (!currentVariant?.availableForSale) return;
        addButton.classList.add('done');
        addButton.textContent = 'Added ✓';
        if (cartMessage) cartMessage.textContent = 'Added to basket';

        try {
          await cartApi.addToCart(currentVariant.id, 1);
        } catch {
          if (cartMessage) cartMessage.textContent = 'Could not add item right now';
        }

        window.setTimeout(() => {
          addButton.classList.remove('done');
          addButton.textContent = currentVariant?.availableForSale ? 'Add to Basket' : 'Sold Out';
          if (cartMessage) cartMessage.textContent = '';
        }, 1800);
      });
    }

    wishlistButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.stopPropagation();
        if (!wishlistBase) return;
        wishlistApi.toggleWishlistItem(buildWishlistItem());
        refreshWishlist();
      });
    });

    window.addEventListener('rv:wishlist-changed', refreshWishlist);

    root.querySelectorAll('[data-scroll-to-recommended]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.stopPropagation();
        recommendedSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    accordionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const wasOpen = button.classList.contains('open');
        accordionButtons.forEach((otherButton) => {
          otherButton.classList.remove('open');
          otherButton.nextElementSibling?.classList.remove('open');
        });
        if (!wasOpen) {
          button.classList.add('open');
          button.nextElementSibling?.classList.add('open');
        }
      });
    });

    lightboxOpeners.forEach((button) => {
      button.addEventListener('click', (event) => {
        const nestedButton = event.target.closest('.pd-view-look, .pd-img-wish');
        if (nestedButton) return;
        const index = Number(button.getAttribute('data-open-lightbox') || '0');
        openLightbox(index);
      });
      button.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        const index = Number(button.getAttribute('data-open-lightbox') || '0');
        openLightbox(index);
      });
    });

    lightboxNavs.forEach((button) => {
      button.addEventListener('click', () => {
        const step = Number(button.getAttribute('data-lightbox-nav') || '0');
        openLightbox(lightboxIndex + step);
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    reviewToggle?.addEventListener('click', () => {
      if (!reviewPanel) return;
      const nowHidden = !reviewPanel.hasAttribute('hidden');
      if (nowHidden) {
        reviewPanel.setAttribute('hidden', '');
      } else {
        reviewPanel.removeAttribute('hidden');
        reviewPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    reviewForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!reviewGrid) return;
      const formData = new FormData(reviewForm);
      const name = String(formData.get('name') || '').trim();
      const rating = Number(formData.get('rating') || 5);
      const title = String(formData.get('title') || '').trim();
      const message = String(formData.get('message') || '').trim();

      if (!name || !title || !message) return;

      const card = document.createElement('article');
      card.className = 'pd-rev-card rv-reveal in';
      card.innerHTML = `
        <div class="pd-rev-stars-sm">${'★'.repeat(rating)}</div>
        <div class="pd-rev-card-title">"${title}"</div>
        <p class="pd-rev-card-text">${message}</p>
        <div class="pd-rev-card-author">— ${name}</div>
        <div class="pd-rev-card-date">Just now</div>
        <div class="pd-rev-verified">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Submitted Review
        </div>
      `;
      reviewGrid.prepend(card);
      reviewForm.reset();
      if (reviewMessage) reviewMessage.textContent = 'Review submitted';
      window.setTimeout(() => {
        if (reviewMessage) reviewMessage.textContent = '';
      }, 2000);
    });

    reviewMoreButton?.addEventListener('click', () => {
      root.querySelectorAll('[data-extra-review="true"]').forEach((card) => {
        card.removeAttribute('hidden');
      });
      reviewMoreButton.setAttribute('hidden', '');
    });

    newsletterForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(newsletterForm);
      const email = String(formData.get('email') || '').trim();
      if (!email) return;
      newsletterForm.reset();
      if (newsletterMessage) newsletterMessage.textContent = `Thanks, ${email} is subscribed.`;
    });

    if ('IntersectionObserver' in window && reviewBars.length > 0) {
      const reviewBarObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const bar = entry.target;
          bar.style.width = bar.getAttribute('data-width') || '0%';
          reviewBarObserver.unobserve(bar);
        });
      }, { threshold: 0.5 });

      reviewBars.forEach((bar) => reviewBarObserver.observe(bar));
    }

    document.addEventListener('keydown', (event) => {
      if (!lightbox?.classList.contains('open')) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowRight') openLightbox(lightboxIndex + 1);
      if (event.key === 'ArrowLeft') openLightbox(lightboxIndex - 1);
    });

    refreshWishlist();
    updateVariantUi();
  }
  })();
</script>
