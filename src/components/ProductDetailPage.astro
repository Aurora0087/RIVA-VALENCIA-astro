    .pd-sticky-atc-btn{padding-left:14px;padding-right:14px}
  }
</style>

<script
  is:inline
  define:vars={{
    optionName: configurableOption?.name ?? '',
    initialVariantId: primaryVariant?.id ?? '',
    variantData: variantPayload,
    imageData: imagePayload,
    productTitle: product?.title ?? '',
    wishlistBase: wishlistBasePayload,
    medusaUrl,
    medusaPublishableKey,
  }}
>
  (async () => {
  const cartApi = window.RivaCart || await window.RivaCartReady;
  const wishlistApi = window.RivaWishlist || await window.RivaWishlistReady;
  const customerApi = window.RivaCustomer || await window.RivaCustomerReady;
  const root = document.querySelector('[data-pd-root]');

  if (root) {
    const medusaBaseUrl = String(medusaUrl || '').replace(/\/+$/, '');
    const medusaPublishableKeyValue = String(medusaPublishableKey || '').trim();
    const optionButtons = Array.from(root.querySelectorAll('[data-option-value]'));
    const priceEl = root.querySelector('[data-pd-price]');
    const compareEl = root.querySelector('[data-pd-compare]');
    const refEl = root.querySelector('[data-pd-ref]');
    const optionValueEl = root.querySelector('[data-option-label-value]');
    const variantInput = root.querySelector('[data-variant-id]');
    const addButton = root.querySelector('[data-pd-add]');
    const infoPanel = root.querySelector('.pd-info');
    const stickyBar = root.querySelector('[data-pd-sticky-bar]');
    const stickyAddButton = root.querySelector('[data-pd-sticky-add]');
    const stickyVariantEl = root.querySelector('[data-pd-sticky-variant]');
    const cartMessage = root.querySelector('[data-cart-message]');
    const wishlistButtons = Array.from(root.querySelectorAll('[data-wishlist-toggle]'));
    const reviewPanel = root.querySelector('[data-review-panel]');
    const reviewToggle = root.querySelector('[data-review-toggle]');
    const reviewForm = root.querySelector('[data-review-form]');
    const ratingInputs = Array.from(root.querySelectorAll('[name="rating"]'));
    const reviewRatingValue = root.querySelector('[data-review-rating-value]');
    const reviewGrid = root.querySelector('[data-review-grid]');
    const reviewMessage = root.querySelector('[data-review-message]');
    const reviewMoreButton = root.querySelector('[data-review-more]');
    const reviewNameInput = reviewForm?.querySelector('[name="name"]');
    const reviewEmailInput = reviewForm?.querySelector('[name="email"]');
    const recommendedSection = root.querySelector('#pdRecommended');
    const accordionButtons = Array.from(root.querySelectorAll('[data-accordion-trigger]'));
    const lightbox = root.querySelector('[data-lightbox]');
    const lightboxImage = root.querySelector('[data-lightbox-image]');
    const lightboxCount = root.querySelector('[data-lightbox-count]');
    const lightboxOpeners = Array.from(root.querySelectorAll('[data-open-lightbox]'));
    const lightboxNavs = Array.from(root.querySelectorAll('[data-lightbox-nav]'));
    const lightboxClose = root.querySelector('[data-lightbox-close]');
    const reviewBars = Array.from(root.querySelectorAll('.pd-rev-bar-fill'));

    let wished = false;
    let currentVariant = variantData.find((variant) => variant.id === initialVariantId) || variantData[0] || null;
    let lightboxIndex = 0;
    let addResetTimer = 0;
    let isAddingToCart = false;
    let stickyScrollFrame = 0;

    const formatMoney = (amount, currency) => new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency,
    }).format(Number(amount));

    const addButtons = [addButton, stickyAddButton].filter(Boolean);

    const medusaHeaders = (headers = {}) => {
      const nextHeaders = { ...headers };
      if (medusaPublishableKeyValue) {
        nextHeaders['x-publishable-api-key'] = medusaPublishableKeyValue;
      }
      return nextHeaders;
    };

    const syncWishlist = () => {
      wishlistButtons.forEach((button) => {
        button.classList.toggle('wished', wished);
        button.setAttribute('aria-pressed', String(wished));
        const icon = button.querySelector('svg');
        if (icon) {
          icon.setAttribute('fill', wished ? '#8b3a2a' : 'none');
          icon.setAttribute('stroke', wished ? '#8b3a2a' : 'currentColor');
        }
      });
    };

    const refreshWishlist = () => {
      wished = Boolean(wishlistBase?.id && wishlistApi.isWishlisted(wishlistBase.id));
      syncWishlist();
    };

    const buildWishlistItem = () => ({
      ...wishlistBase,
      variantId: currentVariant?.id || initialVariantId || '',
      image: currentVariant?.imageUrl || wishlistBase?.image || '',
      imageAlt: wishlistBase?.imageAlt || productTitle,
      availableForSale: Boolean(currentVariant?.availableForSale),
      priceAmount: currentVariant?.price?.amount || '0',
      compareAtAmount: currentVariant?.compareAtPrice?.amount || '0',
      currencyCode: currentVariant?.price?.currencyCode || wishlistBase?.currencyCode || 'INR',
      addedAt: Date.now(),
    });

    const getVariantDisplayLabel = (variant) => {
      if (!variant) return '';
      const title = String(variant.title || '').trim();
      if (title && title.toLowerCase() !== 'default title') return title;
      return (variant.selectedOptions || [])
        .map((option) => option.value)
        .filter(Boolean)
        .join(' · ');
    };

    const syncStickyBarVisibility = (visible) => {
      if (!stickyBar) return;
      stickyBar.classList.toggle('is-visible', visible);
      stickyBar.setAttribute('aria-hidden', String(!visible));
    };

    const evaluateStickyBar = () => {
      stickyScrollFrame = 0;
      if (!addButton || !stickyBar) return;
      const rect = addButton.getBoundingClientRect();
      const topBoundary = 88;
      syncStickyBarVisibility(rect.bottom <= topBoundary);
    };

    const queueStickyBarCheck = () => {
      if (stickyScrollFrame) return;
      stickyScrollFrame = window.requestAnimationFrame(evaluateStickyBar);
    };

    const applyAddButtonState = (label, options = {}) => {
      const isDisabled = Boolean(options.disabled);
      const isDone = Boolean(options.done);
      addButtons.forEach((button) => {
        button.disabled = isDisabled;
        button.textContent = label;
        button.classList.toggle('is-disabled', isDisabled);
        button.classList.toggle('done', isDone);
      });
    };

    const updateVariantUi = () => {
      if (!currentVariant) return;

      if (variantInput) variantInput.value = currentVariant.id;
      if (optionValueEl && optionName) {
        const selectedOption = currentVariant.selectedOptions.find((option) => option.name === optionName);
        if (selectedOption) optionValueEl.textContent = selectedOption.value;
      }
      if (priceEl) priceEl.textContent = formatMoney(currentVariant.price.amount, currentVariant.price.currencyCode);
      if (compareEl) {
        const hasCompare = currentVariant.compareAtPrice && Number(currentVariant.compareAtPrice.amount) > Number(currentVariant.price.amount);
        compareEl.textContent = hasCompare ? formatMoney(currentVariant.compareAtPrice.amount, currentVariant.compareAtPrice.currencyCode) : '';
        compareEl.hidden = !hasCompare;
      }
      if (refEl) refEl.textContent = `Ref. ${currentVariant.sku || currentVariant.id.split('/').pop()}`;
      if (stickyVariantEl) {
        const variantLabel = getVariantDisplayLabel(currentVariant);
        stickyVariantEl.textContent = variantLabel;
        stickyVariantEl.hidden = !variantLabel;
      }
      if (!isAddingToCart) applyAddButtonState(currentVariant.availableForSale ? 'Add to Basket' : 'Sold Out', {
        disabled: !currentVariant.availableForSale,
      });

      optionButtons.forEach((button) => {
        const isActive = button.getAttribute('data-option-value') === optionValueEl?.textContent;
        button.classList.toggle('active', isActive);
      });
    };

    const findVariantForOption = (value) => {
      if (!optionName) return null;
      return variantData.find((variant) => variant.selectedOptions.some((option) => option.name === optionName && option.value === value && variant.availableForSale))
        || variantData.find((variant) => variant.selectedOptions.some((option) => option.name === optionName && option.value === value))
        || null;
    };

    const getCustomerDisplayName = (customer) => {
      const firstName = String(customer?.firstName || '').trim();
      const lastName = String(customer?.lastName || '').trim();
      const fullName = `${firstName} ${lastName}`.trim();
      if (fullName) return fullName;
      const email = String(customer?.email || '').trim();
      if (email) return email.split('@')[0];
      return '';
    };

    const openLightbox = (index) => {
      if (!imageData.length || !lightbox || !lightboxImage || !lightboxCount) return;
      lightboxIndex = (index + imageData.length) % imageData.length;
      lightboxImage.src = imageData[lightboxIndex];
      lightboxImage.alt = `${productTitle} image ${lightboxIndex + 1}`;
      lightboxCount.textContent = `${lightboxIndex + 1} / ${imageData.length}`;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    };

    const getReviewRatingCopy = (rating) => {
      if (rating >= 5) return '5 stars — Excellent';
      if (rating >= 4) return '4 stars — Very good';
      if (rating >= 3) return '3 stars — Good';
      if (rating >= 2) return '2 stars — Fair';
      return '1 star — Needs improvement';
    };

    const syncReviewRatingValue = () => {
      if (!reviewRatingValue) return;
      const selectedRating = Number(ratingInputs.find((input) => input.checked)?.value || 5);
      reviewRatingValue.textContent = getReviewRatingCopy(selectedRating);
    };

    optionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-option-value');
        if (!value) return;
        const match = findVariantForOption(value);
        if (!match) return;
        currentVariant = match;
        updateVariantUi();
      });
    });

    const handleAddToCart = async () => {
      if (!currentVariant?.availableForSale || isAddingToCart) return;
      isAddingToCart = true;
      window.clearTimeout(addResetTimer);
      applyAddButtonState('Adding…', { disabled: true });
      if (cartMessage) cartMessage.textContent = 'Adding to basket';

      try {
        await cartApi.addToCart(currentVariant.id, 1);
        applyAddButtonState('Added ✓', { disabled: false, done: true });
        if (cartMessage) cartMessage.textContent = 'Added to basket';
      } catch {
        applyAddButtonState(currentVariant?.availableForSale ? 'Add to Basket' : 'Sold Out', {
          disabled: !currentVariant?.availableForSale,
        });
        if (cartMessage) cartMessage.textContent = 'Could not add item right now';
      } finally {
        isAddingToCart = false;
        addResetTimer = window.setTimeout(() => {
          applyAddButtonState(currentVariant?.availableForSale ? 'Add to Basket' : 'Sold Out', {
            disabled: !currentVariant?.availableForSale,
          });
          if (cartMessage) cartMessage.textContent = '';
        }, 1800);
      }
    };

    addButtons.forEach((button) => {
      button.addEventListener('click', handleAddToCart);
    });

    wishlistButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.stopPropagation();
        if (!wishlistBase) return;
        wishlistApi.toggleWishlistItem(buildWishlistItem());
        refreshWishlist();
      });
    });

    window.addEventListener('rv:wishlist-changed', refreshWishlist);

    root.querySelectorAll('[data-scroll-to-recommended]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.stopPropagation();
        recommendedSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    accordionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const wasOpen = button.classList.contains('open');
        accordionButtons.forEach((otherButton) => {
          otherButton.classList.remove('open');
          otherButton.nextElementSibling?.classList.remove('open');
        });
        if (!wasOpen) {
          button.classList.add('open');
          button.nextElementSibling?.classList.add('open');
        }
      });
    });

    lightboxOpeners.forEach((button) => {
      button.addEventListener('click', (event) => {
        const nestedButton = event.target.closest('.pd-view-look, .pd-img-wish');
        if (nestedButton) return;
        const index = Number(button.getAttribute('data-open-lightbox') || '0');
        openLightbox(index);
      });
      button.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        const index = Number(button.getAttribute('data-open-lightbox') || '0');
        openLightbox(index);
      });
    });

    lightboxNavs.forEach((button) => {
      button.addEventListener('click', () => {
        const step = Number(button.getAttribute('data-lightbox-nav') || '0');
        openLightbox(lightboxIndex + step);
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    reviewToggle?.addEventListener('click', () => {
      if (!reviewPanel) return;
      const nowHidden = !reviewPanel.hasAttribute('hidden');
      if (nowHidden) {
        reviewPanel.setAttribute('hidden', '');
      } else {
        reviewPanel.removeAttribute('hidden');
        reviewPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    ratingInputs.forEach((input) => {
      input.addEventListener('change', syncReviewRatingValue);
    });
    syncReviewRatingValue();

    reviewForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(reviewForm);
      const name = String(formData.get('name') || '').trim();
      const email = String(formData.get('email') || '').trim();
      const rating = Number(formData.get('rating') || 5);
      const title = String(formData.get('title') || '').trim();
      const message = String(formData.get('message') || '').trim();

      if (!name || !email || !title || !message) return;
      if (!medusaBaseUrl || !medusaPublishableKeyValue) {
        if (reviewMessage) reviewMessage.textContent = 'Reviews are temporarily unavailable.';
        return;
      }

      const submitBtn = reviewForm.querySelector('[type="submit"]');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Submitting…'; }
      let submitted = false;

      try {
        const res = await fetch(`${medusaBaseUrl}/store/reviews`, {
          method: 'POST',
          headers: medusaHeaders({ 'Content-Type': 'application/json' }),
          body: JSON.stringify({
            product_id: wishlistBase?.id || '',
            product_handle: wishlistBase?.handle || '',
            storefront_origin: window.location.origin,
            customer_name: name,
            customer_email: email,
            rating,
            title,
            content: message,
            metadata: {
              page_url: window.location.href,
              product_title: productTitle,
            },
          }),
        });
        if (!res.ok) throw new Error('submit_failed');
        submitted = true;
        reviewForm.reset();
        syncReviewRatingValue();
        if (reviewMessage) reviewMessage.textContent = 'Thank you! Your review is awaiting approval.';
      } catch {
        if (reviewMessage) reviewMessage.textContent = 'Could not submit — please try again.';
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Submit Review'; }
      }

      window.setTimeout(() => {
        if (reviewMessage) reviewMessage.textContent = '';
        if (submitted && reviewPanel) reviewPanel.setAttribute('hidden', '');
      }, 4000);
    });

    reviewMoreButton?.addEventListener('click', () => {
      root.querySelectorAll('[data-extra-review="true"]').forEach((card) => {
        card.removeAttribute('hidden');
      });
      reviewMoreButton.setAttribute('hidden', '');
    });

    if ('IntersectionObserver' in window && reviewBars.length > 0) {
      const reviewBarObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const bar = entry.target;
          bar.style.width = bar.getAttribute('data-width') || '0%';
          reviewBarObserver.unobserve(bar);
        });
      }, { threshold: 0.5 });

      reviewBars.forEach((bar) => reviewBarObserver.observe(bar));
    }

    window.addEventListener('scroll', queueStickyBarCheck, { passive: true });
    window.addEventListener('resize', queueStickyBarCheck);
    infoPanel?.addEventListener('scroll', queueStickyBarCheck, { passive: true });

    document.addEventListener('keydown', (event) => {
      if (!lightbox?.classList.contains('open')) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowRight') openLightbox(lightboxIndex + 1);
      if (event.key === 'ArrowLeft') openLightbox(lightboxIndex - 1);
    });

    const esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    Promise.resolve(customerApi?.getCustomerProfile?.())
      .then((customerProfile) => {
        if (!customerProfile) return;
        const customerName = getCustomerDisplayName(customerProfile);
        if (reviewNameInput && !reviewNameInput.value && customerName) {
          reviewNameInput.value = customerName;
        }
        if (reviewEmailInput && !reviewEmailInput.value && customerProfile.email) {
          reviewEmailInput.value = customerProfile.email;
        }
      })
      .catch(() => {});

    const loadMedusaReviews = async () => {
      if (!medusaBaseUrl || !medusaPublishableKeyValue || !wishlistBase?.id) return;
      try {
        const params = new URLSearchParams({
          product_id: wishlistBase.id,
          limit: '100',
        });
        const res = await fetch(`${medusaBaseUrl}/store/reviews?${params.toString()}`, {
          headers: medusaHeaders(),
        });
        if (!res.ok) return;
        const data = await res.json();
        const reviews = data.reviews || [];
        const summary = data.summary || {};
        const count = Number(summary.total_reviews ?? data.count ?? 0);
        const avg = Number(summary.average_rating ?? 0);
        const ratingCounts = summary.rating_counts || {};

        const revNumEl = root.querySelector('.pd-rev-num');
        const revStarsEl = root.querySelector('.pd-rev-stars');
        const revSubEl = root.querySelector('.pd-rev-sub');
        if (revNumEl) revNumEl.textContent = avg.toFixed(1);
        if (revStarsEl) revStarsEl.textContent = count > 0 ? '★★★★★' : '☆☆☆☆☆';
        if (revSubEl) revSubEl.textContent = count > 0 ? `${count} review${count !== 1 ? 's' : ''}` : 'No reviews yet';

        const dist = [5, 4, 3, 2, 1].map((n) => Number(ratingCounts[String(n)] ?? 0));
        reviewBars.forEach((bar, idx) => {
          const pct = count > 0 ? Math.round((dist[idx] / count) * 100) : 0;
          const cntEl = bar.closest('.pd-rev-bar')?.querySelector('.pd-rev-bar-cnt');
          bar.setAttribute('data-width', `${pct}%`);
          bar.style.width = `${pct}%`;
          if (cntEl) cntEl.textContent = String(dist[idx]);
        });

        if (reviewGrid) {
          reviewGrid.innerHTML = '';
          if (reviews.length === 0) {
            reviewGrid.classList.remove('is-single');
            const emptyCard = document.createElement('article');
            emptyCard.className = 'pd-rev-card pd-rev-card-empty rv-reveal in';
            emptyCard.innerHTML = `
              <div class="pd-rev-card-top">
                <div class="pd-rev-stars-sm">☆☆☆☆☆</div>
              </div>
              <span class="pd-rev-card-kicker">Review title</span>
              <div class="pd-rev-card-title">Be the first to review</div>
              <p class="pd-rev-card-text">Verified customer reviews will appear here once they have been approved by our team.</p>
              <div class="pd-rev-card-foot">
                <div class="pd-rev-card-author-block">
                  <span class="pd-rev-card-author">Share Your Experience</span>
                  <span class="pd-rev-card-date">Awaiting first review</span>
                </div>
              </div>
            `;
            reviewGrid.appendChild(emptyCard);
            reviewMoreButton?.setAttribute('hidden', '');
            return;
          }

          reviewGrid.classList.toggle('is-single', reviews.length === 1);

          reviews.forEach((r, index) => {
            const card = document.createElement('article');
            card.className = 'pd-rev-card rv-reveal in';
            card.setAttribute('data-extra-review', index > 2 ? 'true' : 'false');
            if (index > 2) card.hidden = true;
            const filled = '★'.repeat(r.rating);
            const empty = '☆'.repeat(5 - r.rating);
            const createdAt = r.created_at ? new Date(r.created_at) : null;
            const dateStr = createdAt && !Number.isNaN(createdAt.getTime())
              ? createdAt.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' })
              : 'Recently added';
            const verificationStatus = String(r.verification_status || 'unverified');
            const verificationLabel = verificationStatus === 'verified_purchase'
              ? 'Verified Purchase'
              : verificationStatus === 'manually_verified'
                ? 'Verified Review'
                : '';
            card.innerHTML = `
              <div class="pd-rev-card-top">
                <div class="pd-rev-stars-sm">${filled}${empty}</div>
                ${verificationLabel ? `<div class="pd-rev-verified"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>${esc(verificationLabel)}</div>` : ''}
              </div>
              <span class="pd-rev-card-kicker">Review title</span>
              <div class="pd-rev-card-title">${esc(r.title || r.content.slice(0, 50))}</div>
              <p class="pd-rev-card-text">${esc(r.content)}</p>
              <div class="pd-rev-card-foot">
                <div class="pd-rev-card-author-block">
                  <span class="pd-rev-card-author">${esc(r.customer_name)}</span>
                  <span class="pd-rev-card-date">${dateStr}</span>
                </div>
              </div>
            `;
            reviewGrid.appendChild(card);
          });
        }

        if (reviewMoreButton) {
          if (reviews.length > 3) {
            reviewMoreButton.removeAttribute('hidden');
          } else {
            reviewMoreButton.setAttribute('hidden', '');
          }
        }
      } catch {
        // Keep the neutral empty state when Medusa is unavailable.
      }
    };

    refreshWishlist();
    updateVariantUi();
    loadMedusaReviews();
    evaluateStickyBar();
  }
  })();
</script>
