  .rv-nl-note{font-size:10px;color:#b8b0a6;margin-top:14px;letter-spacing:0.07em;font-weight:300}
  .rv-pay{background:#f2eee8;border-top:1px solid #e8e4de;border-bottom:1px solid #e8e4de;padding:18px 48px;display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap}
  .rv-pay span{font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:#8a7660;font-weight:500;opacity:0.7;transition:opacity 0.2s}
  .rv-pay span:hover{opacity:1}
  .rv-pay-sep{width:1px;height:14px;background:#c8c0b4;flex-shrink:0}
  @media(max-width:960px){
    .cg-crumb,.cg-logos,.cg-why,.cg-packs,.cg-process,.cg-testi,.cg-faq,.rv-nl,.rv-pay{padding-left:20px;padding-right:20px}
    .cg-hero-c{padding:0 28px 48px}
    .cg-intro,.cg-custom,.cg-form-section{grid-template-columns:1fr}
    .cg-intro-img img,.cg-custom-img img{min-height:300px;height:300px}
    .cg-intro-text,.cg-custom-text,.cg-form-left,.cg-form-right{padding:44px 24px}
    .cg-form-right{border-left:none;border-top:1px solid #e8e4de}
    .cg-why-grid,.cg-packs-grid{grid-template-columns:1fr}
    .cg-steps{grid-template-columns:1fr 1fr}
    .cg-steps::before{display:none}
    .cg-stats{grid-template-columns:1fr 1fr}
    .cg-stat{border-right:none;border-bottom:1px solid rgba(250,250,248,0.06)}
    .cg-stat:nth-child(odd){border-right:1px solid rgba(250,250,248,0.06)}
    .cg-field-row{grid-template-columns:1fr}
    .cg-logo-item{font-size:13px;padding:0 14px}
    .cg-logos-label{display:none}
    .cg-custom-options{grid-template-columns:1fr}
  }
  @media(max-width:520px){
    .cg-stats,.cg-steps{grid-template-columns:1fr}
    .cg-stat:nth-child(odd){border-right:none}
    .rv-nl-form{display:block;border-bottom:none}
    .rv-nl-form input{width:100%;border-bottom:1.5px solid #1a1008;text-align:center}
  }
</style>

<script is:inline>
  (function() {
    var root = document.querySelector('[data-cg-root]');
    if (!root) return;

    var form = root.querySelector('[data-cg-form]');
    var success = root.querySelector('[data-cg-success]');
    var submit = root.querySelector('[data-cg-submit]');
    var selectedPackage = root.querySelector('[data-selected-package]');
    var messageField = form && form.elements.namedItem('message');

    function scrollToForm() {
      var target = document.getElementById('cgForm');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function setPackage(name) {
      if (selectedPackage) selectedPackage.value = name;
      var packageSelect = form && form.elements.namedItem('package');
      if (packageSelect) {
        packageSelect.value = name;
        packageSelect.classList.add('chosen');
      }
      if (messageField && !messageField.value.includes(name)) {
        messageField.value = (messageField.value ? messageField.value + '\n' : '') + 'Interested package: ' + name;
        messageField.classList.add('hv');
      }
      scrollToForm();
    }

    root.querySelectorAll('[data-cg-scroll]').forEach(function(button) {
      button.addEventListener('click', scrollToForm);
    });

    root.querySelectorAll('[data-cg-package]').forEach(function(button) {
      button.addEventListener('click', function() {
        setPackage(button.dataset.cgPackage);
      });
    });

    root.querySelectorAll('[data-cg-note]').forEach(function(button) {
      button.addEventListener('click', function() {
        button.classList.toggle('active');
        if (messageField && !messageField.value.includes(button.dataset.cgNote)) {
          messageField.value = (messageField.value ? messageField.value + '\n' : '') + 'Interested in: ' + button.dataset.cgNote;
          messageField.classList.add('hv');
        }
        scrollToForm();
      });
    });

    root.querySelectorAll('.cg-finput,.cg-ftarea').forEach(function(input) {
      function check() { input.classList.toggle('hv', input.value.trim().length > 0); }
      input.addEventListener('input', check);
      input.addEventListener('blur', check);
      check();
    });

    root.querySelectorAll('.cg-fselect').forEach(function(select) {
      select.addEventListener('change', function() {
        select.classList.add('chosen');
      });
    });

    root.querySelectorAll('[data-cg-accordion]').forEach(function(button) {
      button.addEventListener('click', function() {
        var content = button.nextElementSibling;
        var wasOpen = button.classList.contains('open');
        root.querySelectorAll('.cg-acc-btn.open').forEach(function(openButton) {
          openButton.classList.remove('open');
          openButton.nextElementSibling.classList.remove('open');
        });
        if (!wasOpen) {
          button.classList.add('open');
          content.classList.add('open');
        }
      });
    });

    root.querySelectorAll('.cg-step').forEach(function(step, index) {
      step.style.transitionDelay = index * 0.12 + 's';
    });
    if ('IntersectionObserver' in window) {
      var stepObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            stepObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      root.querySelectorAll('.cg-step').forEach(function(step) {
        stepObserver.observe(step);
      });
    } else {
      root.querySelectorAll('.cg-step').forEach(function(step) {
        step.classList.add('in');
      });
    }

    if (form) {
      form.addEventListener('submit', function(event) {
        event.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        var data = Object.fromEntries(new FormData(form).entries());
        var id = 'RV-CG-' + Date.now().toString(36).toUpperCase();
        data.id = id;
        data.createdAt = new Date().toISOString();
        var enquiries = [];
        try {
          enquiries = JSON.parse(localStorage.getItem('rv-corporate-gift-enquiries') || '[]');
        } catch (error) {
          enquiries = [];
        }
        enquiries.unshift(data);
        localStorage.setItem('rv-corporate-gift-enquiries', JSON.stringify(enquiries.slice(0, 20)));

        submit.classList.add('sent');
        submit.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Enquiry Sent';
        form.hidden = true;
        success.hidden = false;
        root.querySelector('[data-cg-ref]').textContent = id;
      });
    }

    var reset = root.querySelector('[data-cg-reset]');
    if (reset) {
      reset.addEventListener('click', function() {
        success.hidden = true;
        form.hidden = false;
        form.reset();
        root.querySelectorAll('.cg-finput,.cg-ftarea').forEach(function(input) { input.classList.remove('hv'); });
        root.querySelectorAll('.cg-fselect').forEach(function(select) { select.classList.remove('chosen'); });
        submit.classList.remove('sent');
        submit.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Request My Corporate Quote';
      });
    }

    var newsletter = root.querySelector('[data-cg-newsletter]');
    if (newsletter) {
      newsletter.addEventListener('submit', function(event) {
        event.preventDefault();
        if (!newsletter.checkValidity()) {
          newsletter.reportValidity();
          return;
        }
        root.querySelector('[data-cg-newsletter-note]').textContent = 'Thank you. You are subscribed to corporate updates.';
        newsletter.reset();
      });
    }

    (function initCorporateTestimonials() {
      var testiEl = document.getElementById('cgTestiSwiper');
      if (!testiEl || !window.Swiper) return;
      if (testiEl.swiper) {
        testiEl.swiper.update();
        return;
      }
      new window.Swiper(testiEl, {
        loop: true,
        speed: 950,
        slidesPerView: 1.08,
        spaceBetween: 14,
        autoplay: {
          delay: 2800,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        breakpoints: {
          640: { slidesPerView: 1.4, spaceBetween: 16 },
          960: { slidesPerView: 2.2, spaceBetween: 18 },
          1280: { slidesPerView: 3, spaceBetween: 20 },
        },
      });
    })();
  })();
</script>
