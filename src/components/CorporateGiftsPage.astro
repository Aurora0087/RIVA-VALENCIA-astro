---
const heroImage =
  'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_jvsu4qjvsu4qjvsu.png?v=1776006386';
const introImage =
  'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_ohy6lqohy6lqohy6.png?v=1776001569';
const essentialImage =
  'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_2qiani2qiani2qia.png?v=1775996042';
const signatureImage =
  'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/download_4.jpg?v=1775929126';
const executiveImage =
  'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/gudzyk____ai_creator.jpg?v=1775994405';
const customImage =
  'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_n17qn0n17qn0n17q.png?v=1776004987';
const testimonials = [
  {
    quote:
      'The gifting programme felt considered from first conversation to final delivery. Our clients in Madrid kept asking where the pieces were made.',
    author: 'Lucia Navarro, Client Experience Director',
    company: 'Aurelia Capital, Madrid, Spain',
  },
  {
    quote:
      'We commissioned portfolios for a leadership event in Milan and the finish was impeccable. Elegant, understated, and genuinely memorable.',
    author: 'Matteo Rinaldi, People & Culture Lead',
    company: 'Venturi Advisory, Milan, Italy',
  },
  {
    quote:
      'Packaging, monogramming, and timing were all handled beautifully. The leather quality gave the project a sense of permanence our team really appreciated.',
    author: 'Carmen Ortega, Brand Partnerships Manager',
    company: 'Grupo Levante, Valencia, Spain',
  },
  {
    quote:
      'The account handling was clear, calm, and highly professional. For executive gifting in Florence, this was exactly the tone we wanted.',
    author: 'Giulia Moretti, Corporate Relations Director',
    company: 'Bellavista Studio, Florence, Italy',
  },
];
---

<div class="cg-page" data-cg-root>
  <section class="cg-hero" id="cgHero">
    <img src={heroImage} alt="Corporate Gifts Riva Valencia" loading="eager" />
    <div class="cg-hero-grad"></div>
    <div class="cg-hero-c">
      <span class="cg-eyebrow">Corporate Gifting Programme · 2026</span>
      <span class="cg-h1">Give Leather.<br />Leave a Legacy.</span>
      <div class="cg-hero-rule"></div>
      <span class="cg-hero-sub">
        "The most memorable corporate gift is one that outlasts the occasion:
        a piece of Spanish craft that carries your brand's values for years."
      </span>
      <button type="button" class="cg-hero-cta" data-cg-scroll="#cgForm">Request a Quote →</button>
    </div>
  </section>

  <div class="rv-ann">
    <div class="rv-ann-track">
      <span>
        Free delivery on orders above ₹5,000 &nbsp;·&nbsp; Handcrafted in Spain &nbsp;·&nbsp;
        Corporate gifting available &nbsp;·&nbsp; Minimum order 10 pieces &nbsp;·&nbsp;
        Monogramming included &nbsp;·&nbsp; Free delivery on orders above ₹5,000 &nbsp;·&nbsp;
        Handcrafted in Spain &nbsp;·&nbsp; Corporate gifting available &nbsp;·&nbsp;
        Minimum order 10 pieces &nbsp;·&nbsp; Monogramming included
      </span>
    </div>
  </div>

  <nav class="cg-crumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="cg-crumb-sep">›</span>
    <span>Corporate Gifts</span>
  </nav>

  <div class="cg-logos rv-reveal">
    <span class="cg-logos-label">Trusted by</span>
    <span class="cg-logo-item">TATA GROUP</span>
    <span class="cg-logo-item">INFOSYS</span>
    <span class="cg-logo-item">MAHINDRA</span>
    <span class="cg-logo-item">RELIANCE</span>
    <span class="cg-logo-item">HDFC</span>
    <span class="cg-logo-item">WIPRO</span>
  </div>

  <section class="cg-intro">
    <div class="cg-intro-img">
      <img src={introImage} alt="Corporate leather gifts" loading="lazy" />
    </div>
    <div class="cg-intro-text rv-reveal rv-reveal-r">
      <span class="cg-tag">Why Riva Valencia for Your Business</span>
      <h2 class="cg-h2">Gifts That Speak<br />Louder Than Logos</h2>
      <p class="cg-p">
        When a client or colleague unwraps a Riva Valencia piece, they do not reach for the price tag:
        they reach for the phone to ask where it came from. Our corporate gifting programme puts that
        conversation in your hands.
      </p>
      <p class="cg-p">
        From handcrafted wallets and portfolios to full leather desk sets, every piece is made in Valencia,
        monogrammed with your recipient's initials, and delivered in our signature black gift box.
      </p>
      <button type="button" class="cg-link" data-cg-scroll="#cgForm">Get a Quote →</button>
    </div>
  </section>

  <section class="cg-stats" aria-label="Corporate gifting statistics">
    <div class="cg-stat rv-reveal"><span class="cg-stat-n">10+</span><span class="cg-stat-l">Minimum order</span><span class="cg-stat-d">No maximum: we scale to your needs</span></div>
    <div class="cg-stat rv-reveal d1"><span class="cg-stat-n">14</span><span class="cg-stat-l">Day lead time</span><span class="cg-stat-d">From approval to delivery, pan-India</span></div>
    <div class="cg-stat rv-reveal d2"><span class="cg-stat-n">100%</span><span class="cg-stat-l">Customisable</span><span class="cg-stat-d">Initials, colour, hardware, packaging</span></div>
    <div class="cg-stat rv-reveal d3"><span class="cg-stat-n">500+</span><span class="cg-stat-l">Pieces gifted</span><span class="cg-stat-d">Across India's leading companies</span></div>
  </section>

  <section class="cg-why">
    <div class="cg-sec-head rv-reveal">
      <span class="cg-sec-eyebrow">What Makes the Difference</span>
      <span class="cg-sec-h">The Riva Valencia Advantage</span>
      <p class="cg-sec-sub">Six reasons India's top companies choose our leather for their most important gifts</p>
    </div>
    <div class="cg-why-grid">
      <article class="cg-why-card rv-reveal">
        <div class="cg-why-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <span class="cg-why-t">Full-Grain Quality</span>
        <p class="cg-why-b">Every piece uses full-grain vegetable-tanned leather: the highest grade available. Recipients feel the difference the moment they hold it.</p>
      </article>
      <article class="cg-why-card rv-reveal d1">
        <div class="cg-why-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div>
        <span class="cg-why-t">Personal Monogramming</span>
        <p class="cg-why-b">Every piece is hand-stamped with the recipient's initials in gold, silver, or blind emboss. A gift with someone's name on it is never re-gifted.</p>
      </article>
      <article class="cg-why-card rv-reveal d2">
        <div class="cg-why-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h3l4 4v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
        <span class="cg-why-t">White-Glove Delivery</span>
        <p class="cg-why-b">We ship individually to each recipient's address, or in one consolidated delivery. Each piece arrives gift-ready with your message.</p>
      </article>
      <article class="cg-why-card rv-reveal">
        <div class="cg-why-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
        <span class="cg-why-t">Transparent Volume Pricing</span>
        <p class="cg-why-b">The more you order, the better the per-unit price. No hidden setup fees, no surprise charges. One price, agreed upfront.</p>
      </article>
      <article class="cg-why-card rv-reveal d1">
        <div class="cg-why-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
        <span class="cg-why-t">14-Day Turnaround</span>
        <p class="cg-why-b">From final approval to delivery across India: 14 working days. For urgent orders above 50 pieces, express review is available.</p>
      </article>
      <article class="cg-why-card rv-reveal d2">
        <div class="cg-why-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div>
        <span class="cg-why-t">Dedicated Account Manager</span>
        <p class="cg-why-b">Every corporate client is assigned one account manager who oversees the order from first enquiry to final delivery.</p>
      </article>
    </div>
  </section>

  <section class="cg-packs">
    <div class="cg-sec-head rv-reveal">
      <span class="cg-sec-eyebrow">Gift Collections</span>
      <span class="cg-sec-h">Choose Your Package</span>
      <p class="cg-sec-sub">All packages include monogramming, signature gift box, and handwritten card</p>
    </div>
    <div class="cg-packs-grid">
      <article class="cg-pack rv-reveal">
        <div class="cg-pack-img"><img src={essentialImage} alt="Essential corporate gift package" loading="lazy" /></div>
        <div class="cg-pack-body">
          <span class="cg-pack-badge">From 10 Pieces</span>
          <span class="cg-pack-name">The Essential</span>
          <span class="cg-pack-moq">Starting at ₹3,500 per piece</span>
          <ul class="cg-pack-items">
            <li>Zip-around leather wallet</li>
            <li>Choice of 5 leather colours</li>
            <li>Gold or silver monogramming</li>
            <li>Signature black gift box</li>
            <li>Handwritten message card</li>
          </ul>
          <button class="cg-pack-btn" type="button" data-cg-package="The Essential">Enquire Now</button>
        </div>
      </article>

      <article class="cg-pack featured rv-reveal d1">
        <div class="cg-pack-img"><img src={signatureImage} alt="Signature corporate gift package" loading="lazy" /></div>
        <div class="cg-pack-body">
          <span class="cg-pack-badge">Most Popular · From 25 Pieces</span>
          <span class="cg-pack-name">The Signature</span>
          <span class="cg-pack-moq">Starting at ₹9,500 per piece</span>
          <ul class="cg-pack-items">
            <li>Full-grain leather tote or shoulder bag</li>
            <li>Choice of 8 leather colours</li>
            <li>Gold, silver, or blind monogramming</li>
            <li>Luxury black lacquer gift box</li>
            <li>Leather care card in gift box</li>
          </ul>
          <button class="cg-pack-btn" type="button" data-cg-package="The Signature">Enquire Now</button>
        </div>
      </article>

      <article class="cg-pack rv-reveal d2">
        <div class="cg-pack-img"><img src={executiveImage} alt="Executive corporate gift package" loading="lazy" /></div>
        <div class="cg-pack-body">
          <span class="cg-pack-badge">From 15 Pieces</span>
          <span class="cg-pack-name">The Executive</span>
          <span class="cg-pack-moq">Starting at ₹14,000 per piece</span>
          <ul class="cg-pack-items">
            <li>Full leather portfolio and document bag</li>
            <li>Matching card holder included</li>
            <li>Company logo blind-embossed</li>
            <li>Custom lining colour available</li>
            <li>Dedicated delivery to each recipient</li>
          </ul>
          <button class="cg-pack-btn" type="button" data-cg-package="The Executive">Enquire Now</button>
        </div>
      </article>
    </div>
  </section>

  <section class="cg-custom">
    <div class="cg-custom-img rv-reveal rv-reveal-l">
      <img src={customImage} alt="Leather customisation" loading="lazy" />
    </div>
    <div class="cg-custom-text rv-reveal rv-reveal-r">
      <span class="cg-custom-tag">Make It Yours</span>
      <div class="cg-custom-h">Every Detail.<br />Fully Bespoke.</div>
      <p class="cg-custom-p">
        Beyond our standard packages, every element can be tailored:
        leather colour, hardware finish, lining, stitching, packaging design and brand presentation.
      </p>
      <div class="cg-custom-options">
        {[
          'Recipient Monogramming',
          '8 Leather Colours',
          'Company Logo Embossing',
          'Custom Gift Packaging',
          'Gold or Silver Hardware',
          'Handwritten Gift Cards',
        ].map((label) => (
          <button type="button" class="cg-custom-opt" data-cg-note={label}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{label}</span>
          </button>
        ))}
      </div>
      <button type="button" class="cg-custom-cta" data-cg-scroll="#cgForm">Discuss Your Requirements →</button>
    </div>
  </section>

  <section class="cg-process">
    <div class="cg-sec-head rv-reveal">
      <span class="cg-sec-eyebrow">Simple from Start to Finish</span>
      <span class="cg-sec-h">How It Works</span>
      <p class="cg-sec-sub">Four steps from your first enquiry to your recipients unwrapping their gifts</p>
    </div>
    <div class="cg-steps">
      <article class="cg-step"><div class="cg-step-num"><span class="cg-step-num-inner">01</span></div><span class="cg-step-t">Enquire</span><p class="cg-step-b">Tell us your quantity, budget, package and occasion.</p></article>
      <article class="cg-step"><div class="cg-step-num"><span class="cg-step-num-inner">02</span></div><span class="cg-step-t">Customise</span><p class="cg-step-b">Your account manager presents leather colours, monogramming, hardware and packaging.</p></article>
      <article class="cg-step"><div class="cg-step-num"><span class="cg-step-num-inner">03</span></div><span class="cg-step-t">Approve</span><p class="cg-step-b">We create a pre-production sample or digital mockup for approval.</p></article>
      <article class="cg-step"><div class="cg-step-num"><span class="cg-step-num-inner">04</span></div><span class="cg-step-t">Deliver</span><p class="cg-step-b">Individual delivery to recipients or consolidated delivery to your office.</p></article>
    </div>
  </section>

  <div class="rv-orn rv-reveal"><span>✦</span></div>

  <section class="cg-testi">
    <div class="cg-sec-head rv-reveal">
      <span class="cg-sec-eyebrow">What Corporate Clients Say</span>
      <span class="cg-sec-h">Trusted Across Spain & Italy</span>
      <p class="cg-sec-sub">The response when a Riva Valencia gift arrives</p>
    </div>
    <div class="swiper cg-testi-swiper" id="cgTestiSwiper">
      <div class="swiper-wrapper">
        {testimonials.map((item) => (
          <div class="swiper-slide">
            <article class="cg-testi-card">
              <div class="cg-testi-stars">★★★★★</div>
              <p class="cg-testi-quote">"{item.quote}"</p>
              <div class="cg-testi-author">— {item.author}</div>
              <div class="cg-testi-co">{item.company}</div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cg-form-section" id="cgForm">
    <div class="cg-form-left rv-reveal rv-reveal-l">
      <span class="cg-form-left-tag">Corporate Gifting Programme</span>
      <div class="cg-form-left-h">Let's Make Something Extraordinary Together</div>
      <p class="cg-form-left-p">
        Fill in the form and your dedicated account manager will respond with a personalised quote,
        leather swatches, and sample images for your chosen package.
      </p>
      <div class="cg-form-contact-item">
        <div class="cg-form-contact-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
        <div><span class="cg-form-contact-label">Email</span><a class="cg-form-contact-val" href="mailto:corporate@rivavalencia.com">corporate@rivavalencia.com</a></div>
      </div>
      <div class="cg-form-contact-item">
        <div class="cg-form-contact-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7a2 2 0 011.72 2.02z"/></svg></div>
        <div><span class="cg-form-contact-label">Direct Line</span><a class="cg-form-contact-val" href="tel:+919876543210">+91 98765 43210</a></div>
      </div>
      <div class="cg-form-contact-item">
        <div class="cg-form-contact-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
        <div><span class="cg-form-contact-label">Response Time</span><span class="cg-form-contact-val">Within 4 business hours</span></div>
      </div>
      <p class="cg-form-note">All enquiries are handled with complete confidentiality. Our NDA is available on request.</p>
    </div>

    <div class="cg-form-right rv-reveal rv-reveal-r">
      <form class="cg-form" data-cg-form novalidate>
        <div class="cg-form-right-h">Get Your Corporate Quote</div>
        <input type="hidden" name="selectedPackage" data-selected-package value="" />

        <div class="cg-field-row">
          <label class="cg-field">
            <input class="cg-finput" type="text" name="firstName" autocomplete="given-name" required />
            <span class="cg-flabel">First Name</span>
            <span class="cg-fbar"></span>
          </label>
          <label class="cg-field">
            <input class="cg-finput" type="text" name="lastName" autocomplete="family-name" required />
            <span class="cg-flabel">Last Name</span>
            <span class="cg-fbar"></span>
          </label>
        </div>

        <label class="cg-field">
          <input class="cg-finput" type="text" name="company" required />
          <span class="cg-flabel">Company Name</span>
          <span class="cg-fbar"></span>
        </label>

        <div class="cg-field-row">
          <label class="cg-field">
            <input class="cg-finput" type="email" name="email" autocomplete="email" required />
            <span class="cg-flabel">Work Email</span>
            <span class="cg-fbar"></span>
          </label>
          <label class="cg-field">
            <input class="cg-finput" type="tel" name="phone" required />
            <span class="cg-flabel">Phone Number</span>
            <span class="cg-fbar"></span>
          </label>
        </div>

        <div class="cg-field-row">
          <label class="cg-field cg-fselect-wrap">
            <select class="cg-fselect" name="quantity" required>
              <option value="" disabled selected>Quantity Required</option>
              <option>10-24 pieces</option>
              <option>25-49 pieces</option>
              <option>50-99 pieces</option>
              <option>100-249 pieces</option>
              <option>250+ pieces</option>
            </select>
            <span class="cg-fselect-arrow">⌄</span>
          </label>
          <label class="cg-field cg-fselect-wrap">
            <select class="cg-fselect" name="budget" required>
              <option value="" disabled selected>Budget Per Piece</option>
              <option>₹2,000-₹5,000</option>
              <option>₹5,000-₹10,000</option>
              <option>₹10,000-₹20,000</option>
              <option>₹20,000+</option>
              <option>Open to suggestions</option>
            </select>
            <span class="cg-fselect-arrow">⌄</span>
          </label>
        </div>

        <label class="cg-field cg-fselect-wrap">
          <select class="cg-fselect" name="occasion" required>
            <option value="" disabled selected>Gift Occasion</option>
            <option>Diwali / Festival Gifting</option>
            <option>Client Appreciation</option>
            <option>Employee Recognition / Promotion</option>
            <option>Conference / Event Giveaway</option>
            <option>New Year Gifting</option>
            <option>Onboarding / Welcome Kit</option>
            <option>Other</option>
          </select>
          <span class="cg-fselect-arrow">⌄</span>
        </label>

        <label class="cg-field cg-fselect-wrap">
          <select class="cg-fselect" name="package">
            <option value="" selected>Preferred Package</option>
            <option>The Essential</option>
            <option>The Signature</option>
            <option>The Executive</option>
            <option>Custom package</option>
          </select>
          <span class="cg-fselect-arrow">⌄</span>
        </label>

        <label class="cg-field">
          <textarea class="cg-ftarea" name="message" rows="3"></textarea>
          <span class="cg-flabel">Additional Notes</span>
          <span class="cg-fbar"></span>
        </label>

        <button type="submit" class="cg-submit" data-cg-submit>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Request My Corporate Quote
        </button>
        <p class="cg-form-fnote" data-cg-form-note>We respond within 4 business hours. All enquiries are strictly confidential.</p>
      </form>

      <div class="cg-success" data-cg-success hidden>
        <div class="cg-success-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="cg-success-h">Enquiry Received</div>
        <p class="cg-success-p">
          Thank you. Your reference is <strong data-cg-ref></strong>.
          Your account manager will be in touch within 4 business hours.
        </p>
        <button type="button" class="cg-reset-btn" data-cg-reset>Send Another Enquiry</button>
      </div>
    </div>
  </section>

  <div class="rv-orn rv-reveal"><span>✦</span></div>

  <section class="cg-faq rv-reveal">
    <div class="cg-faq-h">Corporate FAQs</div>
    <p class="cg-faq-sub">Everything you need to know before placing an order</p>

    {[
      ['What is the minimum order quantity?', 'Our minimum order is 10 pieces for the Essential range and 15 pieces for the Executive range. Volume discounts begin at 25 pieces and increase at 50, 100, and 250+.'],
      ['How long does production take?', 'Standard lead time is 14 working days from final approval. For orders above 50 pieces, we can discuss an express review timeline.'],
      ['Can we see a sample before placing the full order?', 'Yes. For orders above 25 pieces, we can prepare a pre-production sample or detailed digital mockup before full production begins.'],
      ['Do you deliver directly to individual recipients?', 'Yes. We can deliver each gift individually to recipient addresses or consolidate the full order to one office address.'],
      ['Can you add our company logo to the pieces?', 'Yes. We offer elegant blind embossing and foil stamping options depending on the leather and package selected.'],
