---
import { ProductGrid } from '@/components/ProductGrid';
import type { ShopifyProduct } from '@/lib/shopify';

interface Props {
  inspirations: ShopifyProduct[];
}

const { inspirations = [] } = Astro.props;
const inspirationProducts = inspirations.slice(0, 8);

const bespokeHeroImage =
  'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_l3aygvl3aygvl3ay.png?v=1776018031';
const bespokeAtelierImage =
  'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_24c88824c88824c8.png?v=1776175775';
const bespokeVideoUrl =
  'https://cdn.shopify.com/videos/c/o/v/6b863cf816834b5ca830823360449c38.mp4';
const workshopImage =
  inspirationProducts[2]?.images.edges[0]?.node.url ||
  'https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=1200&q=80';
---

<div class="bs-page" data-bespoke-root>
  <section class="bp-hero">
    <img class="bp-hero-bg" src={bespokeHeroImage} alt="Bespoke commission" loading="eager" />
    <div class="bp-hero-overlay"></div>
    <div class="bp-hero-content">
      <span class="bp-hero-eyebrow">Bespoke Commission · Diseñado en España</span>
      <span class="bp-hero-title">Bespoke</span>
      <span class="bp-hero-subtitle">Solo para usted.</span>
      <p class="bp-hero-copy">
        We accept twelve bespoke commissions each month. Each piece is made from scratch:
        your leather, your colour, your hardware.
      </p>
      <div class="bp-hero-btns">
        <a href="#configurator" class="bp-btn-primary">Configure Your Piece</a>
        <a href="#process" class="bp-btn-outline">How It Works</a>
      </div>
    </div>
  </section>

  <section class="bp-what">
    <div class="bp-what-img">
      <div class="bp-what-img-ph">
        <img src={bespokeAtelierImage} alt="Bespoke atelier" loading="lazy" />
      </div>
    </div>
    <div class="bp-what-text bp-reveal-r">
      <span class="bp-eyebrow">What Is Bespoke</span>
      <span class="bp-what-quote">"Not a product. A creation."</span>
      <p>
        The word bespoke comes from the old English "bespeak": to speak for something.
        At Riva Valencia, a bespoke commission begins as nothing and becomes something made only for you.
      </p>
      <p>
        Your leather. Your colour. Your hardware. Your monogram. Crafted by a single
        named artisan from our Valencia workshop.
      </p>
      <a href="#configurator" class="bp-btn-primary bp-inline-btn">Begin Your Commission</a>
    </div>
  </section>

  <section class="bp-stats">
    <div class="bp-stat bp-reveal">
      <span class="bp-stat-number">12</span>
      <span class="bp-stat-label">Commissions Per Month</span>
    </div>
    <div class="bp-stat bp-reveal bp-d1">
      <span class="bp-stat-number">3</span>
      <span class="bp-stat-label">Named Artisan</span>
    </div>
    <div class="bp-stat bp-reveal bp-d2">
      <span class="bp-stat-number">∞</span>
      <span class="bp-stat-label">Configurations</span>
    </div>
  </section>

  <section class="bp-process" id="process">
    <div class="bp-process-head bp-reveal">
      <span class="bp-eyebrow">The Process</span>
      <span class="bp-section-title">How it works.</span>
    </div>
    <div class="bp-steps">
      <div class="bp-step bp-reveal">
        <span class="bp-step-num">01</span>
        <span class="bp-step-title">Submit Your Brief</span>
        <p class="bp-step-body">
          Choose your product type, leather colour, hardware finish and personal requirements using our configurator below.
        </p>
        <span class="bp-step-cta">→ Takes 5 minutes</span>
      </div>
      <div class="bp-step bp-reveal bp-d1">
        <span class="bp-step-num">02</span>
        <span class="bp-step-title">Design Consultation</span>
        <p class="bp-step-body">
          Our design team contacts you within 48 hours to finalize every detail. Your named artisan is assigned at this stage.
        </p>
        <span class="bp-step-cta">→ Within 48 hours</span>
      </div>
      <div class="bp-step bp-reveal bp-d2">
        <span class="bp-step-num">03</span>
        <span class="bp-step-title">Crafting & Delivery</span>
        <p class="bp-step-body">
          Your artisan crafts your piece by hand. You receive progress updates and your finished piece arrives within 4-6 weeks.
        </p>
        <span class="bp-step-cta">→ 4-6 weeks</span>
      </div>
    </div>
  </section>

  <div class="bp-video-break">
    <video autoplay muted loop playsinline>
      <source src={bespokeVideoUrl} type="video/mp4" />
    </video>
    <div class="bp-video-break-ph"></div>
    <div class="bp-video-break-overlay">
      <span class="bp-video-quote">"Every stitch is an intention. Every piece, a promise."</span>
      <span class="bp-video-attr">— Riva Valencia Atelier, Valencia</span>
    </div>
  </div>

  <section class="bs-studio bp-config-section" id="configurator">
    <div class="bs-studio-head bp-config-head bp-reveal">
      <span class="bp-eyebrow">The Configurator</span>
      <h2 class="bp-section-title">Design your piece.</h2>
    </div>

    <form class="bs-builder" data-bespoke-form novalidate>
      <div class="bs-config">
        <section class="bs-panel rv-reveal">
          <div class="bs-step-head">
            <span>01</span>
            <h3>Product Type</h3>
          </div>
          <div class="bs-choice-grid">
            <button type="button" class="bs-choice active" data-bs-option data-group="silhouette" data-value="Tote Bag" data-price="55000" data-days="34">
              <span>Tote Bag</span>
              <small>Rs. 55,000</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="silhouette" data-value="Satchel" data-price="49000" data-days="32">
              <span>Satchel</span>
              <small>Rs. 49,000</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="silhouette" data-value="Shoulder Bag" data-price="42000" data-days="30">
              <span>Shoulder Bag</span>
              <small>Rs. 42,000</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="silhouette" data-value="Wallet" data-price="18000" data-days="21">
              <span>Wallet</span>
              <small>Rs. 18,000</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="silhouette" data-value="Belt" data-price="12000" data-days="21">
              <span>Belt</span>
              <small>Rs. 12,000</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="silhouette" data-value="Backpack" data-price="62000" data-days="38">
              <span>Backpack</span>
              <small>Rs. 62,000</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="silhouette" data-value="Briefcase" data-price="72000" data-days="42">
              <span>Briefcase</span>
              <small>Rs. 72,000</small>
            </button>
          </div>
        </section>

        <section class="bs-panel rv-reveal">
          <div class="bs-step-head">
            <span>02</span>
            <h3>Leather</h3>
          </div>
          <div class="bs-choice-grid">
            <button type="button" class="bs-choice active" data-bs-option data-group="leather" data-value="Full-grain calf" data-price="0" data-days="0">
              <span>Full-grain calf</span>
              <small>Included</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="leather" data-value="Vegetable tanned" data-price="1800" data-days="5">
              <span>Vegetable tanned</span>
              <small>+ Rs. 1,800</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="leather" data-value="Suede lined" data-price="1200" data-days="3">
              <span>Suede lined</span>
              <small>+ Rs. 1,200</small>
            </button>
            <button type="button" class="bs-choice" data-bs-option data-group="leather" data-value="Croc embossed" data-price="3200" data-days="8">
              <span>Croc embossed</span>
              <small>+ Rs. 3,200</small>
            </button>
          </div>
        </section>

        <section class="bs-panel rv-reveal">
          <div class="bs-step-head">
            <span>03</span>
            <h3>Colour</h3>
          </div>
          <div class="bs-swatch-row" aria-label="Choose colour">
            <button type="button" class="bs-swatch active" data-bs-option data-group="colour" data-value="Cognac Tan" data-price="0" data-color="#b87943" style="--sw:#b87943" title="Cognac Tan"></button>
            <button type="button" class="bs-swatch" data-bs-option data-group="colour" data-value="Noir Black" data-price="0" data-color="#14110f" style="--sw:#14110f" title="Noir Black"></button>
            <button type="button" class="bs-swatch" data-bs-option data-group="colour" data-value="Bordeaux" data-price="650" data-color="#7f2d24" style="--sw:#7f2d24" title="Bordeaux"></button>
            <button type="button" class="bs-swatch" data-bs-option data-group="colour" data-value="Forest" data-price="650" data-color="#254136" style="--sw:#254136" title="Forest"></button>
            <button type="button" class="bs-swatch" data-bs-option data-group="colour" data-value="Sand" data-price="450" data-color="#d7c9b3" style="--sw:#d7c9b3" title="Sand"></button>
            <button type="button" class="bs-swatch" data-bs-option data-group="colour" data-value="Navy" data-price="650" data-color="#1f2b43" style="--sw:#1f2b43" title="Navy"></button>
          </div>
          <span class="bs-colour-label" data-colour-label>Cognac Tan</span>
        </section>

        <section class="bs-panel rv-reveal">
          <div class="bs-step-head">
            <span>04</span>
            <h3>Hardware</h3>
          </div>
          <div class="bs-pill-row">
            <button type="button" class="bs-pill active" data-bs-option data-group="hardware" data-value="Brushed Brass" data-price="0" data-metal="#c9a96e">Brushed Brass</button>
            <button type="button" class="bs-pill" data-bs-option data-group="hardware" data-value="Palladium" data-price="600" data-metal="#b9bdc2">Palladium</button>
            <button type="button" class="bs-pill" data-bs-option data-group="hardware" data-value="Antique Bronze" data-price="750" data-metal="#76583f">Antique Bronze</button>
            <button type="button" class="bs-pill" data-bs-option data-group="hardware" data-value="Matte Black" data-price="900" data-metal="#171717">Matte Black</button>
          </div>
        </section>

        <section class="bs-panel rv-reveal">
          <div class="bs-step-head">
            <span>05</span>
            <h3>Personal Finish</h3>
          </div>
          <div class="bs-addon-grid">
            <label class="bs-addon">
              <input type="checkbox" data-addon data-addon-label="Monogram" data-price="750" data-days="1" />
              <span>Monogram</span>
              <small>+ Rs. 750</small>
            </label>
            <label class="bs-addon">
              <input type="checkbox" data-addon data-addon-label="Contrast Stitch" data-price="550" data-days="2" />
              <span>Contrast Stitch</span>
              <small>+ Rs. 550</small>
            </label>
            <label class="bs-addon">
              <input type="checkbox" data-addon data-addon-label="Signature Gift Box" data-price="450" data-days="0" />
              <span>Signature Gift Box</span>
              <small>+ Rs. 450</small>
            </label>
            <label class="bs-addon">
              <input type="checkbox" data-addon data-addon-label="Express Atelier Review" data-price="1500" data-days="-5" />
              <span>Express Review</span>
              <small>+ Rs. 1,500</small>
            </label>
          </div>
          <div class="bs-field-row">
            <label class="bs-field">
              <span>Monogram Text</span>
              <input type="text" name="monogram" data-monogram maxlength="6" placeholder="RV" />
            </label>
          </div>
        </section>

        <section class="bs-panel rv-reveal">
          <div class="bs-step-head">
            <span>06</span>
            <h3>Consultation</h3>
          </div>
          <div class="bs-field-grid">
            <label class="bs-field">
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>
            <label class="bs-field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label class="bs-field">
              <span>Phone</span>
              <input type="tel" name="phone" autocomplete="tel" required />
            </label>
            <label class="bs-field">
              <span>City</span>
              <input type="text" name="city" autocomplete="address-level2" required />
            </label>
            <label class="bs-field">
              <span>Preferred Date</span>
              <input type="date" name="date" data-date-input required />
            </label>
            <label class="bs-field">
              <span>Consultation Type</span>
              <select name="consultation" required>
                <option value="Video consultation">Video consultation</option>
                <option value="In-store appointment">In-store appointment</option>
                <option value="Phone call">Phone call</option>
              </select>
            </label>
          </div>
          <label class="bs-field bs-field-wide">
            <span>Design Notes</span>
            <textarea name="notes" rows="4" placeholder="Tell us about size needs, laptop fit, travel use, gifting, or styling references."></textarea>
          </label>
          <label class="bs-upload">
            <input type="file" data-reference-files multiple accept="image/*,.pdf" />
            <span>Attach references</span>
            <small data-file-list>No files selected</small>
          </label>
        </section>
      </div>

      <aside class="bs-summary rv-reveal" aria-label="Bespoke summary">
        <div class="bs-preview">
          <div class="bs-bag" data-preview-bag data-product-type="tote-bag">
            <span class="bs-bag-handle" data-preview-metal></span>
            <span class="bs-bag-body" data-preview-body></span>
            <span class="bs-bag-mark" data-preview-monogram>RV</span>
          </div>
        </div>

        <span class="bs-summary-kicker">Current Brief</span>
        <h3 data-summary-title>Tote Bag in Cognac Tan</h3>

        <div class="bs-summary-lines">
          <p><span>Product Type</span><strong data-summary-silhouette>Tote Bag</strong></p>
          <p><span>Leather</span><strong data-summary-leather>Full-grain calf</strong></p>
          <p><span>Colour</span><strong data-summary-colour>Cognac Tan</strong></p>
          <p><span>Hardware</span><strong data-summary-hardware>Brushed Brass</strong></p>
          <p><span>Finish</span><strong data-summary-addons>None selected</strong></p>
        </div>

        <div class="bs-estimate">
          <span>Estimated From</span>
          <strong data-summary-price>Rs. 55,000</strong>
          <small data-summary-timeline>Production estimate: 34-41 days</small>
        </div>

        <div class="bs-summary-actions">
          <button type="submit" class="bs-btn bs-btn-dark">Request Consultation</button>
          <button type="button" class="bs-reset" data-reset-builder>Reset Studio</button>
        </div>
        <span class="bs-status" data-builder-status aria-live="polite"></span>
      </aside>
    </form>
  </section>

  {inspirationProducts.length > 0 && (
    <section class="bs-inspiration" id="bs-inspiration">
      <div class="bs-section-head rv-reveal">
        <span class="bs-kicker">Shopify Catalogue</span>
        <h2>Inspiration From Ready-to-Wear</h2>
        <p>Use these pieces as references for proportion, colour and carry style.</p>
      </div>
      <ProductGrid products={inspirationProducts} client:load />
    </section>
  )}

  <section class="bs-workshop">
    <img src={workshopImage} alt="Riva Valencia bespoke workshop mood" loading="lazy" />
    <div class="bs-workshop-copy rv-reveal">
      <span class="bs-kicker">Private Atelier</span>
      <h2>Bring references, measurements and routines.</h2>
      <p>
        The best bespoke pieces start with ordinary details: what you carry daily,
        how you travel, where the bag rests, and which finish feels like yours.
      </p>
      <button type="button" class="bs-btn bs-btn-light" data-scroll-target="#configurator">Refine My Brief</button>
    </div>
  </section>

  <section class="bs-faq">
    <div class="bs-section-head rv-reveal">
      <span class="bs-kicker">Atelier Notes</span>
      <h2>Bespoke FAQ</h2>
    </div>
    <div class="bs-faq-list">
      <article class="bs-faq-item rv-reveal">
        <button type="button" data-bs-faq>Can I change the design after submitting?<span></span></button>
        <div>
          <p>Yes. The first atelier review is a consultation request, not a final order. The design is confirmed only after review and approval.</p>
        </div>
      </article>
      <article class="bs-faq-item rv-reveal">
        <button type="button" data-bs-faq>How accurate is the estimate?<span></span></button>
        <div>
          <p>The estimator gives a starting point based on selected materials and services. Final pricing is confirmed after leather availability and measurements are reviewed.</p>
        </div>
      </article>
      <article class="bs-faq-item rv-reveal">
        <button type="button" data-bs-faq>Where is my draft saved?<span></span></button>
        <div>
          <p>Drafts and submitted inquiry summaries are saved in this browser using local storage so the page remains functional without a backend endpoint.</p>
        </div>
      </article>
    </div>
  </section>

  <div class="bs-modal" data-bespoke-modal hidden>
    <div class="bs-modal-backdrop" data-modal-close></div>
    <section class="bs-modal-panel" role="dialog" aria-modal="true" aria-labelledby="bs-modal-title">
      <button type="button" class="bs-modal-x" data-modal-close aria-label="Close bespoke inquiry">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <span class="bs-kicker">Inquiry Saved</span>
      <h2 id="bs-modal-title">Your bespoke brief is ready.</h2>
      <p data-modal-summary></p>
      <div class="bs-modal-id">
        <span>Reference</span>
        <strong data-inquiry-id>RV-BS</strong>
      </div>
      <div class="bs-modal-actions">
        <button type="button" class="bs-btn bs-btn-dark" data-copy-inquiry>Copy Reference</button>
        <button type="button" class="bs-btn bs-btn-outline" data-modal-close>Continue Editing</button>
      </div>
      <span class="bs-status" data-modal-status aria-live="polite"></span>
    </section>
  </div>
</div>

<style>
  .bs-page{
    --bs-bg:#f4efe2;
    --bs-bg-elevated:#fbf7ef;
    --bs-surface:#fffaf0;
    --bs-surface-muted:#efe6d5;
    --bs-surface-strong:#111111;
    --bs-text:#100d08;
    --bs-text-soft:#3e3120;
    --bs-text-muted:#5f4b33;
    --bs-border:#b8a48a;
    --bs-border-soft:#d4c7b3;
    --bs-accent:#f2b544;
    --bs-accent-strong:#cb8a14;
    --bs-accent-ink:#120d06;
    --bs-success:#235937;
    --bs-error:#8b2f1b;
    background:var(--bs-bg);
    color:var(--bs-text);
  }
  .bp-reveal{opacity:0;transform:translateY(48px);transition:opacity 0.9s ease,transform 0.9s cubic-bezier(0.16,1,0.3,1)}
  .bp-reveal.in{opacity:1;transform:translateY(0)}
  .bp-reveal-l{opacity:0;transform:translateX(-48px);transition:opacity 0.9s ease,transform 0.9s cubic-bezier(0.16,1,0.3,1)}
  .bp-reveal-l.in{opacity:1;transform:translateX(0)}
  .bp-reveal-r{opacity:0;transform:translateX(48px);transition:opacity 0.9s ease,transform 0.9s cubic-bezier(0.16,1,0.3,1)}
  .bp-reveal-r.in{opacity:1;transform:translateX(0)}
  .bp-d1{transition-delay:0.1s}
  .bp-d2{transition-delay:0.2s}
  .bp-d3{transition-delay:0.3s}
  .bp-marquee{background:#000;color:#fff;padding:12px 0;font-size:10px;letter-spacing:0.28em;text-transform:uppercase;overflow:hidden;white-space:nowrap}
  .bp-marquee-track{display:inline-flex;gap:60px;animation:bpMarquee 30s linear infinite}
  @keyframes bpMarquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
  .bp-hero{position:relative;width:100%;height:92vh;overflow:hidden;background:var(--bs-surface-strong);display:flex;align-items:center;justify-content:center}
  .bp-hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.55;animation:bpHeroZoom 20s ease infinite alternate}
  @keyframes bpHeroZoom{from{transform:scale(1)}to{transform:scale(1.08)}}
  .bp-hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0.28) 0%,rgba(0,0,0,0.84) 100%)}
  .bp-hero-content{position:relative;z-index:2;text-align:center;color:#fff;padding:0 40px;animation:bpFadeUp 1.2s cubic-bezier(0.16,1,0.3,1) 0.3s both}
  @keyframes bpFadeUp{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:translateY(0)}}
  .bp-hero-eyebrow{font-size:9px;letter-spacing:0.4em;text-transform:uppercase;color:rgba(255,244,224,0.84);display:block;margin-bottom:18px;font-weight:500}
  .bp-hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,10vw,130px);letter-spacing:0.06em;line-height:0.88;display:block;margin-bottom:8px}
  .bp-hero-subtitle{font-family:'Cormorant Garamond',serif;font-size:clamp(16px,2vw,26px);font-weight:300;letter-spacing:0.1em;color:rgba(255,248,238,0.92);display:block;margin-bottom:48px}
  .bp-hero-copy{font-family:'Cormorant Garamond',serif;font-size:clamp(13px,1.4vw,17px);font-weight:300;color:rgba(255,247,233,0.9);max-width:560px;margin:0 auto 44px;line-height:1.75;letter-spacing:0.04em}
  .bp-hero-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  .bp-btn-primary{display:inline-flex;align-items:center;justify-content:center;background:var(--bs-accent);color:var(--bs-accent-ink);font-size:9px;letter-spacing:0.32em;text-transform:uppercase;font-weight:700;padding:16px 48px;border:none;cursor:pointer;font-family:'Jost',sans-serif;transition:background 0.3s,transform 0.3s;min-height:48px}
  .bp-btn-primary:hover{background:#ffd07a;transform:translateY(-2px)}
  .bp-btn-outline{display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.03);color:#fff;font-size:9px;letter-spacing:0.32em;text-transform:uppercase;font-weight:500;padding:16px 48px;border:1px solid rgba(255,255,255,0.75);cursor:pointer;font-family:'Jost',sans-serif;transition:background 0.3s,border-color 0.3s,color 0.3s;min-height:48px}
  .bp-btn-outline:hover{background:#fff;border-color:#fff;color:#000}
