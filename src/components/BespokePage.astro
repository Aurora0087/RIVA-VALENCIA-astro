  .bs-modal-panel{position:relative;background:var(--bs-bg-elevated);width:min(560px,100%);padding:38px;border:1px solid var(--bs-border);box-shadow:0 30px 90px rgba(0,0,0,0.34)}
  .bs-modal-x{position:absolute;top:18px;right:18px;border:none;background:transparent;color:var(--bs-text);padding:5px}
  .bs-modal-id{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--bs-border-soft);border-bottom:1px solid var(--bs-border-soft);padding:14px 0;margin:20px 0}
  .bs-modal-id span{font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--bs-text-muted)}
  .bs-modal-id strong{font-size:14px;letter-spacing:0.16em}
  @media(max-width:1100px){
    .bs-builder{grid-template-columns:1fr}
