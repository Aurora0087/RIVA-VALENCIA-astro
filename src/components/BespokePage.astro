    .bs-hero-meta{left:20px;right:20px;overflow-x:auto}
    .bs-intro,.bs-story{grid-template-columns:1fr;gap:28px}
    .bs-story-img{height:420px}
    .bs-story-copy{padding:40px 20px}
    .bs-process{grid-template-columns:1fr}
    .bs-process-item{border-right:none;border-bottom:1px solid var(--bs-border-soft);padding:32px 20px}
    .bs-choice-grid,.bs-addon-grid,.bs-field-grid{grid-template-columns:1fr}
    .bp-hero{height:82vh;min-height:640px}
    .bp-hero-content{padding:0 20px}
    .bp-what{grid-template-columns:1fr}
    .bp-what-text{padding:52px 28px}
    .bp-stats{grid-template-columns:1fr}
    .bp-stat{border-right:none;border-bottom:1px solid rgba(255,255,255,0.07)}
    .bp-process{padding:64px 20px}
    .bs-studio.bp-config-section{padding:64px 20px 80px}
    .bp-video-break{height:60vh}
  }
  @media(max-width:520px){
    .bs-hero-actions,.bs-modal-actions{flex-direction:column;align-items:stretch}
    .bs-btn{width:100%}
    .bs-panel,.bs-summary,.bs-modal-panel{padding:22px}
    .bs-upload{align-items:flex-start;flex-direction:column}
    .bs-upload small{text-align:left}
    .bp-hero-btns{flex-direction:column;align-items:stretch}
    .bp-btn-primary,.bp-btn-outline{width:100%;padding-left:20px;padding-right:20px}
    .bp-what-img-ph{min-height:420px}
  }
</style>

<script is:inline>
  (function() {
    var root = document.querySelector('[data-bespoke-root]');
    if (!root) return;

    var DRAFT_KEY = 'rv-bespoke-draft-v1';
    var INQUIRY_KEY = 'rv-bespoke-inquiries-v1';
    var form = root.querySelector('[data-bespoke-form]');
    var status = root.querySelector('[data-builder-status]');
    var modal = root.querySelector('[data-bespoke-modal]');
    var modalSummary = root.querySelector('[data-modal-summary]');
    var modalId = root.querySelector('[data-inquiry-id]');
    var modalStatus = root.querySelector('[data-modal-status]');
    var fileInput = root.querySelector('[data-reference-files]');
    var fileList = root.querySelector('[data-file-list]');
    var monogramInput = root.querySelector('[data-monogram]');
    var monogramAddon = root.querySelector('[data-addon-label="Monogram"]');
    var dateInput = root.querySelector('[data-date-input]');

    var revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });

    root.querySelectorAll('.bp-reveal,.bp-reveal-l,.bp-reveal-r').forEach(function(el) {
      revealObserver.observe(el);
    });

    function formatMoney(value) {
      return 'Rs. ' + Math.max(0, Math.round(value)).toLocaleString('en-IN');
    }

    function formatBriefDate(value) {
      if (!value) return 'Not provided';
      var parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) return value;
      return parsed.toLocaleDateString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
      });
    }

    function formatBriefDateTime(value) {
      var parsed = value ? new Date(value) : new Date();
      if (Number.isNaN(parsed.getTime())) parsed = new Date();
      return parsed.toLocaleString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    }

    function pdfSafeText(value) {
      return String(value || '')
        .replace(/[\u2018\u2019]/g, "'")
        .replace(/[\u201C\u201D]/g, '"')
        .replace(/[\u2013\u2014]/g, '-')
        .replace(/\u2026/g, '...')
        .normalize('NFKD')
        .replace(/[^\x20-\x7E\n]/g, '');
    }

    function wrapPdfText(value, maxChars) {
      var safeText = pdfSafeText(value);
      if (!safeText) return [''];

      return safeText.split(/\r?\n/).reduce(function(lines, paragraph) {
        var words = paragraph.trim().split(/\s+/).filter(Boolean);
        if (!words.length) {
          lines.push('');
          return lines;
        }

        var current = '';
        words.forEach(function(word) {
          var next = current ? current + ' ' + word : word;
          if (next.length <= maxChars) {
            current = next;
            return;
          }
          if (current) lines.push(current);
          current = word;
        });

        if (current) lines.push(current);
        return lines;
      }, []);
    }

    function pdfEscape(value) {
      return String(value || '')
        .replace(/\\/g, '\\\\')
        .replace(/\(/g, '\\(')
        .replace(/\)/g, '\\)');
    }

    function createPdfBlob(lines) {
      var pageHeight = 842;
      var topMargin = 52;
      var bottomMargin = 52;
      var lineHeight = 16;
      var linesPerPage = Math.floor((pageHeight - topMargin - bottomMargin) / lineHeight);
      var pages = [];

      for (var i = 0; i < lines.length; i += linesPerPage) {
        pages.push(lines.slice(i, i + linesPerPage));
      }

      var objects = [];

      function addObject(body) {
        objects.push(body);
        return objects.length;
      }

      var fontId = addObject('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>');
      var contentIds = pages.map(function(pageLines) {
        var streamLines = ['BT', '/F1 11 Tf', '50 790 Td', lineHeight + ' TL'];
        pageLines.forEach(function(line, index) {
          streamLines.push('(' + pdfEscape(line || ' ') + ') Tj');
          if (index < pageLines.length - 1) streamLines.push('T*');
        });
        streamLines.push('ET');
        var stream = streamLines.join('\n');
        return addObject('<< /Length ' + stream.length + ' >>\nstream\n' + stream + '\nendstream');
      });

      var pagesId = objects.length + 1;
      var pageIds = pages.map(function(_, index) {
        return pagesId + 1 + index;
      });

      addObject('<< /Type /Pages /Count ' + pages.length + ' /Kids [' + pageIds.map(function(id) {
        return id + ' 0 R';
      }).join(' ') + '] >>');

      pages.forEach(function(_, index) {
        addObject(
          '<< /Type /Page /Parent ' + pagesId + ' 0 R /MediaBox [0 0 595 842] ' +
          '/Resources << /Font << /F1 ' + fontId + ' 0 R >> >> ' +
          '/Contents ' + contentIds[index] + ' 0 R >>'
        );
      });

      var catalogId = addObject('<< /Type /Catalog /Pages ' + pagesId + ' 0 R >>');
      var pdf = '%PDF-1.4\n';
      var offsets = [0];

      objects.forEach(function(body, index) {
        offsets[index + 1] = pdf.length;
        pdf += (index + 1) + ' 0 obj\n' + body + '\nendobj\n';
      });

      var xrefOffset = pdf.length;
      pdf += 'xref\n0 ' + (objects.length + 1) + '\n';
      pdf += '0000000000 65535 f \n';
      for (var objectIndex = 1; objectIndex <= objects.length; objectIndex += 1) {
        pdf += String(offsets[objectIndex]).padStart(10, '0') + ' 00000 n \n';
      }
      pdf += 'trailer\n<< /Size ' + (objects.length + 1) + ' /Root ' + catalogId + ' 0 R >>\n';
      pdf += 'startxref\n' + xrefOffset + '\n%%EOF';

      return new Blob([pdf], { type: 'application/pdf' });
    }

    function downloadBlob(blob, filename) {
      var url = URL.createObjectURL(blob);
      var link = document.createElement('a');
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(function() {
        URL.revokeObjectURL(url);
      }, 250);
    }

    function briefPdfLines(brief) {
      var addonText = brief.addons.length
        ? brief.addons.map(function(item) { return item.label; }).join(', ')
        : 'None selected';
      var referencesText = brief.references.length
        ? brief.references.join(', ')
        : 'No reference files attached';
      var notesText = brief.fields.notes || 'No additional notes provided.';
      var lines = [
        'Riva Valencia Bespoke Brief',
        'Generated: ' + formatBriefDateTime(brief.savedAt),
        '',
        'CONFIGURATION',
        'Product type: ' + brief.silhouette,
        'Leather: ' + brief.leather,
        'Colour: ' + brief.colour,
        'Hardware: ' + brief.hardware,
        'Personal finish: ' + addonText,
        'Monogram: ' + (brief.fields.monogram || 'Not provided'),
        'Estimated price: ' + formatMoney(brief.estimate),
        'Production estimate: ' + brief.days + '-' + (brief.days + 7) + ' days',
        '',
        'CONSULTATION',
        'Name: ' + (brief.fields.name || 'Not provided'),
        'Email: ' + (brief.fields.email || 'Not provided'),
        'Phone: ' + (brief.fields.phone || 'Not provided'),
        'City: ' + (brief.fields.city || 'Not provided'),
        'Preferred date: ' + formatBriefDate(brief.fields.date),
        'Consultation type: ' + (brief.fields.consultation || 'Not provided'),
        '',
        'DESIGN NOTES',
      ];

      lines = lines.concat(wrapPdfText(notesText, 72));
      lines.push('');
      lines.push('REFERENCE FILES');
      lines = lines.concat(wrapPdfText(referencesText, 72));
      lines.push('');
      lines.push('Prepared from the bespoke configurator on the Riva Valencia website.');

      return lines;
    }

    function briefFileName(brief) {
      var name = pdfSafeText(brief.fields.name || 'client')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || 'client';
      var piece = pdfSafeText(brief.silhouette || 'bespoke-piece')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || 'bespoke-piece';
      return 'riva-bespoke-brief-' + name + '-' + piece + '.pdf';
    }

    function setStatus(message, isError) {
      if (!status) return;
      status.textContent = message || '';
      status.style.color = isError
        ? 'var(--bs-error)'
        : 'var(--bs-success)';
    }

    function productTypeSlug(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    }

    function getSelected(group) {
      return root.querySelector('[data-bs-option][data-group="' + group + '"].active');
    }

    function getAddons() {
      return Array.from(root.querySelectorAll('[data-addon]:checked')).map(function(input) {
        return {
          label: input.dataset.addonLabel,
          price: Number(input.dataset.price || 0),
          days: Number(input.dataset.days || 0),
        };
      });
    }

    function getFields() {
      var data = new FormData(form);
      return {
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        phone: String(data.get('phone') || '').trim(),
        city: String(data.get('city') || '').trim(),
        date: String(data.get('date') || '').trim(),
        consultation: String(data.get('consultation') || '').trim(),
        notes: String(data.get('notes') || '').trim(),
        monogram: String(data.get('monogram') || '').trim().toUpperCase(),
      };
    }

    function collectBrief() {
      var silhouette = getSelected('silhouette');
      var leather = getSelected('leather');
      var colour = getSelected('colour');
      var hardware = getSelected('hardware');
      var addons = getAddons();
      var fields = getFields();
      var references = fileInput
        ? Array.from(fileInput.files || []).map(function(file) { return file.name; })
        : [];
      var price =
        Number(silhouette.dataset.price || 0) +
        Number(leather.dataset.price || 0) +
        Number(colour.dataset.price || 0) +
        Number(hardware.dataset.price || 0) +
        addons.reduce(function(sum, item) { return sum + item.price; }, 0);
      var days =
        Number(silhouette.dataset.days || 0) +
        Number(leather.dataset.days || 0) +
        addons.reduce(function(sum, item) { return sum + item.days; }, 0);
      days = Math.max(21, days);

      return {
        silhouette: silhouette.dataset.value,
        leather: leather.dataset.value,
        colour: colour.dataset.value,
        colourValue: colour.dataset.color,
        hardware: hardware.dataset.value,
        hardwareValue: hardware.dataset.metal,
        addons: addons,
        estimate: price,
        days: days,
        fields: fields,
        references: references,
        savedAt: new Date().toISOString(),
      };
    }

    function syncMonogramField(options) {
      if (monogramInput) {
        var normalized = monogramInput.value
          .toUpperCase()
          .replace(/[^A-Z0-9]/g, '')
          .slice(0, 6);
        var shouldAutoselect = !!(options && options.autoselect);
        var monogramEnabled = !!(monogramAddon && monogramAddon.checked);

        if (normalized !== monogramInput.value) monogramInput.value = normalized;
        if (shouldAutoselect && normalized && monogramAddon && !monogramEnabled) {
          monogramAddon.checked = true;
          monogramEnabled = true;
        }

        monogramInput.required = monogramEnabled;
        if (!monogramEnabled) monogramInput.value = '';
      }
    }

    function updateSummary(options) {
      syncMonogramField({ autoselect: !!(options && options.autoselectMonogram) });
      var brief = collectBrief();
      var addonText = brief.addons.length
        ? brief.addons.map(function(item) { return item.label; }).join(', ')
        : 'None selected';

      var colourLabel = root.querySelector('[data-colour-label]');
      if (colourLabel) colourLabel.textContent = brief.colour;
      root.querySelector('[data-summary-title]').textContent = brief.silhouette + ' in ' + brief.colour;
      root.querySelector('[data-summary-silhouette]').textContent = brief.silhouette;
      root.querySelector('[data-summary-leather]').textContent = brief.leather;
      root.querySelector('[data-summary-colour]').textContent = brief.colour;
      root.querySelector('[data-summary-hardware]').textContent = brief.hardware;
      root.querySelector('[data-summary-addons]').textContent = addonText;
      root.querySelector('[data-summary-price]').textContent = formatMoney(brief.estimate);
      root.querySelector('[data-summary-timeline]').textContent =
        'Production estimate: ' + brief.days + '-' + (brief.days + 7) + ' days';

      root.querySelector('[data-preview-body]').style.setProperty('--bag', brief.colourValue);
      root.querySelector('[data-preview-metal]').style.setProperty('--metal', brief.hardwareValue);
      root.querySelector('[data-preview-bag]').dataset.productType = productTypeSlug(brief.silhouette);
      var monogram = (brief.fields.monogram || 'RV').slice(0, 6);
      root.querySelector('[data-preview-monogram]').textContent = monogram;

      return brief;
    }

    function selectOption(button) {
      var group = button.dataset.group;
      root.querySelectorAll('[data-bs-option][data-group="' + group + '"]').forEach(function(item) {
        item.classList.remove('active');
      });
      button.classList.add('active');
      setStatus('');
      updateSummary();
    }

    function applyBrief(brief) {
      if (!brief) return;
      ['silhouette', 'leather', 'colour', 'hardware'].forEach(function(group) {
        var value = brief[group];
        if (!value) return;
        var btn = Array.from(root.querySelectorAll('[data-bs-option][data-group="' + group + '"]')).find(function(item) {
          return item.dataset.value === value;
        });
        if (btn) selectOption(btn);
      });

      root.querySelectorAll('[data-addon]').forEach(function(input) {
        input.checked = (brief.addons || []).some(function(addon) {
          return addon.label === input.dataset.addonLabel;
        });
      });

      var fields = brief.fields || {};
      Object.keys(fields).forEach(function(name) {
        var field = form.elements.namedItem(name);
        if (field) field.value = fields[name];
      });
      updateSummary();
    }

    function saveDraft() {
      var brief = updateSummary();
      localStorage.setItem(DRAFT_KEY, JSON.stringify(brief));
      setStatus('Draft saved in this browser.');
    }

    function downloadBrief() {
      var brief = updateSummary();
      var lines = briefPdfLines(brief);
      var blob = createPdfBlob(lines);
      downloadBlob(blob, briefFileName(brief));
      setStatus('Brief downloaded as PDF.');
    }

    function saveInquiry(brief) {
      var id = 'RV-BS-' + Date.now().toString(36).toUpperCase();
      var inquiries = [];
      try {
        inquiries = JSON.parse(localStorage.getItem(INQUIRY_KEY) || '[]');
      } catch (error) {
        inquiries = [];
      }
      inquiries.unshift(Object.assign({ id: id }, brief));
      localStorage.setItem(INQUIRY_KEY, JSON.stringify(inquiries.slice(0, 12)));
      localStorage.setItem(DRAFT_KEY, JSON.stringify(brief));
      return id;
    }

    function showModal(id, brief) {
      modalId.textContent = id;
      modalSummary.textContent =
        brief.fields.name + ', your ' + brief.silhouette + ' brief starts at ' +
        formatMoney(brief.estimate) + ' with a ' + brief.fields.consultation + ' requested for ' +
        brief.fields.date + '.';
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modalStatus.textContent = '';
    }

    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    root.querySelectorAll('[data-scroll-target]').forEach(function(button) {
      button.addEventListener('click', function() {
        var target = document.querySelector(button.dataset.scrollTarget);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    root.querySelectorAll('[data-bs-option]').forEach(function(button) {
      button.addEventListener('click', function() { selectOption(button); });
    });

    root.querySelectorAll('[data-addon]').forEach(function(input) {
      input.addEventListener('change', updateSummary);
    });

    form.addEventListener('input', function(event) {
      updateSummary({
        autoselectMonogram: event.target === monogramInput,
      });
    });
    form.addEventListener('change', updateSummary);

    root.querySelector('[data-save-draft]').addEventListener('click', saveDraft);
    root.querySelector('[data-download-brief]').addEventListener('click', downloadBrief);
    root.querySelector('[data-reset-builder]').addEventListener('click', function() {
      localStorage.removeItem(DRAFT_KEY);
      form.reset();
      root.querySelectorAll('[data-bs-option]').forEach(function(item) { item.classList.remove('active'); });
      ['silhouette', 'leather', 'colour', 'hardware'].forEach(function(group) {
        var first = root.querySelector('[data-bs-option][data-group="' + group + '"]');
        if (first) first.classList.add('active');
      });
      if (fileList) fileList.textContent = 'No files selected';
      setStatus('Studio reset.');
      updateSummary();
    });

    if (fileInput) {
      fileInput.addEventListener('change', function() {
        var names = Array.from(fileInput.files || []).map(function(file) { return file.name; });
        fileList.textContent = names.length ? names.join(', ') : 'No files selected';
        updateSummary();
      });
    }

    root.querySelectorAll('[data-bs-faq]').forEach(function(button) {
      button.addEventListener('click', function() {
        var item = button.closest('.bs-faq-item');
        item.classList.toggle('open');
      });
    });

    form.addEventListener('submit', function(event) {
      event.preventDefault();
      updateSummary();
      if (!form.checkValidity()) {
        form.reportValidity();
        setStatus('Please complete the required consultation details.', true);
        return;
      }
      var brief = collectBrief();
      var id = saveInquiry(brief);
      setStatus('Inquiry saved.');
      showModal(id, brief);
    });

    root.querySelectorAll('[data-modal-close]').forEach(function(button) {
      button.addEventListener('click', closeModal);
    });

    root.querySelector('[data-copy-inquiry]').addEventListener('click', function() {
      var text = modalId.textContent;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(function() {
          modalStatus.textContent = 'Reference copied.';
        });
      } else {
        modalStatus.textContent = text;
      }
    });

    if (dateInput) {
      var tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      dateInput.min = tomorrow.toISOString().slice(0, 10);
    }

    try {
      var saved = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null');
      if (saved) {
        applyBrief(saved);
        setStatus('Draft restored.');
      }
    } catch (error) {
      updateSummary();
    }

    updateSummary();
  })();
</script>
