---
import Layout from '@/layouts/Layout.astro';

const quickLinks = [
  { label: "SS'26", href: '/collections/ss26' },
  { label: 'All Products', href: '/collections/all' },
  { label: 'Limited Edition', href: '/collections/limited-edition' },
  { label: 'Bespoke', href: '/pages/bespoke' },
];
---

<Layout
  title="Page Not Found — RIVA VALENCIA"
  description="The page you were looking for could not be found. Explore the latest collections, limited editions, and bespoke services from Riva Valencia."
>
  <section class="nf-hero">
    <div class="nf-shell">
      <div class="nf-copy">
        <span class="nf-eyebrow">404 · Page Not Found</span>
        <h1>Lost between<br />the atelier and the archive.</h1>
        <p>
          The page you were looking for is no longer here, may have moved,
          or never existed. Let’s bring you back to the collections that are live.
        </p>

        <div class="nf-actions">
          <a href="/" class="nf-btn nf-btn-dark">Back to Home</a>
          <a href="/collections/all" class="nf-btn nf-btn-light">Shop All Products</a>
        </div>
      </div>

      <aside class="nf-card">
        <span class="nf-card-kicker">Explore Instead</span>
        <ul class="nf-links">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href}>
                <span>{link.label}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="nf-note">
          Need help finding a product or page?
          <a href="/pages/contact"> Contact the atelier</a>.
        </div>
      </aside>
    </div>
  </section>

  <section class="nf-strip">
    <div class="nf-strip-inner">
      <span>Designed In Spain</span>
      <span>Full-grain leather</span>
      <span>Secure checkout</span>
      <span>Easy returns</span>
    </div>
  </section>

  <section class="nf-feature">
    <div class="nf-feature-media">
      <img
        src="https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_jvsu4qjvsu4qjvsu.png?v=1776006386"
        alt="Riva Valencia editorial campaign"
        loading="lazy"
      />
    </div>

    <div class="nf-feature-copy">
      <span class="nf-eyebrow">Continue Browsing</span>
      <h2>Discover the pieces people reach for first.</h2>
      <p>
        Explore the current collection, seasonal launches, and bespoke services
        with the same live product cards, wishlist tools, and quick add flow
        used across the storefront.
      </p>
      <div class="nf-feature-actions">
        <a href="/collections/limited-edition" class="nf-text-link">View Limited Edition →</a>
        <a href="/pages/bespoke" class="nf-text-link">Open Bespoke Atelier →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf-hero{
    position:relative;
    overflow:hidden;
    background:
      radial-gradient(circle at top right, rgba(201,169,110,0.18), transparent 28%),
      linear-gradient(135deg, #f7f2ea 0%, #f2ebe2 55%, #ebe3d7 100%);
    padding:72px 48px 64px;
  }
  .nf-shell{
    display:grid;
    grid-template-columns:minmax(0,1.2fr) minmax(300px,0.65fr);
    gap:28px;
    align-items:stretch;
    max-width:1320px;
    margin:0 auto;
  }
  .nf-copy{
    padding:40px 12px 40px 0;
    align-self:center;
  }
  .nf-eyebrow{
    display:block;
    font-size:9px;
    letter-spacing:0.36em;
    text-transform:uppercase;
    color:#9e845d;
    font-weight:600;
    margin-bottom:18px;
  }
  .nf-copy h1,
  .nf-feature-copy h2{
    font-family:'Bebas Neue',sans-serif;
    font-weight:400;
    letter-spacing:0.08em;
    line-height:0.92;
    color:#1a1008;
  }
  .nf-copy h1{
    font-size:clamp(58px,10vw,132px);
    margin-bottom:22px;
  }
  .nf-copy p,
  .nf-feature-copy p{
    max-width:620px;
    font-size:14px;
    line-height:1.9;
    letter-spacing:0.04em;
    color:#5a4a3a;
    font-weight:300;
  }
  .nf-actions{
    display:flex;
    flex-wrap:wrap;
    gap:14px;
    margin-top:30px;
  }
  .nf-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:52px;
    padding:0 30px;
    border:1px solid #1a1008;
    font-size:10px;
    letter-spacing:0.28em;
    text-transform:uppercase;
    font-weight:500;
    transition:transform 0.24s,background 0.24s,color 0.24s,border-color 0.24s;
  }
  .nf-btn:hover{transform:translateY(-2px)}
  .nf-btn-dark{background:#1a1008;color:#fafaf8}
  .nf-btn-dark:hover{background:#2f2011}
  .nf-btn-light{background:transparent;color:#1a1008}
  .nf-btn-light:hover{background:#1a1008;color:#fafaf8}
  .nf-card{
    background:rgba(255,255,255,0.58);
    border:1px solid rgba(26,16,8,0.1);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    padding:30px 28px 26px;
    align-self:center;
  }
  .nf-card-kicker{
    display:block;
    font-size:9px;
    letter-spacing:0.32em;
    text-transform:uppercase;
    color:#9e845d;
    font-weight:600;
    margin-bottom:18px;
  }
  .nf-links{
    list-style:none;
    border-top:1px solid rgba(26,16,8,0.1);
    margin:0;
    padding:0;
  }
  .nf-links li{
    border-bottom:1px solid rgba(26,16,8,0.08);
  }
  .nf-links a{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
    padding:15px 0;
    font-size:13px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:#1a1008;
    transition:color 0.2s,transform 0.2s;
  }
  .nf-links a:hover{
    color:#8a7660;
    transform:translateX(4px);
  }
  .nf-note{
    margin-top:18px;
    font-size:12px;
    line-height:1.8;
    color:#7c6a58;
    letter-spacing:0.04em;
  }
  .nf-note a{
    text-decoration:underline;
    text-underline-offset:0.18em;
  }
  .nf-strip{
    background:#1a1008;
    overflow:hidden;
    border-top:1px solid rgba(201,169,110,0.16);
    border-bottom:1px solid rgba(201,169,110,0.16);
  }
  .nf-strip-inner{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:28px;
    padding:15px 20px;
    font-size:9px;
    letter-spacing:0.3em;
    text-transform:uppercase;
    color:#e7d8bd;
  }
  .nf-feature{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,0.92fr);
    gap:3px;
    align-items:stretch;
    padding:72px 48px 92px;
    background:#fafaf8;
  }
  .nf-feature-media{
    min-width:0;
    overflow:hidden;
    background:#ede7de;
  }
  .nf-feature-media img{
    width:100%;
    height:100%;
    min-height:520px;
    object-fit:cover;
    display:block;
    transition:transform 8s ease;
  }
  .nf-feature:hover .nf-feature-media img{transform:scale(1.04)}
  .nf-feature-copy{
    background:#f5f2ec;
    padding:72px 64px;
    display:flex;
    flex-direction:column;
    justify-content:center;
  }
  .nf-feature-copy h2{
    font-size:clamp(40px,5vw,72px);
    margin-bottom:18px;
  }
  .nf-feature-actions{
    display:flex;
    flex-direction:column;
    gap:14px;
    margin-top:26px;
  }
  .nf-text-link{
    display:inline-flex;
    align-items:center;
    gap:10px;
    align-self:flex-start;
    font-size:10px;
    letter-spacing:0.24em;
    text-transform:uppercase;
    color:#1a1008;
    border-bottom:1px solid #c9a96e;
    padding-bottom:4px;
    transition:gap 0.24s,color 0.24s;
  }
  .nf-text-link:hover{
    gap:14px;
    color:#8a7660;
  }

  @media (max-width: 1100px){
    .nf-shell,
    .nf-feature{
      grid-template-columns:1fr;
    }
    .nf-copy{
      padding-right:0;
    }
  }
  @media (max-width: 820px){
    .nf-hero,
    .nf-feature{
      padding-left:20px;
      padding-right:20px;
    }
    .nf-hero{
      padding-top:56px;
      padding-bottom:48px;
    }
    .nf-feature{
      padding-top:52px;
      padding-bottom:72px;
    }
    .nf-feature-copy{
      padding:48px 28px;
    }
    .nf-feature-media img{
      min-height:360px;
    }
  }
  @media (max-width: 520px){
    .nf-actions{
      flex-direction:column;
    }
    .nf-btn{
      width:100%;
    }
    .nf-card{
      padding:24px 20px 22px;
    }
  }
</style>
