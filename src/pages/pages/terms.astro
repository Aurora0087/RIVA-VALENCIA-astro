---
import LegalPage from '@/components/LegalPage.astro';
import Layout from '@/layouts/Layout.astro';

const sections = [
  {
    heading: 'Using the Website',
    body: [
      'These Terms and Conditions govern access to and use of the Riva Valencia website, content, services and digital features.',
      'By continuing to browse or use the website, you agree to act lawfully, respect the intellectual property presented here and avoid interfering with the operation of the site.',
    ],
  },
  {
    heading: 'Content and Accuracy',
    body: [
      'We work to keep product information, imagery, editorial material and availability details current, but some information may change or contain occasional inaccuracies.',
      'Visuals may vary slightly from the delivered item due to lighting, screen calibration, hand-finishing and natural material variation.',
    ],
  },
  {
    heading: 'Accounts and Security',
    body: [
      'If you create an account, you are responsible for maintaining the confidentiality of your sign-in information and for activity under your account.',
      'Please notify us promptly if you believe your account has been accessed without authorization.',
    ],
  },
  {
    heading: 'Intellectual Property',
    body: [
      'All trademarks, logos, product photography, text, design assets and website materials remain the property of Riva Valencia or its licensors unless stated otherwise.',
      'You may not reproduce, distribute, republish or commercially exploit any part of the site without prior written consent.',
    ],
  },
  {
    heading: 'External Links and Services',
    body: [
      'The site may contain links to third-party services or payment providers for convenience. Their content, availability and policies are controlled by those providers.',
    ],
  },
  {
    heading: 'Changes to the Terms',
    body: [
      'We may update these terms from time to time to reflect changes in our services, legal requirements or business operations. The latest version will always be published on this page.',
    ],
  },
];
---

<Layout
  title="Terms and Conditions — RIVA VALENCIA"
  description="Read the terms and conditions governing use of the Riva Valencia website."
>
  <LegalPage
    eyebrow="Website Terms"
    title="Terms and Conditions"
    intro="These terms describe the rules for using the Riva Valencia website, content and connected services."
    updated="April 28, 2026"
    sections={sections}
  />
</Layout>
