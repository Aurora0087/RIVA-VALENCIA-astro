---
import Layout from '@/layouts/Layout.astro';
import { getAllProducts } from '@/lib/shopify';
import { AllProductsPage } from '@/components/AllProductsPage';

const { products, status } = await getAllProducts(50);
---

<Layout title="All Products — RIVA VALENCIA" description="Browse the complete Riva Valencia leather collection — bags, wallets, belts and accessories Designed In Spain.">
  <AllProductsPage products={products} status={status} client:load />
</Layout>
