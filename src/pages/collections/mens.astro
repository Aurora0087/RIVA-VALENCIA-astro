---
import Layout from '@/layouts/Layout.astro';
import { getCollectionByHandle, getAllCollections } from '@/lib/shopify';
import { ProductGrid } from '@/components/ProductGrid';

const COLLECTION_HANDLE = 'mens-collection';
const { collection, status } = await getCollectionByHandle(COLLECTION_HANDLE);
const products = collection?.products.edges.map((e) => e.node) ?? [];

const BEST_TAGS = new Set(['best', 'best-seller', 'bestseller', 'best seller']);
const bestSellers = products.filter((p) =>
  p.tags.some((t) => BEST_TAGS.has(t.toLowerCase()))
);

const allCollections =
  status.ok && (!collection || products.length === 0) ? await getAllCollections() : [];

const REVIEWS = [
  { text: 'The briefcase feels precise, understated and incredibly refined. It looks even better in person than it did online.', author: 'Alejandro Ruiz — Madrid, Spain', stars: 5 },
  { text: 'I asked for advice before ordering and the team guided me perfectly. The leather is elegant and the structure is exceptional.', author: 'Matteo Bianchi — Milan, Italy', stars: 5 },
  { text: 'My backpack arrived beautifully packed and ready for daily use. It feels luxurious without trying too hard.', author: 'Javier Moreno — Valencia, Spain', stars: 5 },
  { text: 'The finish, the hardware and the proportions are all spot on. It is one of the most polished men’s bags I have bought.', author: 'Luca Ferraro — Florence, Italy', stars: 5 },
];

const AS_SEEN_ON = [
  {
    name: '@claudiobreitscheidel',
    href: '/collections/mens?cat=shoulder-bags',
    img: 'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/download_10.jpg?v=1776007318',
  },
  {
    name: '@tomasch',
    href: '/collections/mens?cat=briefcases',
    img: 'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/men1.png?v=1775979639',
  },
  {
    name: '@jeremy.caira',
    href: '/collections/mens?cat=backpacks',
    img: 'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/ZARA_Espana_-_Canarias___Nueva_Coleccion_Online.jpg?v=1775831469',
  },
  {
    name: '@styleitwithsami',
    href: '/collections/mens?cat=men-wallets',
    img: 'https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_t6anpt6anpt6anpt.png?v=1776009709',
  },
];
---

<Layout title={`${collection?.title ?? "Men's Collection"} — RIVA VALENCIA`}>

  <!-- ── HERO ── -->
  <a class="rv-hero" href="/collections/mens">
    <img
      src="https://cdn.shopify.com/s/files/1/0812/7738/7010/files/men1.png?v=1775979639"
      alt="Men's Collection — Spring / Summer 2026"
      style="width:100%;height:100%;object-fit:cover;"
    />
    <div class="rv-hero-grad"></div>
    <div class="rv-hero-content">
      <span class="rv-hero-eyebrow">Spring / Summer 2026</span>
      <span class="rv-hero-h1">Men's<br>Leather</span>
      <span class="rv-hero-sub">Crafted for the modern man in Spain</span>
      <span class="rv-hero-btn">Discover the Products →</span>
    </div>
  </a>

  <!-- ── NEW ARRIVALS ── -->
  <div class="rv-sh rv-reveal">
    <h2>New Arrivals</h2>
    <p>The finest Spanish leather, crafted for the modern man</p>
  </div>
  <div class="rv-g2">
    <a class="rv-ec rv-reveal rv-reveal-l" href="/collections/man-backpacks">
      <div class="rv-ph-block">
        <img
          src="https://cdn.shopify.com/s/files/1/0812/7738/7010/files/LARGE_BOWLING_duffle_bag_in_leather_in_Black___Saint_Laurent___YSL_EN-US.jpg?v=1776007265"
          alt="Briefcases"
          style="width:100%;height:100%;object-fit:cover;"
          loading="lazy"
        />
      </div>
      <div class="rv-ec-grad"></div>
      <div class="rv-ec-body">
        <span class="rv-ec-tag">New In · Spring 2026</span>
        <span class="rv-ec-title">Briefcases</span>
        <span class="rv-ec-cta">Shop Now →</span>
      </div>
    </a>
    <a class="rv-ec rv-reveal rv-reveal-r" href="/collections/man-shoulder-bags">
      <div class="rv-ph-block">
        <img
          src="https://cdn.shopify.com/s/files/1/0812/7738/7010/files/download_10.jpg?v=1776007318"
          alt="Shoulder Bags"
          style="width:100%;height:100%;object-fit:cover;"
          loading="lazy"
        />
      </div>
      <div class="rv-ec-grad"></div>
      <div class="rv-ec-body">
        <span class="rv-ec-tag">New In · Spring 2026</span>
        <span class="rv-ec-title">Shoulder Bags</span>
        <span class="rv-ec-cta">Shop Now →</span>
      </div>
    </a>
  </div>


  <!-- ── BEST SELLERS ── -->
  <div class="rv-sh rv-reveal">
    <h2>Best Sellers</h2>
    <p>Our most loved pieces — built for purpose, designed for life</p>
  </div>

  {/* Connection diagnostic */}
  {status.ok && !collection && allCollections.length > 0 && (
    <div class="rv-diag">
      <h3>Collection handle mismatch — update COLLECTION_HANDLE in mens.astro</h3>
      <table>
        <thead><tr><th>Handle</th><th>Title</th><th>Has products</th></tr></thead>
        <tbody>
          {allCollections.map(c => (
            <tr><td>{c.handle}</td><td>{c.title}</td><td>{c.productsCount > 0 ? '✓' : '—'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <div class="rv-best-sellers-slider">
    {bestSellers.length > 0
      ? <ProductGrid products={bestSellers} mode="carousel" client:load />
      : <ProductGrid products={products} mode="carousel" client:load />
    }
  </div>

  <!-- ── VIDEO ── -->
  <div class="rv-vid">
    <video autoplay muted loop playsinline>
      <source src="https://cdn.shopify.com/videos/c/o/v/6b863cf816834b5ca830823360449c38.mp4" type="video/mp4" />
    </video>
    <div class="rv-vid-overlay">
      <span class="rv-vid-label">Our Craftsmanship</span>
      <span class="rv-vid-title">Designed<br>In Spain</span>
      <span class="rv-vid-body">
        Every bag cut, stitched and finished<br>by artisan hands in Valencia
      </span>
      <a href="/pages/craftsmanship" class="rv-vid-btn">Discover Our Story</a>
    </div>
  </div>

  <!-- ── FEATURE GRID ── -->
  <div class="rv-sh rv-reveal">
    <h2>The Collections</h2>
    <p>Every category, every occasion</p>
  </div>
  <div class="rv-feat">
    <a class="rv-ec rv-reveal rv-reveal-l" href="/collections/man-backpacks" style="height:100%">
      <img
        src="https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_eqx6jjeqx6jjeqx6.png?v=1776010385"
        alt="Briefcases"
        style="aspect-ratio:unset;height:100%;min-height:600px;width:100%;object-fit:cover;"
        loading="lazy"
      />
      <div class="rv-ec-grad"></div>
      <div class="rv-ec-body">
        <span class="rv-ec-tag">Collection</span>
        <span class="rv-ec-title">Briefcases</span>
        <span class="rv-ec-cta">Explore →</span>
      </div>
    </a>
    <div class="rv-feat-r">
      <a class="rv-ec rv-reveal rv-reveal-r" href="/collections/man-backpacks">
        <img
          src="https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Italian_Leather_Backpack.jpg?v=1776008325"
          alt="Backpacks"
          style="aspect-ratio:unset;height:100%;min-height:280px;width:100%;object-fit:cover;"
          loading="lazy"
        />
        <div class="rv-ec-grad"></div>
        <div class="rv-ec-body">
          <span class="rv-ec-tag">Everyday Essential</span>
          <span class="rv-ec-title">Backpacks</span>
          <span class="rv-ec-cta">Explore →</span>
        </div>
      </a>
      <a class="rv-ec rv-reveal rv-reveal-r rv-reveal-delay2" href="/collections/man-wallets">
        <img
          src="https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Cruise_22.jpg?v=1776008606"
          alt="Wallets"
          style="aspect-ratio:unset;height:100%;min-height:280px;width:100%;object-fit:cover;"
          loading="lazy"
        />
        <div class="rv-ec-grad"></div>
        <div class="rv-ec-body">
          <span class="rv-ec-tag">Small Leather Goods</span>
          <span class="rv-ec-title">Wallets</span>
          <span class="rv-ec-cta">Explore →</span>
        </div>
      </a>
    </div>
  </div>

  <!-- ── AS SEEN ON ── -->
  <section class="rv-seen">
    <div class="rv-seen-head rv-reveal">
      <h2>AS SEEN ON</h2>
    </div>
    <div class="rv-seen-grid">
      {AS_SEEN_ON.map(({ name, href, img }, index) => (
        <a class:list={['rv-seen-card', 'rv-reveal', index % 2 === 0 ? 'rv-reveal-l' : 'rv-reveal-r']} href={href}>
          <img src={img} alt={`As seen on ${name}`} loading="lazy" />
          <div class="rv-seen-overlay"></div>
          <span class="rv-seen-handle">{name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── FULL BANNER ── -->
  <a class="rv-fbanner rv-reveal" href="/collections/limited-edition">
    <img
      src="https://cdn.shopify.com/s/files/1/0812/7738/7010/files/Gemini_Generated_Image_o7rv3fo7rv3fo7rv.png?v=1776093365"
      alt="The Executive Collection"
      loading="lazy"
    />
    <div class="rv-fbanner-ov"></div>
    <div class="rv-fbanner-c">
      <span class="rv-fbanner-tag">Limited Edition · 2026</span>
      <span class="rv-fbanner-h2">The Executive<br>Collection</span>
      <span class="rv-fbanner-cta">Explore Now</span>
    </div>
  </a>

  <div class="rv-sh rv-reveal">
    <h2>Shop the Full Products</h2>
    <p>Swipe through every piece in the men&apos;s collection</p>
  </div>
  <ProductGrid products={products} mode="carousel" client:load />

  <!-- ── TRUST BAR ── -->
  <div class="rv-trust">
    <div class="rv-trust-item rv-reveal">
      <span class="rv-trust-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <rect x="1" y="3" width="15" height="13" rx="1"/>
          <path d="M16 8h3l4 4v4h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
      </span>
      <p class="rv-trust-h">Delivery</p>
      <p class="rv-trust-p">Worldwide shipping available with great shipping rates.</p>
    </div>
    <div class="rv-trust-item rv-reveal rv-reveal-delay1">
      <span class="rv-trust-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <rect x="1" y="4" width="22" height="16" rx="2"/>
          <line x1="1" y1="10" x2="23" y2="10"/>
        </svg>
      </span>
      <p class="rv-trust-h">Secure Payment</p>
      <p class="rv-trust-p">Pay in installments. Several payment methods available.</p>
    </div>
    <div class="rv-trust-item rv-reveal rv-reveal-delay2">
      <span class="rv-trust-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <polyline points="23 4 23 10 17 10"/>
          <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/>
        </svg>
      </span>
      <p class="rv-trust-h">Returns</p>
      <p class="rv-trust-p">Easy returns within 30 days.</p>
    </div>
    <div class="rv-trust-item rv-reveal rv-reveal-delay3">
      <span class="rv-trust-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
        </svg>
      </span>
      <p class="rv-trust-h">Customer Service</p>
      <p class="rv-trust-p">Our team is here to help. Contact us by email.</p>
    </div>
  </div>

  <!-- ── PAYMENT LOGOS ── -->
  <div class="rv-payment rv-reveal">
    {['VISA','MASTERCARD','AMEX','RAZORPAY'].map((p, i, arr) => (
      <>
        <span class="rv-payment-logo">{p}</span>
        {i < arr.length - 1 && i % 2 === 1 && <span class="rv-payment-sep"></span>}
      </>
    ))}
  </div>

  <!-- ── REVIEWS ── -->
  <div class="rv-rev">
    <div class="rv-rev-head rv-reveal">
      <div class="rv-rev-stars-big">★★★★★</div>
      <h2>What Our Clients Say</h2>
      <p>4.9 / 5 · Based on 1,240 verified reviews</p>
    </div>
    <div class="swiper rv-rev-swiper">
      <div class="swiper-wrapper">
        {REVIEWS.map(({ text, author, stars }) => (
          <div class="swiper-slide">
            <div class="rv-rev-card rv-reveal">
              <div class="rv-rev-stars">
                {Array.from({ length: stars }).map(() => <span>★</span>)}
              </div>
              <p class="rv-rev-text">"{text}"</p>
              <p class="rv-rev-author">— {author}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── NEWSLETTER ── -->
  <div class="rv-nl">
    <span class="rv-nl-tag rv-reveal">Exclusive Access</span>
    <h2 class="rv-reveal">Stay in the Know</h2>
    <span class="rv-nl-sub rv-reveal">New arrivals, private sales and stories from our artisans</span>
    <form class="rv-nl-form" data-newsletter-form data-newsletter-source="mens-collection">
      <input type="email" class="rv-nl-input" name="email" placeholder="Your email address" required />
      <button type="submit" class="rv-nl-btn">Subscribe</button>
    </form>
    <p class="rv-nl-note" data-newsletter-message aria-live="polite">No spam. Unsubscribe anytime. Read our <a href="/pages/privacy" class="rv-inline-link">Privacy Policy</a>.</p>
  </div>

</Layout>
