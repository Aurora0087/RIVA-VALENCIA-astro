---
import '@/styles/global.css';
import CookieBanner from '@/components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Riva Valencia', description = 'Handcrafted leather goods from Spain' } = Astro.props;

const ANNOUNCEMENTS = [
  'Handcrafted in Valencia',
  'Complimentary delivery above ₹5,000',
  'New season arrivals now live',
  'Secure checkout and easy returns',
];

const MAIN_NAV = [
  { label: "SS'26", href: '/collections/ss26' },
  {
    label: 'New In',
    href: '/collections/new-in',
    children: [
      { label: 'New In Man', href: '/collections/new-man-products' },
      { label: 'New In Woman', href: '/collections/new-woman-products' },
    ],
  },
  {
    label: 'Woman',
    href: '/collections/womens',
    children: [
      { label: 'Shoulder Bags', href: '/collections/shoulder-bags' },
      { label: 'Handbags', href: '/collections/handbags' },
      { label: 'Sling Bags & Cloths', href: '/collections/sling-bags-cloths' },
      { label: 'Laptop / Portfolio Bags', href: '/collections/laptop-portfolio-bags' },
      { label: 'BackPacks', href: '/collections/back-packs' },
      { label: 'Wallet', href: '/collections/woman-wallet' },
      { label: 'Belt', href: '/collections/woman-belt' },
    ],
  },
  {
    label: 'Man',
    href: '/collections/mens',
    children: [
      { label: 'Briefcases', href: '/collections/briefcases' },
      { label: 'Backpacks', href: '/collections/back-packs' },
      { label: 'Slings Bags', href: '/collections/sling-bags' },
      { label: 'Wallets', href: '/collections/man-wallets' },
      { label: 'Belt', href: '/collections/man-belt' },
    ],
  },
  {
    label: 'Accessories',
    href: '/collections/accessories',
    children: [
      { label: 'Work Essentials', href: '/collections/work-essentials' },
      { label: 'Techpack', href: '/collections/techpack' },
      { label: 'Gloves', href: '/collections/gloves' },
      { label: 'Belts', href: '/collections/belts' },
      { label: 'Mobile Case', href: '/collections/mobile-case' },
      { label: 'Watch Strap', href: '/collections/watch-strap' },
      { label: 'Keychain', href: '/collections/keychain' },
    ],
  },
  {
    label: 'Jackets',
    href: '/collections/jackets',
    children: [
      { label: 'Woman Jackets', href: '/collections/woman-jackets' },
      { label: 'Man Jackets', href: '/collections/man-jackets' },
    ],
  },
  { label: 'Limited Edition', href: '/collections/limited-edition' },
  { label: 'Bespoke', href: '/pages/bespoke' },
  {
    label: 'Gifts',
    href: '/collections/gifts',
    children: [
      { label: 'For Woman', href: '/collections/woman-gifts' },
      { label: 'For Man', href: '/collections/man-gifts' },
    ],
  },
  { label: 'Corporate Gifts', href: '/corporategifts' },
  { label: 'Store', href: '/collections/all' },
  {
    label: 'Sale',
    href: '/collections/sale',
    children: [
      { label: 'View All', href: '/collections/sale' },
      { label: 'For Man', href: '/collections/man-sale' },
      { label: 'For Woman', href: '/collections/woman-sale' },
    ],
  },
] as const;

function shouldShowDropdownViewAll(item: (typeof MAIN_NAV)[number]) {
  if (!('children' in item) || !item.children || !item.href) return false;
  return !item.children.some((child) =>
    child.href === item.href || child.label.toLowerCase() === 'view all'
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Jost:wght@200;300;400;500;600;700&family=Cormorant+Garamond:wght@300;400;600&family=Anton&family=Playfair+Display:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  </head>
  <body>
    <header class="rv-site-head" id="rvSiteHead">
      <div class="rv-announce rv-announce-head">
        <div class="swiper rv-announce-swiper" id="rvAnnounceSwiper">
          <div class="swiper-wrapper">
            {ANNOUNCEMENTS.map((item) => (
              <div class="swiper-slide">
                <span class="rv-announce-slide">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <nav class="rv-nav">
        <div class="rv-nav-mobile-left">
          <button class="rv-hamburger" id="rvHamburger" aria-label="Open menu">
            <span></span><span></span><span></span>
          </button>
        </div>

        <div class="rv-nav-brand">
          <a href="/" class="rv-logo-main">RIVA VALENCIA</a>
          <span class="rv-logo-year">Diseñado en España</span>
        </div>

        <div class="rv-nav-desktop">
          <ul class="main-nav-list">
            {MAIN_NAV.map((item) => (
              <li class:list={['nav-item', item.children && 'has-dropdown']}>
                <div class="nav-item-title">
                  {item.href ? (
                    <h2><a href={item.href}>{item.label}</a></h2>
                  ) : (
                    <h2>{item.label}</h2>
                  )}
                </div>
                {item.children && (
                  <ul class="sub-nav-list">
                    {shouldShowDropdownViewAll(item) && (
                      <li><a href={item.href}>View All</a></li>
                    )}
                    {item.children.map((child) => (
                      <li><a href={child.href}>{child.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>

        <div class="rv-nav-right">
          <button class="rv-icon-btn" id="rvSearchBtn" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
          <a href="/account" class="rv-icon-btn" id="rvAccountBtn" aria-label="Account">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
          </a>
          <a href="/wishlist" class="rv-icon-btn" aria-label="Wishlist">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
            </svg>
          </a>
          <a href="/cart" class="rv-icon-btn" aria-label="Cart">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <!-- ── SEARCH OVERLAY ── -->
    <div class="rv-search-bar" id="rvSearchBar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a7660" stroke-width="1.4">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="search"
        class="rv-search-input"
        id="rvSearchInput"
        placeholder="Search bags, wallets, accessories…"
        autocomplete="off"
      />
      <button class="rv-search-close" id="rvSearchClose">Close</button>
      <div class="rv-search-results" id="rvSearchResults" hidden>
        <div class="rv-search-results-inner" id="rvSearchResultsInner"></div>
      </div>
    </div>

    <!-- ── DRAWER MASK ── -->
    <div class="rv-mask" id="rvMask"></div>

    <!-- ── DRAWER ── -->
    <div class="rv-drawer" id="rvDrawer">
      <div class="rv-drawer-top">
        <span class="rv-drawer-logo">RIVA VALENCIA</span>
        <button class="rv-drawer-x" id="rvDrawerClose" aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <p class="rv-drawer-cat">Collections</p>
      <div class="rv-drawer-nav">
        {MAIN_NAV.map((item, index) => (
          <div class:list={['rv-drawer-group', item.children && 'has-children']}>
            {item.children ? (
              <>
                <button
                  type="button"
                  class="rv-drawer-toggle"
                  data-drawer-toggle={index}
                  aria-expanded="false"
                >
                  <span>{item.label}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
                <ul class="rv-drawer-sub" data-drawer-sub={index}>
                  {shouldShowDropdownViewAll(item) && (
                    <li><a href={item.href}>View All</a></li>
                  )}
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} class="rv-drawer-a">
                {item.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>

    <script is:inline>
      window.RivaCartReady = new Promise(function(resolve) {
        window.__resolveRivaCart = resolve;
      });
      window.RivaWishlistReady = new Promise(function(resolve) {
        window.__resolveRivaWishlist = resolve;
      });
    </script>

    <script>
      import {
        addToCart,
        getCart,
        removeCartLine,
        updateCartLine,
        updateCartNote,
      } from '@/lib/storefrontCart';
      import {
        addWishlistItem,
        clearWishlist,
        getWishlist,
        isWishlisted,
        removeWishlistItem,
        setWishlist,
        toggleWishlistItem,
      } from '@/lib/wishlist';

      window.RivaCart = {
        addToCart,
        getCart,
        removeCartLine,
        updateCartLine,
        updateCartNote,
      };

      window.__resolveRivaCart?.(window.RivaCart);

      window.RivaWishlist = {
        addWishlistItem,
        clearWishlist,
        getWishlist,
        isWishlisted,
        removeWishlistItem,
        setWishlist,
        toggleWishlistItem,
      };

      window.__resolveRivaWishlist?.(window.RivaWishlist);
    </script>

    <!-- ── PAGE CONTENT ── -->
    <main>
      <slot />
    </main>

    <!-- ── FOOTER ── -->
    <footer class="rv-foot">
      <div class="rv-foot-top">
        <div class="rv-foot-intro">
          <span class="rv-foot-kicker">Riva Valencia Atelier</span>
          <h2 class="rv-foot-title">Crafted in Spain. Carried everywhere.</h2>
          <p class="rv-foot-desc">
            Discover refined leather goods, thoughtful gifting and client care shaped around the pace of modern life.
          </p>
          <div class="rv-foot-actions">
            <a href="/collections/all" class="rv-foot-cta">Shop the Collection</a>
            <a href="/pages/bespoke" class="rv-foot-textlink">Bespoke Service</a>
          </div>
        </div>

        <div class="rv-foot-card">
          <span class="rv-foot-card-kicker">Client Care</span>
          <p class="rv-foot-card-title">Need sizing, delivery or returns help?</p>
          <p class="rv-foot-card-copy">
            Our support pages cover shipping timelines, return steps, fit guidance and the most common questions before you buy.
          </p>
          <div class="rv-foot-card-links">
            <a href="/pages/faq">Visit FAQ</a>
            <a href="/pages/shipping">Shipping Policy</a>
            <a href="/pages/returns">Return Policy</a>
          </div>
        </div>
      </div>

      <div class="rv-foot-grid">
        <div class="rv-foot-col-left">
          <p class="rv-foot-join">Join Riva Valencia</p>
          <p class="rv-foot-desc">
            Subscribe to receive exclusive offers, new arrivals and stories from our artisans in Valencia.
          </p>
          <button class="rv-foot-nl-btn" onclick="document.querySelector('.rv-nl-input')?.focus()">
            Subscribe to Newsletter
          </button>
          <p class="rv-foot-privacy">
            By subscribing you agree to our
            <a href="/pages/privacy" class="rv-inline-link">Privacy Policy</a>.
            You may unsubscribe at any time.
          </p>
          <div class="rv-foot-socials">
            <a href="#" class="rv-foot-soc" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
            <a href="#" class="rv-foot-soc" aria-label="Pinterest">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.236 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.181-.78 1.172-4.97 1.172-4.97s-.299-.598-.299-1.482c0-1.388.806-2.428 1.808-2.428.852 0 1.265.64 1.265 1.408 0 .858-.546 2.14-.828 3.33-.236.995.499 1.806 1.476 1.806 1.771 0 3.132-1.867 3.132-4.56 0-2.385-1.715-4.052-4.163-4.052-2.836 0-4.5 2.127-4.5 4.324 0 .856.33 1.773.741 2.274a.3.3 0 01.069.286c-.075.314-.243.995-.276 1.134-.044.183-.145.222-.334.134-1.249-.581-2.03-2.407-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.22-5.19 6.22-1.013 0-1.966-.527-2.292-1.148l-.623 2.378c-.226.869-.835 1.958-1.244 2.621.937.29 1.931.446 2.962.446 5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
            </a>
            <a href="#" class="rv-foot-soc" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
              </svg>
            </a>
          </div>
        </div>

        <div>
          <p class="rv-foot-col-h">Collections</p>
          <ul class="rv-foot-links">
            <li><a href="/collections/womens">Women</a></li>
            <li><a href="/collections/mens">Men</a></li>
            <li><a href="/collections/accessories">Accessories</a></li>
            <li><a href="/collections/jackets">Jackets</a></li>
            <li><a href="/collections/limited-edition">Limited Edition</a></li>
            <li><a href="/collections/sale">Sale</a></li>
          </ul>
        </div>

        <div>
          <p class="rv-foot-col-h">House</p>
          <ul class="rv-foot-links">
            <li><a href="/pages/about">Our Story</a></li>
            <li><a href="/pages/bespoke">Bespoke</a></li>
            <li><a href="/pages/corporategifts">Corporate Gifts</a></li>
            <li><a href="/collections/limited-edition">Limited Edition</a></li>
            <li><a href="/pages/sitemap">Sitemap</a></li>
          </ul>
        </div>

        <div>
          <p class="rv-foot-col-h">Help</p>
          <ul class="rv-foot-links">
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/shipping">Shipping Policy</a></li>
            <li><a href="/pages/returns">Return Policy</a></li>
            <li><a href="/pages/size-guide">Size Guide</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
          </ul>
        </div>
      </div>

      <div class="rv-foot-pay">
        {['VISA','MASTERCARD','AMEX','APPLE PAY','GOOGLE PAY','PAYPAL','KLARNA','UPI'].map(p => (
          <span class="rv-foot-pay-logo">{p}</span>
        ))}
      </div>

      <div class="rv-foot-brand">
        <div class="rv-foot-brand-crest">
          <div class="rv-foot-brand-crest-inner">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
        </div>
        <span class="rv-foot-brand-name" id="rvFootBrand">RIVA VALENCIA</span>
      </div>

      <div class="rv-foot-bottom">
        <span class="rv-foot-copy">© 2026 Riva Valencia. All rights reserved.</span>
        <div class="rv-foot-bl">
          <a href="/pages/terms-purchase">Terms and Conditions of Purchase</a>
          <a href="/pages/terms">Terms and Conditions</a>
          <a href="/pages/privacy">Privacy Policy</a>
          <a href="/pages/privacy-management">Privacy Management</a>
          <a href="/pages/cookies">Cookies Policy</a>
          <a href="/pages/cookie-settings">Cookie Settings</a>
          <a href="/pages/sitemap">Sitemap</a>
        </div>
      </div>
    </footer>

    <button type="button" class="rv-to-top" id="rvToTop" aria-label="Go to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <CookieBanner />

  </body>
</html>

<script is:inline>
  var rvSiteHead = document.getElementById('rvSiteHead');
  var rvToTop = document.getElementById('rvToTop');

  /* ── Drawer ── */
  var rvDrawer  = document.getElementById('rvDrawer');
  var rvMask    = document.getElementById('rvMask');
  var rvHam     = document.getElementById('rvHamburger');
  var rvDrawerToggles = document.querySelectorAll('[data-drawer-toggle]');

  function rvOpen() {
    rvDrawer.classList.add('open');
    rvMask.classList.add('open');
    rvHam.classList.add('active');
    document.body.style.overflow = 'hidden';
    window.rvRefreshHeader?.();
  }
  function rvClose() {
    rvDrawer.classList.remove('open');
    rvMask.classList.remove('open');
    rvHam.classList.remove('active');
    document.body.style.overflow = '';
    rvDrawerToggles.forEach(function(toggle) {
      toggle.setAttribute('aria-expanded', 'false');
    });
    document.querySelectorAll('[data-drawer-sub]').forEach(function(sub) {
      sub.classList.remove('open');
    });
    window.rvRefreshHeader?.();
  }

  rvHam.addEventListener('click', function() {
    rvDrawer.classList.contains('open') ? rvClose() : rvOpen();
  });
  document.getElementById('rvDrawerClose').addEventListener('click', rvClose);
  rvMask.addEventListener('click', rvClose);
  rvDrawerToggles.forEach(function(toggle) {
    toggle.addEventListener('click', function() {
      var key = toggle.getAttribute('data-drawer-toggle');
      var sub = document.querySelector('[data-drawer-sub="' + key + '"]');
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';
      rvDrawerToggles.forEach(function(otherToggle) {
        if (otherToggle === toggle) return;
        otherToggle.setAttribute('aria-expanded', 'false');
      });
      document.querySelectorAll('[data-drawer-sub]').forEach(function(otherSub) {
        if (otherSub === sub) return;
        otherSub.classList.remove('open');
      });
      toggle.setAttribute('aria-expanded', String(!isOpen));
      if (sub) sub.classList.toggle('open', !isOpen);
    });
  });

  /* ── Announcement Swiper ── */
  function rvInitAnnouncementSwiper() {
    var announceEl = document.getElementById('rvAnnounceSwiper');
    if (!announceEl || !window.Swiper) return;
    if (announceEl.swiper) {
      announceEl.swiper.update();
      return;
    }
    new window.Swiper(announceEl, {
      slidesPerView: 1,
      loop: true,
      speed: 650,
      allowTouchMove: false,
      watchOverflow: true,
      observer: true,
      observeParents: true,
      autoplay: {
        delay: 3600,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
    });
  }
  if (document.readyState === 'complete') rvInitAnnouncementSwiper();
  document.addEventListener('DOMContentLoaded', rvInitAnnouncementSwiper);
  window.addEventListener('load', rvInitAnnouncementSwiper);

  /* ── Review Swipers ── */
  function rvInitReviewSwipers() {
    if (!window.Swiper) return;
    document.querySelectorAll('.rv-rev-swiper').forEach(function(swiperEl) {
      if (swiperEl.swiper) {
        swiperEl.swiper.update();
        return;
      }
      new window.Swiper(swiperEl, {
        loop: true,
        centeredSlides: true,
        speed: 950,
        slidesPerView: 1.08,
        spaceBetween: 14,
        autoplay: {
          delay: 2600,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
          reverseDirection: true,
        },
        breakpoints: {
          640: { slidesPerView: 1.5, spaceBetween: 16 },
          960: { slidesPerView: 2.2, spaceBetween: 20 },
          1280: { slidesPerView: 3, spaceBetween: 22 },
        },
      });
    });
  }
  if (document.readyState === 'complete') rvInitReviewSwipers();
  document.addEventListener('DOMContentLoaded', rvInitReviewSwipers);
  window.addEventListener('load', rvInitReviewSwipers);

  /* ── Search ── */
  var rvSearchBar = document.getElementById('rvSearchBar');
  var rvSearchInput = document.getElementById('rvSearchInput');
  var rvSearchResults = document.getElementById('rvSearchResults');
  var rvSearchResultsInner = document.getElementById('rvSearchResultsInner');
  var rvSearchItems = [];
  var rvSearchLoaded = false;
  var rvSearchLoadPromise = null;
  var rvSearchTimer = null;
  function rvSearch() {
    var willOpen = !rvSearchBar.classList.contains('open');
    rvSearchBar.classList.toggle('open', willOpen);
    if (willOpen) {
      rvSearchInput.focus();
      rvLoadSearchIndex();
      rvScheduleLiveSearch();
    } else {
      rvHideLiveSearch();
    }
    window.rvRefreshHeader?.();
  }
  function rvGoSearch() {
    var query = rvSearchInput.value.trim();
    window.location.href = '/search' + (query ? '?q=' + encodeURIComponent(query) : '');
  }
  function rvSearchEscape(value) {
    return String(value || '').replace(/[&<>"']/g, function(char) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
    });
  }
  function rvSearchNormalize(value) {
    return String(value || '').trim().toLowerCase();
  }
  function rvSearchMoney(amount, currency) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: currency || 'INR',
      maximumFractionDigits: 0,
    }).format(Number(amount || 0));
  }
  function rvSearchLimit() {
    return window.matchMedia('(min-width: 1024px)').matches ? 4 : 2;
  }
  function rvHideLiveSearch() {
    if (!rvSearchResults || !rvSearchResultsInner) return;
    rvSearchResults.hidden = true;
    rvSearchResultsInner.innerHTML = '';
  }
  function rvLoadSearchIndex() {
    if (rvSearchLoaded) return Promise.resolve(rvSearchItems);
    if (rvSearchLoadPromise) return rvSearchLoadPromise;
    rvSearchLoadPromise = fetch('/search-index.json')
      .then(function(response) {
        if (!response.ok) throw new Error('Search unavailable');
        return response.json();
      })
      .then(function(data) {
        rvSearchItems = Array.isArray(data.items) ? data.items : [];
        rvSearchLoaded = true;
        return rvSearchItems;
      })
      .catch(function() {
        rvSearchItems = [];
        rvSearchLoaded = true;
        return rvSearchItems;
      });
    return rvSearchLoadPromise;
  }
  function rvScoreSearchItem(item, terms) {
    var title = rvSearchNormalize(item.title);
    var type = rvSearchNormalize(item.productType);
    var vendor = rvSearchNormalize(item.vendor);
    var tags = rvSearchNormalize((item.tags || []).join(' '));
    var searchText = rvSearchNormalize(item.searchText);
    var score = 0;
    terms.forEach(function(term) {
      if (title === term) score += 80;
      if (title.startsWith(term)) score += 45;
      if (title.includes(term)) score += 30;
      if (type.includes(term)) score += 18;
      if (vendor.includes(term)) score += 12;
      if (tags.includes(term)) score += 10;
      if (searchText.includes(term)) score += 4;
    });
    return score;
  }
  function rvRenderLiveSearch(query) {
    if (!rvSearchResults || !rvSearchResultsInner) return;
    var cleanQuery = query.trim();
    if (cleanQuery.length < 2) {
      rvHideLiveSearch();
      return;
    }
    var terms = rvSearchNormalize(cleanQuery).split(/\s+/).filter(Boolean);
    var matches = rvSearchItems
      .map(function(item) {
        return { item: item, score: rvScoreSearchItem(item, terms) };
      })
      .filter(function(entry) { return entry.score > 0; })
      .sort(function(a, b) { return b.score - a.score || a.item.title.localeCompare(b.item.title); })
      .slice(0, rvSearchLimit())
      .map(function(entry) { return entry.item; });

    if (!matches.length) {
      rvSearchResultsInner.innerHTML = '<div class="rv-search-empty">No matching pieces found</div>'
        + '<a class="rv-search-all" href="/search?q=' + encodeURIComponent(cleanQuery) + '">Open full search →</a>';
      rvSearchResults.hidden = false;
      return;
    }

    rvSearchResultsInner.innerHTML = matches.map(function(item) {
      var media = item.image
        ? '<img src="' + rvSearchEscape(item.image) + '" alt="' + rvSearchEscape(item.imageAlt || item.title) + '" loading="lazy">'
        : '';
      return '<a class="rv-search-hit" href="' + rvSearchEscape(item.url) + '">'
        + '<span class="rv-search-hit-media">' + media + '</span>'
        + '<span class="rv-search-hit-body">'
        + '<span class="rv-search-hit-meta">' + rvSearchEscape(item.productType || item.vendor || 'Leather Goods') + '</span>'
        + '<span class="rv-search-hit-title">' + rvSearchEscape(item.title) + '</span>'
        + '<span class="rv-search-hit-price">' + rvSearchEscape(rvSearchMoney(item.priceAmount, item.currencyCode)) + '</span>'
        + '</span>'
        + '</a>';
    }).join('') + '<a class="rv-search-all" href="/search?q=' + encodeURIComponent(cleanQuery) + '">View all results →</a>';
    rvSearchResults.hidden = false;
  }
  function rvScheduleLiveSearch() {
    clearTimeout(rvSearchTimer);
    var query = rvSearchInput.value.trim();
    if (query.length < 2) {
      rvHideLiveSearch();
      return;
    }
    rvSearchTimer = setTimeout(function() {
      rvLoadSearchIndex().then(function() {
        rvRenderLiveSearch(rvSearchInput.value);
      });
    }, 120);
  }
  if (window.location.pathname.replace(/\/$/, '') === '/search') {
    rvSearchInput.value = new URLSearchParams(window.location.search).get('q') || '';
  }
  document.getElementById('rvSearchBtn').addEventListener('click', rvSearch);
  document.getElementById('rvSearchClose').addEventListener('click', rvSearch);
  rvSearchInput.addEventListener('input', rvScheduleLiveSearch);
  rvSearchInput.addEventListener('focus', rvScheduleLiveSearch);
  rvSearchInput.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    rvGoSearch();
  });
  window.addEventListener('resize', function() {
    if (!rvSearchResults || rvSearchResults.hidden) return;
    rvRenderLiveSearch(rvSearchInput.value);
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { rvClose(); if (rvSearchBar.classList.contains('open')) rvSearch(); }
  });

  /* ── Header show/hide on scroll ── */
  (function() {
    if (!rvSiteHead) return;
    function syncHeader(currentY) {
      var searchOpen = rvSearchBar.classList.contains('open');
      var drawerOpen = rvDrawer.classList.contains('open');
      rvSiteHead.classList.toggle('compact', currentY > 12 && !searchOpen && !drawerOpen);
      rvSiteHead.classList.remove('hidden');
    }
    window.rvRefreshHeader = function() {
      syncHeader(window.scrollY);
    };
    window.rvRefreshHeader();
    window.addEventListener('scroll', window.rvRefreshHeader, { passive: true });
    window.addEventListener('resize', window.rvRefreshHeader, { passive: true });
  })();

  /* ── Go to top ── */
  (function() {
    if (!rvToTop) return;
    function syncTopButton() {
      rvToTop.classList.toggle('visible', window.scrollY > 420);
    }
    rvToTop.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    syncTopButton();
    window.addEventListener('scroll', syncTopButton, { passive: true });
  })();

  /* ── Account link routing ── */
  (function() {
    var token = localStorage.getItem('rv_customer_token');
    var btn = document.getElementById('rvAccountBtn');
    if (btn) btn.href = token ? '/account' : '/account/login';
  })();

  /* ── Scroll Reveal ── */
  var ro = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('in'); } });
  }, { threshold: 0.12 });

  document.querySelectorAll(
    '.rv-reveal,.rv-reveal-l,.rv-reveal-r,.rv-cat,.rv-foot-brand-name'
  ).forEach(function(el) { ro.observe(el); });

  /* ── Horizontal drag scroll ── */
  document.querySelectorAll('.rv-htrack,.rv-rev-track').forEach(function(track) {
    var isDown = false, startX, scrollLeft;
    track.addEventListener('mousedown', function(e) {
      isDown = true; startX = e.pageX - track.offsetLeft; scrollLeft = track.scrollLeft;
    });
    track.addEventListener('mouseleave', function() { isDown = false; });
    track.addEventListener('mouseup', function() { isDown = false; });
    track.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      track.scrollLeft = scrollLeft - (e.pageX - track.offsetLeft - startX) * 1.8;
    });
  });
</script>
