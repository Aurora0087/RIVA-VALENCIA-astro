---
import '@/styles/global.css';
import CookieBanner from '@/components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Riva Valencia', description = 'Handcrafted leather goods from Spain' } = Astro.props;

const ANNOUNCEMENTS = [
  'Handcrafted in Valencia',
  'Complimentary delivery above ₹5,000',
  'New season arrivals now live',
  'Secure checkout and easy returns',
];

const MAIN_NAV = [
  { label: "SS'26", href: '/collections/ss26' },
  {
    label: 'New In',
    href: '/collections/new-in',
    children: [
      { label: 'New In Man', href: '/collections/new-in-man' },
      { label: 'New In Woman', href: '/collections/new-in-man' },
    ],
  },
  {
    label: 'Woman',
    href: '/collections/womens',
    children: [
      { label: 'Shoulder Bags', href: '/collections/woman-shoulder-bags' },
      { label: 'Handbags', href: '/collections/woman-hand-bags' },
      { label: 'Sling Bags & Cloths', href: '/collections/woman-sling-bags-cloths' },
      { label: 'Laptop / Portfolio Bags', href: '/collections/woman-laptop-portfolio-bags' },
      { label: 'BackPacks', href: '/collections/woman-backpacks' },
      { label: 'Wallet', href: '/collections/woman-wallet' },
      { label: 'Belt', href: '/collections/woman-belt' },
    ],
  },
  {
    label: 'Man',
    href: '/collections/mens',
    children: [
      { label: 'Briefcases', href: '/collections/man-bricfcascs' },
      { label: 'Backpacks', href: '/collections/man-backpacks' },
      { label: 'Slings Bags', href: '/collections/man-slings-bags' },
      { label: 'Wallets', href: '/collections/man-wallets' },
      { label: 'Belt', href: '/collections/man-belt' },
    ],
  },
  {
    label: 'Accessories',
    href: '/collections/accessories',
    children: [
      { label: 'Work Essentials', href: '/collections/work-essentials' },
      { label: 'Techpack', href: '/collections/techpack' },
      { label: 'Gloves', href: '/collections/gloves' },
      { label: 'Belts', href: '/collections/belts' },
      { label: 'Mobile Case', href: '/collections/mobile-case' },
      { label: 'Watch Strap', href: '/collections/watch-strap' },
      { label: 'Keychain', href: '/collections/keychain' },
    ],
  },
  {
    label: 'Jackets',
    href: '/collections/jackets',
    children: [
      { label: 'Woman Jackets', href: '/collections/woman-jackets' },
      { label: 'Man Jackets', href: '/collections/man-jackets' },
    ],
  },
  { label: 'Limited Edition', href: '/collections/limited-edition' },
  { label: 'Bespoke', href: '/pages/bespoke' },
  {
    label: 'Gifts',
    href: '/collections/gifts',
    children: [
      { label: 'For Woman', href: '/collections/woman-gifts' },
      { label: 'For Man', href: '/collections/man-gifts' },
    ],
  },
  { label: 'Corporate Gifts', href: '/corporategifts' },
  { label: 'Store', href: '/collections/all' },
  {
    label: 'Sale',
    href: '/collections/sale',
    children: [
      { label: 'View All', href: '/collections/sale' },
      { label: 'For Man', href: '/collections/man-sale' },
      { label: 'For Woman', href: '/collections/woman-sale' },
    ],
  },
] as const;

function hasNavDropdown(item: (typeof MAIN_NAV)[number]) {
  if (!('children' in item) || !item.children?.length) return false;
  return true;
}

function shouldShowDropdownViewAll(item: (typeof MAIN_NAV)[number]) {
  if (!('children' in item) || !item.children || !item.href) return false;
  return !item.children.some((child) =>
    child.href === item.href || child.label.toLowerCase() === 'view all'
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Jost:wght@200;300;400;500;600;700&family=Cormorant+Garamond:wght@300;400;600&family=Anton&family=Playfair+Display:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  </head>
  <body>
    <header class="rv-site-head" id="rvSiteHead">
      <div class="rv-announce rv-announce-head">
        <div class="swiper rv-announce-swiper" id="rvAnnounceSwiper">
          <div class="swiper-wrapper">
            {ANNOUNCEMENTS.map((item) => (
              <div class="swiper-slide">
                <span class="rv-announce-slide">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <nav class="rv-nav">
        <div class="rv-nav-mobile-left">
          <button class="rv-hamburger" id="rvHamburger" aria-label="Open menu">
            <span></span><span></span><span></span>
          </button>
        </div>

        <div class="rv-nav-brand">
          <a href="/" class="rv-logo-main">RIVA VALENCIA</a>
          <span class="rv-logo-year">Diseñado en España</span>
        </div>

        <div class="rv-nav-desktop">
          <ul class="main-nav-list">
            {MAIN_NAV.map((item) => (
              <li class:list={['nav-item', hasNavDropdown(item) && 'has-dropdown']}>
                <div class="nav-item-title">
                  {item.href ? (
                    <h2><a href={item.href}>{item.label}</a></h2>
                  ) : (
                    <h2>{item.label}</h2>
                  )}
                </div>
                {hasNavDropdown(item) && (
                  <ul class="sub-nav-list">
                    {shouldShowDropdownViewAll(item) && (
                      <li><a href={item.href}>View All</a></li>
                    )}
                    {item.children.map((child) => (
                      <li><a href={child.href}>{child.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>

        <div class="rv-nav-right">
          <button class="rv-icon-btn" id="rvSearchBtn" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
          <a href="/account" class="rv-icon-btn" id="rvAccountBtn" aria-label="Account">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
          </a>
          <a href="/wishlist" class="rv-icon-btn" aria-label="Wishlist">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
            </svg>
          </a>
          <a href="/cart" class="rv-icon-btn" aria-label="Cart">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <!-- ── SEARCH OVERLAY ── -->
    <div class="rv-search-bar" id="rvSearchBar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7B8EB4" stroke-width="1.4">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="search"
        class="rv-search-input"
        id="rvSearchInput"
        placeholder="Search bags, wallets, accessories…"
        autocomplete="off"
      />
      <button class="rv-search-close" id="rvSearchClose">Close</button>
      <div class="rv-search-results" id="rvSearchResults" hidden>
        <div class="rv-search-results-inner" id="rvSearchResultsInner"></div>
      </div>
    </div>

    <!-- ── DRAWER MASK ── -->
    <div class="rv-mask" id="rvMask"></div>

    <!-- ── DRAWER ── -->
    <div class="rv-drawer" id="rvDrawer">
      <div class="rv-drawer-top">
        <span class="rv-drawer-logo">RIVA VALENCIA</span>
        <button class="rv-drawer-x" id="rvDrawerClose" aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <p class="rv-drawer-cat">Collections</p>
      <div class="rv-drawer-nav">
        {MAIN_NAV.map((item, index) => (
          <div class:list={['rv-drawer-group', hasNavDropdown(item) && 'has-children']}>
            {hasNavDropdown(item) ? (
              <>
                <button
                  type="button"
                  class="rv-drawer-toggle"
                  data-drawer-toggle={index}
                  aria-expanded="false"
                >
                  <span>{item.label}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
                <ul class="rv-drawer-sub" data-drawer-sub={index}>
                  {shouldShowDropdownViewAll(item) && (
                    <li><a href={item.href}>View All</a></li>
                  )}
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} class="rv-drawer-a">
                {item.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>

    <script is:inline>
      window.RivaCartReady = new Promise(function(resolve) {
        window.__resolveRivaCart = resolve;
      });
      window.RivaCustomerReady = new Promise(function(resolve) {
        window.__resolveRivaCustomer = resolve;
      });
      window.RivaWishlistReady = new Promise(function(resolve) {
        window.__resolveRivaWishlist = resolve;
      });
    </script>

    <script>
      import {
        addToCart,
        CART_EVENT,
        getCart,
        removeCartLine,
        updateCartBuyerIdentity,
        updateCartLine,
        updateCartNote,
        updateCartSelectedDeliveryOptions,
      } from '@/lib/storefrontCart';
      import {
        CUSTOMER_ACCOUNT_TOKEN_KEY,
        CUSTOMER_TOKEN_KEY,
        getCustomer,
        getSavedToken,
      } from '@/lib/customerApi';
      import {
        addWishlistItem,
        clearWishlist,
        getWishlist,
        isWishlisted,
        removeWishlistItem,
        setWishlist,
        toggleWishlistItem,
      } from '@/lib/wishlist';

      window.RivaCart = {
        addToCart,
        getCart,
        removeCartLine,
        updateCartBuyerIdentity,
        updateCartLine,
        updateCartNote,
        updateCartSelectedDeliveryOptions,
      };

      const renderCartBadge = (count) => {
        const cartLink = document.querySelector('.rv-nav-right a[aria-label="Cart"]');
        if (!cartLink) return;

        let badge = cartLink.querySelector('.rv-cart-nav-badge');
        if (count > 0) {
          if (!badge) {
            badge = document.createElement('span');
            badge.className = 'rv-cart-nav-badge';
            cartLink.appendChild(badge);
          }
          badge.textContent = String(count);
        } else if (badge) {
          badge.remove();
        }
      };

      const syncCartBadge = async () => {
        try {
          const cart = await getCart(false);
          renderCartBadge(cart?.totalQuantity ?? 0);
        } catch {
          renderCartBadge(0);
        }
      };

      window.addEventListener(CART_EVENT, (event) => {
        renderCartBadge(event.detail?.cart?.totalQuantity ?? 0);
      });
      window.addEventListener('storage', syncCartBadge);
      syncCartBadge();

      window.__resolveRivaCart?.(window.RivaCart);

      let customerPromise = null;
      let customerToken = null;

      const getCustomerProfile = async () => {
        const token = getSavedToken();
        if (!token) {
          customerPromise = null;
          customerToken = null;
          return null;
        }

        if (!customerPromise || customerToken !== token) {
          customerToken = token;
          customerPromise = getCustomer(token).catch(() => null);
        }

        return customerPromise;
      };

      const getDefaultAddress = async () => (await getCustomerProfile())?.defaultAddress ?? null;

      window.RivaCustomer = {
        getCustomerProfile,
        getDefaultAddress,
      };

      window.addEventListener('storage', (event) => {
        if (event.key === CUSTOMER_TOKEN_KEY || event.key === CUSTOMER_ACCOUNT_TOKEN_KEY) {
          customerPromise = null;
          customerToken = null;
        }
      });

      window.__resolveRivaCustomer?.(window.RivaCustomer);

      window.RivaWishlist = {
        addWishlistItem,
        clearWishlist,
        getWishlist,
        isWishlisted,
        removeWishlistItem,
        setWishlist,
        toggleWishlistItem,
      };

      window.__resolveRivaWishlist?.(window.RivaWishlist);
    </script>

    <!-- ── PAGE CONTENT ── -->
    <main>
      <slot />
    </main>

    <!-- ── FOOTER ── -->
    <footer class="rv-foot">
      <div class="rv-foot-top">
        <div class="rv-foot-intro">
          <span class="rv-foot-kicker">Riva Valencia Atelier</span>
          <h2 class="rv-foot-title">Designed In Spain. Carried everywhere.</h2>
          <p class="rv-foot-desc">
            Discover refined leather goods, thoughtful gifting and client care shaped around the pace of modern life.
          </p>
          <div class="rv-foot-actions">
            <a href="/collections/all" class="rv-foot-cta">Shop the Collection</a>
            <a href="/pages/bespoke" class="rv-foot-textlink">Bespoke Service</a>
          </div>
        </div>

        <div class="rv-foot-card">
          <span class="rv-foot-card-kicker">Client Care</span>
          <p class="rv-foot-card-title">Need sizing, delivery or returns help?</p>
          <p class="rv-foot-card-copy">
            Our support pages cover shipping timelines, return steps, fit guidance and the most common questions before you buy.
          </p>
          <div class="rv-foot-card-links">
            <a href="/pages/faq">Visit FAQ</a>
            <a href="/pages/shipping">Shipping Policy</a>
            <a href="/pages/returns">Return Policy</a>
          </div>
        </div>
      </div>

      <div class="rv-foot-grid">
        <div class="rv-foot-col-left">
          <p class="rv-foot-join">Join Riva Valencia</p>
          <p class="rv-foot-desc">
            Subscribe to receive exclusive offers, new arrivals and stories from our artisans in Valencia.
          </p>
          <form class="rv-foot-nl-form" data-newsletter-form data-newsletter-source="footer">
            <input
              class="rv-foot-nl-input"
              type="email"
              name="email"
              placeholder="Your email address"
              aria-label="Email address"
              required
            />
            <button class="rv-foot-nl-btn" type="submit">Subscribe to Newsletter</button>
          </form>
          <p class="rv-foot-privacy" data-newsletter-message aria-live="polite">
            By subscribing you agree to our
            <a href="/pages/privacy" class="rv-inline-link">Privacy Policy</a>.
            You may unsubscribe at any time.
          </p>
          <div class="rv-foot-socials">
            <a href="#" class="rv-foot-soc" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
              </svg>
            </a>
            <a href="#" class="rv-foot-soc" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
            <a href="#" class="rv-foot-soc" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-12h4v1.7A4.4 4.4 0 0116 8z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </a>
          </div>
        </div>

        <div>
          <p class="rv-foot-col-h">Collections</p>
          <ul class="rv-foot-links">
            <li><a href="/collections/womens">Women</a></li>
            <li><a href="/collections/mens">Men</a></li>
            <li><a href="/collections/accessories">Accessories</a></li>
            <li><a href="/collections/jackets">Jackets</a></li>
            <li><a href="/collections/limited-edition">Limited Edition</a></li>
            <li><a href="/collections/sale">Sale</a></li>
          </ul>
        </div>

        <div>
          <p class="rv-foot-col-h">House</p>
          <ul class="rv-foot-links">
            <li><a href="/pages/about">Our Story</a></li>
            <li><a href="/pages/bespoke">Bespoke</a></li>
            <li><a href="/pages/corporategifts">Corporate Gifts</a></li>
            <li><a href="/collections/limited-edition">Limited Edition</a></li>
            <li><a href="/pages/sitemap">Sitemap</a></li>
          </ul>
        </div>

        <div>
          <p class="rv-foot-col-h">Help</p>
          <ul class="rv-foot-links">
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/shipping">Shipping Policy</a></li>
            <li><a href="/pages/returns">Return Policy</a></li>
            <li><a href="/pages/size-guide">Size Guide</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
          </ul>
        </div>
      </div>

      <div class="rv-foot-pay">
        {['VISA','MASTERCARD','AMEX'].map(p => (
          <span class="rv-foot-pay-logo">{p}</span>
        ))}
      </div>

      <div class="rv-foot-brand">
        <div class="rv-foot-brand-crest">
          <div class="rv-foot-brand-crest-inner">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
        </div>
        <span class="rv-foot-brand-name" id="rvFootBrand">RIVA VALENCIA</span>
      </div>

      <div class="rv-foot-bottom">
        <div class="rv-foot-meta">
          <span class="rv-foot-copy">© 2026 Riva Valencia. All rights reserved.</span>
          <button type="button" class="wlc-footer-locale" id="rvLocaleBtn" aria-haspopup="dialog" aria-expanded="false" aria-controls="rvLocaleBackdrop">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/>
            </svg>
            <span id="rvLocaleLabel">Spain | English</span>
          </button>
        </div>
        <div class="rv-foot-bl">
          <a href="/pages/terms-purchase">Terms and Conditions of Purchase</a>
          <a href="/pages/terms">Terms and Conditions</a>
          <a href="/pages/privacy">Privacy Policy</a>
          <a href="/pages/privacy-management">Privacy Management</a>
          <a href="/pages/cookies">Cookies Policy</a>
          <a href="/pages/cookie-settings">Cookie Settings</a>
          <a href="/pages/sitemap">Sitemap</a>
        </div>
      </div>
    </footer>

    <div class="rv-locale-backdrop" id="rvLocaleBackdrop" hidden>
      <div class="rv-locale-modal" id="rvLocaleModal" role="dialog" aria-modal="true" aria-labelledby="rvLocaleTitle">
        <button type="button" class="rv-locale-close" id="rvLocaleClose" aria-label="Close location selector">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>

        <span class="rv-locale-kicker">Atelier Access</span>
        <h2 class="rv-locale-title" id="rvLocaleTitle">Select Your Location</h2>
        <p class="rv-locale-copy">Choose your market and language so pricing, delivery details and the browsing experience stay tailored to you.</p>

        <div class="rv-locale-grid">
          <div class="rv-locale-panel">
            <p class="rv-locale-heading">Ship To</p>
            <div class="rv-locale-select-wrap">
              <span class="rv-locale-select-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M3 12h18"></path>
                  <path d="M12 3a15 15 0 010 18"></path>
                  <path d="M12 3a15 15 0 000 18"></path>
                </svg>
              </span>
              <select class="rv-locale-select" id="rvLocaleCountry">
                <option value="spain">Spain</option>
                <option value="india">India</option>
                <option value="usa">United States</option>
                <option value="uk">United Kingdom</option>
                <option value="uae">UAE</option>
                <option value="australia">Australia</option>
                <option value="canada">Canada</option>
                <option value="france">France</option>
                <option value="germany">Germany</option>
              </select>
              <svg class="rv-locale-select-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
            <p class="rv-locale-note">You can update your market whenever you need from the footer.</p>
          </div>

          <div class="rv-locale-panel">
            <p class="rv-locale-heading">Language</p>
            <div class="rv-locale-lang-grid">
              <button class="rv-locale-lang active" data-locale-lang="english" type="button">English</button>
              <button class="rv-locale-lang" data-locale-lang="catalan" type="button">Català</button>
              <button class="rv-locale-lang" data-locale-lang="galego" type="button">Galego</button>
              <button class="rv-locale-lang" data-locale-lang="euskara" type="button">Euskara</button>
            </div>
            <p class="rv-locale-note">Pick the language you would like to browse in.</p>
          </div>
        </div>

        <div class="rv-locale-footer">
          <label class="rv-locale-remember">
            <input type="checkbox" id="rvLocaleRemember" /> Remember my selection
          </label>
          <div class="rv-locale-actions">
            <span class="rv-locale-footer-note">You can change this anytime.</span>
            <button class="rv-locale-continue" id="rvLocaleContinue" type="button">Continue</button>
          </div>
        </div>
      </div>
    </div>

    <button type="button" class="rv-to-top" id="rvToTop" aria-label="Go to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <CookieBanner />

    <!-- ── LIVE CHAT WIDGET ── -->
    <div id="rvChatWidget" aria-label="Live chat">
      <button id="rvChatBubble" aria-label="Open live chat" title="Live chat">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
        </svg>
      </button>

      <div id="rvChatPanel" hidden>
        <div id="rvChatHead">
          <div>
            <span class="rv-chat-brand-name">Live Support</span>
            <span class="rv-chat-brand-sub">Riva Valencia · Typically replies within hours</span>
          </div>
          <button id="rvChatClose" aria-label="Close chat">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        <!-- Pre-chat start form -->
        <div id="rvChatStart">
          <p class="rv-chat-welcome">Hi — how can we help you today?</p>
          <input type="text" id="rvChatNameInput" class="rv-chat-field" placeholder="Your name" autocomplete="name" />
          <input type="email" id="rvChatEmailInput" class="rv-chat-field" placeholder="Email (optional)" autocomplete="email" />
          <button id="rvChatStartBtn" class="rv-chat-start-btn">Start Chat →</button>
        </div>

        <div id="rvChatStatus" class="rv-chat-status" hidden aria-live="polite"></div>

        <!-- Active chat -->
        <div id="rvChatBody" hidden>
          <div id="rvChatMsgs" class="rv-chat-msgs"></div>
          <div class="rv-chat-input-row">
            <input type="text" id="rvChatMsgInput" class="rv-chat-msg-input" placeholder="Type a message…" autocomplete="off" />
            <button id="rvChatSendBtn" class="rv-chat-send-btn" aria-label="Send">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

  </body>
</html>

<script is:inline>
  var rvSiteHead = document.getElementById('rvSiteHead');
  var rvToTop = document.getElementById('rvToTop');

  /* ── Drawer ── */
  var rvDrawer  = document.getElementById('rvDrawer');
  var rvMask    = document.getElementById('rvMask');
  var rvHam     = document.getElementById('rvHamburger');
  var rvDrawerToggles = document.querySelectorAll('[data-drawer-toggle]');

  function rvOpen() {
    rvDrawer.classList.add('open');
    rvMask.classList.add('open');
    rvHam.classList.add('active');
    document.body.style.overflow = 'hidden';
    window.rvRefreshHeader?.();
  }
  function rvClose() {
    rvDrawer.classList.remove('open');
    rvMask.classList.remove('open');
    rvHam.classList.remove('active');
    document.body.style.overflow = '';
    rvDrawerToggles.forEach(function(toggle) {
      toggle.setAttribute('aria-expanded', 'false');
    });
    document.querySelectorAll('[data-drawer-sub]').forEach(function(sub) {
      sub.classList.remove('open');
    });
    window.rvRefreshHeader?.();
  }

  rvHam.addEventListener('click', function() {
    rvDrawer.classList.contains('open') ? rvClose() : rvOpen();
  });
  document.getElementById('rvDrawerClose').addEventListener('click', rvClose);
  rvMask.addEventListener('click', rvClose);
  rvDrawerToggles.forEach(function(toggle) {
    toggle.addEventListener('click', function() {
      var key = toggle.getAttribute('data-drawer-toggle');
      var sub = document.querySelector('[data-drawer-sub="' + key + '"]');
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';
      rvDrawerToggles.forEach(function(otherToggle) {
        if (otherToggle === toggle) return;
        otherToggle.setAttribute('aria-expanded', 'false');
      });
      document.querySelectorAll('[data-drawer-sub]').forEach(function(otherSub) {
        if (otherSub === sub) return;
        otherSub.classList.remove('open');
      });
      toggle.setAttribute('aria-expanded', String(!isOpen));
      if (sub) sub.classList.toggle('open', !isOpen);
    });
  });

  /* ── Announcement Swiper ── */
  function rvInitAnnouncementSwiper() {
    var announceEl = document.getElementById('rvAnnounceSwiper');
    if (!announceEl || !window.Swiper) return;
    if (announceEl.swiper) {
      announceEl.swiper.update();
      return;
    }
    new window.Swiper(announceEl, {
      slidesPerView: 1,
      loop: true,
      speed: 650,
      allowTouchMove: false,
      watchOverflow: true,
      observer: true,
      observeParents: true,
      autoplay: {
        delay: 3600,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
    });
  }
  if (document.readyState === 'complete') rvInitAnnouncementSwiper();
  document.addEventListener('DOMContentLoaded', rvInitAnnouncementSwiper);
  window.addEventListener('load', rvInitAnnouncementSwiper);

  /* ── Review Swipers ── */
  function rvInitReviewSwipers() {
    if (!window.Swiper) return;
    document.querySelectorAll('.rv-rev-swiper').forEach(function(swiperEl) {
      if (swiperEl.swiper) {
        swiperEl.swiper.update();
        return;
      }
      new window.Swiper(swiperEl, {
        loop: true,
        centeredSlides: true,
        speed: 950,
        slidesPerView: 1.08,
        spaceBetween: 14,
        autoplay: {
          delay: 2600,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
          reverseDirection: true,
        },
        breakpoints: {
          640: { slidesPerView: 1.5, spaceBetween: 16 },
          960: { slidesPerView: 2.2, spaceBetween: 20 },
          1280: { slidesPerView: 3, spaceBetween: 22 },
        },
      });
    });
  }
  if (document.readyState === 'complete') rvInitReviewSwipers();
  document.addEventListener('DOMContentLoaded', rvInitReviewSwipers);
  window.addEventListener('load', rvInitReviewSwipers);

  /* ── Search ── */
  var rvSearchBar = document.getElementById('rvSearchBar');
  var rvSearchInput = document.getElementById('rvSearchInput');
  var rvSearchResults = document.getElementById('rvSearchResults');
  var rvSearchResultsInner = document.getElementById('rvSearchResultsInner');
  var rvSearchItems = [];
  var rvSearchLoaded = false;
  var rvSearchLoadPromise = null;
  var rvSearchTimer = null;
  function rvSearch() {
    var willOpen = !rvSearchBar.classList.contains('open');
    rvSearchBar.classList.toggle('open', willOpen);
    if (willOpen) {
      rvSearchInput.focus();
      rvLoadSearchIndex();
      rvScheduleLiveSearch();
    } else {
      rvHideLiveSearch();
    }
    window.rvRefreshHeader?.();
  }
  function rvGoSearch() {
    var query = rvSearchInput.value.trim();
    window.location.href = '/search' + (query ? '?q=' + encodeURIComponent(query) : '');
  }
  function rvSearchEscape(value) {
    return String(value || '').replace(/[&<>"']/g, function(char) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
    });
  }
  function rvSearchNormalize(value) {
    return String(value || '').trim().toLowerCase();
  }
  function rvSearchMoney(amount, currency) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: currency || 'INR',
      maximumFractionDigits: 0,
    }).format(Number(amount || 0));
  }
  function rvSearchLimit() {
    return window.matchMedia('(min-width: 1024px)').matches ? 4 : 2;
  }
  function rvHideLiveSearch() {
    if (!rvSearchResults || !rvSearchResultsInner) return;
    rvSearchResults.hidden = true;
    rvSearchResultsInner.innerHTML = '';
  }
  function rvLoadSearchIndex() {
    if (rvSearchLoaded) return Promise.resolve(rvSearchItems);
    if (rvSearchLoadPromise) return rvSearchLoadPromise;
    rvSearchLoadPromise = fetch('/search-index.json')
      .then(function(response) {
        if (!response.ok) throw new Error('Search unavailable');
        return response.json();
      })
      .then(function(data) {
        rvSearchItems = Array.isArray(data.items) ? data.items : [];
        rvSearchLoaded = true;
        return rvSearchItems;
      })
      .catch(function() {
        rvSearchItems = [];
        rvSearchLoaded = true;
        return rvSearchItems;
      });
    return rvSearchLoadPromise;
  }
  function rvScoreSearchItem(item, terms) {
    var title = rvSearchNormalize(item.title);
    var type = rvSearchNormalize(item.productType);
    var vendor = rvSearchNormalize(item.vendor);
    var tags = rvSearchNormalize((item.tags || []).join(' '));
    var searchText = rvSearchNormalize(item.searchText);
    var score = 0;
    terms.forEach(function(term) {
      if (title === term) score += 80;
      if (title.startsWith(term)) score += 45;
      if (title.includes(term)) score += 30;
      if (type.includes(term)) score += 18;
      if (vendor.includes(term)) score += 12;
      if (tags.includes(term)) score += 10;
      if (searchText.includes(term)) score += 4;
    });
    return score;
  }
  function rvRenderLiveSearch(query) {
    if (!rvSearchResults || !rvSearchResultsInner) return;
    var cleanQuery = query.trim();
    if (cleanQuery.length < 2) {
      rvHideLiveSearch();
      return;
    }
    var terms = rvSearchNormalize(cleanQuery).split(/\s+/).filter(Boolean);
    var matches = rvSearchItems
      .map(function(item) {
        return { item: item, score: rvScoreSearchItem(item, terms) };
      })
      .filter(function(entry) { return entry.score > 0; })
      .sort(function(a, b) { return b.score - a.score || a.item.title.localeCompare(b.item.title); })
      .slice(0, rvSearchLimit())
      .map(function(entry) { return entry.item; });

    if (!matches.length) {
      rvSearchResultsInner.innerHTML = '<div class="rv-search-empty">No matching pieces found</div>'
        + '<a class="rv-search-all" href="/search?q=' + encodeURIComponent(cleanQuery) + '">Open full search →</a>';
      rvSearchResults.hidden = false;
      return;
    }

    rvSearchResultsInner.innerHTML = matches.map(function(item) {
      var media = item.image
        ? '<img src="' + rvSearchEscape(item.image) + '" alt="' + rvSearchEscape(item.imageAlt || item.title) + '" loading="lazy">'
        : '';
      return '<a class="rv-search-hit" href="' + rvSearchEscape(item.url) + '">'
        + '<span class="rv-search-hit-media">' + media + '</span>'
        + '<span class="rv-search-hit-body">'
        + '<span class="rv-search-hit-meta">' + rvSearchEscape(item.productType || item.vendor || 'Leather Goods') + '</span>'
        + '<span class="rv-search-hit-title">' + rvSearchEscape(item.title) + '</span>'
        + '<span class="rv-search-hit-price">' + rvSearchEscape(rvSearchMoney(item.priceAmount, item.currencyCode)) + '</span>'
        + '</span>'
        + '</a>';
    }).join('') + '<a class="rv-search-all" href="/search?q=' + encodeURIComponent(cleanQuery) + '">View all results →</a>';
    rvSearchResults.hidden = false;
  }
  function rvScheduleLiveSearch() {
    clearTimeout(rvSearchTimer);
    var query = rvSearchInput.value.trim();
    if (query.length < 2) {
      rvHideLiveSearch();
      return;
    }
    rvSearchTimer = setTimeout(function() {
      rvLoadSearchIndex().then(function() {
        rvRenderLiveSearch(rvSearchInput.value);
      });
    }, 120);
  }
  if (window.location.pathname.replace(/\/$/, '') === '/search') {
    rvSearchInput.value = new URLSearchParams(window.location.search).get('q') || '';
  }
  document.getElementById('rvSearchBtn').addEventListener('click', rvSearch);
  document.getElementById('rvSearchClose').addEventListener('click', rvSearch);
  rvSearchInput.addEventListener('input', rvScheduleLiveSearch);
  rvSearchInput.addEventListener('focus', rvScheduleLiveSearch);
  rvSearchInput.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    rvGoSearch();
  });
  window.addEventListener('resize', function() {
    if (!rvSearchResults || rvSearchResults.hidden) return;
    rvRenderLiveSearch(rvSearchInput.value);
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { rvClose(); if (rvSearchBar.classList.contains('open')) rvSearch(); }
  });

  /* ── Header show/hide on scroll ── */
  (function() {
    if (!rvSiteHead) return;
    function syncHeader(currentY) {
      var searchOpen = rvSearchBar.classList.contains('open');
      var drawerOpen = rvDrawer.classList.contains('open');
      rvSiteHead.classList.toggle('compact', currentY > 12 && !searchOpen && !drawerOpen);
      rvSiteHead.classList.remove('hidden');
    }
    window.rvRefreshHeader = function() {
      syncHeader(window.scrollY);
    };
    window.rvRefreshHeader();
    window.addEventListener('scroll', window.rvRefreshHeader, { passive: true });
    window.addEventListener('resize', window.rvRefreshHeader, { passive: true });
  })();

  /* ── Go to top ── */
  (function() {
    if (!rvToTop) return;
    function syncTopButton() {
      rvToTop.classList.toggle('visible', window.scrollY > 420);
    }
    rvToTop.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    syncTopButton();
    window.addEventListener('scroll', syncTopButton, { passive: true });
  })();

  /* ── Account link routing ── */
  (function() {
    var token = localStorage.getItem('rv_customer_token');
    var btn = document.getElementById('rvAccountBtn');
    if (btn) btn.href = token ? '/account' : '/account/login';
  })();

  /* ── Location + Language Selector ── */
  (function() {
    var STORAGE_KEY = 'wlc_sel';
    var openBtn = document.getElementById('rvLocaleBtn');
    var labelEl = document.getElementById('rvLocaleLabel');
    var backdrop = document.getElementById('rvLocaleBackdrop');
    var modal = document.getElementById('rvLocaleModal');
    var closeBtn = document.getElementById('rvLocaleClose');
    var countrySelect = document.getElementById('rvLocaleCountry');
    var rememberInput = document.getElementById('rvLocaleRemember');
    var continueBtn = document.getElementById('rvLocaleContinue');
    var langButtons = Array.from(document.querySelectorAll('[data-locale-lang]'));
    var selectedCountry = 'spain';
    var selectedLang = 'english';

    if (!openBtn || !labelEl || !backdrop || !modal || !countrySelect || !rememberInput || !continueBtn || !langButtons.length) {
      return;
    }

    var countryLabels = {
      spain: 'Spain',
      india: 'India',
      usa: 'United States',
      uk: 'United Kingdom',
      uae: 'UAE',
      australia: 'Australia',
      canada: 'Canada',
      france: 'France',
      germany: 'Germany'
    };
    var langLabels = {
      english: 'English',
      catalan: 'Català',
      galego: 'Galego',
      euskara: 'Euskara'
    };

    function syncLabel() {
      labelEl.textContent = (countryLabels[selectedCountry] || selectedCountry) + ' | ' + (langLabels[selectedLang] || selectedLang);
    }

    function syncControls() {
      countrySelect.value = selectedCountry;
      langButtons.forEach(function(button) {
        button.classList.toggle('active', button.getAttribute('data-locale-lang') === selectedLang);
      });
    }

    function showModal() {
      syncControls();
      backdrop.hidden = false;
      requestAnimationFrame(function() {
        backdrop.classList.add('visible');
      });
      document.body.style.overflow = 'hidden';
      openBtn.setAttribute('aria-expanded', 'true');
    }

    function hideModal() {
      backdrop.classList.remove('visible');
      document.body.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');
      window.setTimeout(function() {
        if (!backdrop.classList.contains('visible')) backdrop.hidden = true;
      }, 320);
    }

    function loadStoredPreference() {
      selectedCountry = 'spain';
      selectedLang = 'english';
      rememberInput.checked = false;
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        var saved = JSON.parse(raw);
        if (!saved || saved.remembered !== true) {
          localStorage.removeItem(STORAGE_KEY);
          return;
        }
        if (saved.country) selectedCountry = saved.country;
        if (saved.lang) selectedLang = saved.lang;
        rememberInput.checked = true;
      } catch (error) {
        try { localStorage.removeItem(STORAGE_KEY); } catch (storageError) {}
      }
    }

    loadStoredPreference();
    syncControls();
    syncLabel();

    openBtn.addEventListener('click', showModal);
    closeBtn?.addEventListener('click', hideModal);

    backdrop.addEventListener('click', function(event) {
      if (event.target === backdrop) hideModal();
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && backdrop.classList.contains('visible')) hideModal();
    });

    countrySelect.addEventListener('change', function() {
      selectedCountry = countrySelect.value;
      syncLabel();
    });

    langButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        selectedLang = button.getAttribute('data-locale-lang') || 'english';
        syncControls();
        syncLabel();
      });
    });

    continueBtn.addEventListener('click', function() {
      selectedCountry = countrySelect.value;
      syncLabel();
      try {
        if (rememberInput.checked) {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({
            country: selectedCountry,
            lang: selectedLang,
            remembered: true
          }));
        } else {
          localStorage.removeItem(STORAGE_KEY);
        }
      } catch (error) {}
      window.dispatchEvent(new CustomEvent('rv:locale-changed', {
        detail: {
          country: selectedCountry,
          lang: selectedLang,
          remembered: rememberInput.checked
        }
      }));
      hideModal();
    });

    window.addEventListener('storage', function(event) {
      if (event.key !== STORAGE_KEY) return;
      loadStoredPreference();
      syncControls();
      syncLabel();
    });
  })();

  /* ── Scroll Reveal ── */
  var ro = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('in'); } });
  }, { threshold: 0.12 });

  document.querySelectorAll(
    '.rv-reveal,.rv-reveal-l,.rv-reveal-r,.rv-cat,.rv-foot-brand-name'
  ).forEach(function(el) { ro.observe(el); });

  /* ── Horizontal drag scroll ── */
  document.querySelectorAll('.rv-htrack,.rv-rev-track').forEach(function(track) {
    var isDown = false, startX, scrollLeft;
    track.addEventListener('mousedown', function(e) {
      isDown = true; startX = e.pageX - track.offsetLeft; scrollLeft = track.scrollLeft;
    });
    track.addEventListener('mouseleave', function() { isDown = false; });
    track.addEventListener('mouseup', function() { isDown = false; });
    track.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      track.scrollLeft = scrollLeft - (e.pageX - track.offsetLeft - startX) * 1.8;
    });
  });
</script>

<script is:inline define:vars={{ __rvMedusaUrl: import.meta.env.PUBLIC_MEDUSA_BACKEND_URL || 'http://localhost:9000', __rvMedusaPublishableKey: import.meta.env.PUBLIC_MEDUSA_PUBLISHABLE_KEY || '' }}>
/* ── Live Chat ── */
(function() {
  var MEDUSA = String(__rvMedusaUrl || '').replace(/\/+$/, '');
  var MEDUSA_PUBLISHABLE_KEY = String(__rvMedusaPublishableKey || '').trim();
  var SESSION_KEY = 'rv_chat_session_id';
  var NAME_KEY    = 'rv_chat_name';
  var EMAIL_KEY   = 'rv_chat_email';
  var VISITOR_KEY = 'rv_chat_visitor_id';

  var bubble    = document.getElementById('rvChatBubble');
  var panel     = document.getElementById('rvChatPanel');
  var closeBtn  = document.getElementById('rvChatClose');
  var startView = document.getElementById('rvChatStart');
  var statusEl  = document.getElementById('rvChatStatus');
  var chatBody  = document.getElementById('rvChatBody');
  var nameInput = document.getElementById('rvChatNameInput');
  var emailInput= document.getElementById('rvChatEmailInput');
  var startBtn  = document.getElementById('rvChatStartBtn');
  var msgsEl    = document.getElementById('rvChatMsgs');
  var msgInput  = document.getElementById('rvChatMsgInput');
  var sendBtn   = document.getElementById('rvChatSendBtn');
  var pollTimer = null;
  var identityPromise = null;

  if (!bubble || !panel || !MEDUSA) return;

  function medusaHeaders(headers) {
    var nextHeaders = Object.assign({}, headers || {});
    if (MEDUSA_PUBLISHABLE_KEY) {
      nextHeaders['x-publishable-api-key'] = MEDUSA_PUBLISHABLE_KEY;
    }
    return nextHeaders;
  }

  function getVisitorId() {
    try {
      var existing = localStorage.getItem(VISITOR_KEY);
      if (existing) return existing;
      var created = 'rv_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
      localStorage.setItem(VISITOR_KEY, created);
      return created;
    } catch (_) {
      return 'rv_guest';
    }
  }

  function getDisplayName(customer) {
    var firstName = String(customer && customer.firstName || '').trim();
    var lastName = String(customer && customer.lastName || '').trim();
    var fullName = (firstName + ' ' + lastName).trim();
    if (fullName) return fullName;
    var email = String(customer && customer.email || '').trim();
    if (email) return email.split('@')[0];
    return '';
  }

  function getCustomerIdentity() {
    if (!identityPromise) {
      identityPromise = Promise.resolve(window.RivaCustomer || window.RivaCustomerReady)
        .then(function(api) {
          if (!api || typeof api.getCustomerProfile !== 'function') return null;
          return api.getCustomerProfile();
        })
        .catch(function() {
          return null;
        });
    }

    return identityPromise;
  }

  function prefillIdentity() {
    try {
      var storedName = localStorage.getItem(NAME_KEY) || sessionStorage.getItem(NAME_KEY) || '';
      var storedEmail = localStorage.getItem(EMAIL_KEY) || sessionStorage.getItem(EMAIL_KEY) || '';
      if (nameInput && storedName && !nameInput.value) nameInput.value = storedName;
      if (emailInput && storedEmail && !emailInput.value) emailInput.value = storedEmail;
    } catch (_) {}

    return getCustomerIdentity().then(function(customer) {
      if (!customer) return null;
      var customerName = getDisplayName(customer);
      if (nameInput && !nameInput.value && customerName) nameInput.value = customerName;
      if (emailInput && !emailInput.value && customer.email) emailInput.value = customer.email;
      return customer;
    });
  }

  function setStatus(message, tone) {
    if (!statusEl) return;
    if (!message) {
      statusEl.hidden = true;
      statusEl.textContent = '';
      statusEl.className = 'rv-chat-status';
      return;
    }

    statusEl.hidden = false;
    statusEl.textContent = message;
    statusEl.className = 'rv-chat-status' + (tone ? ' is-' + tone : '');
  }

  function openPanel() {
    panel.hidden = false;
    bubble.classList.add('active');
    prefillIdentity();
    var sid = sessionStorage.getItem(SESSION_KEY);
    if (sid) {
      showBody();
      loadMsgs(sid);
      startPoll(sid);
      setStatus('', '');
    } else {
      showStart();
    }
  }
  function closePanel() {
    panel.hidden = true;
    bubble.classList.remove('active');
    stopPoll();
  }
  function showStart() {
    if (startView) startView.hidden = false;
    if (chatBody) chatBody.hidden = true;
  }
  function showBody() {
    if (startView) startView.hidden = true;
    if (chatBody) chatBody.hidden = false;
  }

  function escChat(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  function getSenderLabel(msg) {
    if (msg.agent_name) return msg.agent_name;
    if (msg.sender_name) return msg.sender_name;
    if (msg.sender_type === 'customer') {
      return sessionStorage.getItem(NAME_KEY) || 'You';
    }
    if (msg.sender_type === 'agent') return 'Riva Team';
    if (msg.sender_type === 'ai') return 'AI Assistant';
    return 'Riva Valencia';
  }
  function appendMsg(msg) {
    if (!msgsEl) return;
    var d = document.createElement('div');
    var tone = msg.sender_type === 'customer'
      ? 'customer'
      : (msg.sender_type === 'agent' ? 'agent' : 'bot');
    d.className = 'rv-chat-msg ' + tone;
    var t = new Date(msg.created_at).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' });
    d.innerHTML = '<span>' + escChat(msg.content) + '</span>'
      + '<div class="rv-chat-msg-meta">' + escChat(getSenderLabel(msg)) + ' · ' + t + '</div>';
    msgsEl.appendChild(d);
    msgsEl.scrollTop = msgsEl.scrollHeight;
  }
  function renderMsgs(msgs) {
    if (!msgsEl) return;
    msgsEl.innerHTML = '';
    if (!msgs.length) {
      msgsEl.innerHTML = '<div class="rv-chat-empty">Send a message and our team will reply here.</div>';
      return;
    }
    msgs.forEach(appendMsg);
  }
  function loadMsgs(sid) {
    fetch(MEDUSA + '/store/live-chat/sessions/' + sid + '/messages', {
      headers: medusaHeaders(),
    })
      .then(function(r) {
        if (r.ok) return r.json();
        var error = new Error('load_failed');
        error.status = r.status;
        throw error;
      })
      .then(function(d) { renderMsgs(d.messages || []); })
      .catch(function(error) {
        if (error && error.status === 404) {
          sessionStorage.removeItem(SESSION_KEY);
          showStart();
          stopPoll();
          setStatus('That chat session expired. Please start a new one.', 'error');
        }
      });
  }
  function startPoll(sid) {
    stopPoll();
    pollTimer = setInterval(function() { loadMsgs(sid); }, 4000);
  }
  function stopPoll() {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  }

  prefillIdentity();

  startBtn && startBtn.addEventListener('click', async function() {
    if (!MEDUSA_PUBLISHABLE_KEY) {
      setStatus('Live chat is not configured yet. Add your Medusa publishable key first.', 'error');
      return;
    }
    var customer = await prefillIdentity();
    var name = nameInput ? nameInput.value.trim() : '';
    if (!name && customer) {
      name = getDisplayName(customer);
      if (nameInput && name) nameInput.value = name;
    }
    if (!name) { nameInput && nameInput.focus(); return; }
    var email = emailInput ? emailInput.value.trim() : '';
    if (!email && customer && customer.email) {
      email = customer.email;
      if (emailInput) emailInput.value = email;
    }
    startBtn.disabled = true;
    startBtn.textContent = 'Connecting…';
    setStatus('Connecting you with live support…', '');

    var payload = {
      customer_name: name,
      storefront_origin: window.location.origin,
      page_url: window.location.href,
      page_title: document.title,
      visitor_id: getVisitorId(),
      metadata: {
        pathname: window.location.pathname,
      },
    };

    if (email) payload.customer_email = email;
    if (customer && customer.id) payload.shopify_customer_id = customer.id;
    if (customer && customer.email) {
      payload.shopify_customer_email = customer.email;
    } else if (email) {
      payload.shopify_customer_email = email;
    }

    fetch(MEDUSA + '/store/live-chat/sessions', {
      method: 'POST',
      headers: medusaHeaders({ 'Content-Type': 'application/json' }),
      body: JSON.stringify(payload),
    })
    .then(function(r) {
      if (r.ok) return r.json();
      throw new Error('Could not start live chat right now.');
    })
    .then(function(data) {
      var sid = data.session && data.session.id;
      if (!sid) throw new Error('no session');
      sessionStorage.setItem(SESSION_KEY, sid);
      sessionStorage.setItem(NAME_KEY, name);
      if (email) sessionStorage.setItem(EMAIL_KEY, email);
      try {
        localStorage.setItem(NAME_KEY, name);
        if (email) localStorage.setItem(EMAIL_KEY, email);
      } catch (_) {}
      showBody();
      renderMsgs(data.messages || []);
      startPoll(sid);
      if (msgInput) msgInput.focus();
      setStatus('You are connected. Send us a message anytime.', 'success');
    })
    .catch(function(error) {
      setStatus(error && error.message ? error.message : 'Could not start live chat right now.', 'error');
      startBtn.disabled = false;
      startBtn.textContent = 'Start Chat →';
      return;
    })
    .finally(function() {
      startBtn.disabled = false;
      startBtn.textContent = 'Start Chat →';
    });
  });

  function sendMsg() {
    var sid  = sessionStorage.getItem(SESSION_KEY);
    var name = sessionStorage.getItem(NAME_KEY) || 'You';
    if (!sid || !msgInput || !msgInput.value.trim()) return;
    var content = msgInput.value.trim();
    msgInput.value = '';
    // Optimistic render
    appendMsg({ sender_type: 'customer', sender_name: name, content: content, created_at: new Date().toISOString() });
    setStatus('', '');
    fetch(MEDUSA + '/store/live-chat/sessions/' + sid + '/messages', {
      method: 'POST',
      headers: medusaHeaders({ 'Content-Type': 'application/json' }),
      body: JSON.stringify({
        content: content,
        metadata: {
          page_url: window.location.href,
        },
      }),
    })
    .then(function(r) {
      if (!r.ok) throw new Error('Could not send your message.');
    })
    .catch(function(error) {
      setStatus(error && error.message ? error.message : 'Could not send your message.', 'error');
      loadMsgs(sid);
    });
  }

  sendBtn  && sendBtn.addEventListener('click', sendMsg);
  msgInput && msgInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMsg(); }
  });
  bubble.addEventListener('click', function() { panel.hidden ? openPanel() : closePanel(); });
  closeBtn && closeBtn.addEventListener('click', closePanel);
})();

/* ── Newsletter ── */
(function() {
  var MEDUSA = String(__rvMedusaUrl || '').replace(/\/+$/, '');
  var MEDUSA_PUBLISHABLE_KEY = String(__rvMedusaPublishableKey || '').trim();
  var forms = Array.from(document.querySelectorAll('[data-newsletter-form]'));

  if (!forms.length) return;

  function medusaHeaders(headers) {
    var nextHeaders = Object.assign({}, headers || {});
    if (MEDUSA_PUBLISHABLE_KEY) {
      nextHeaders['x-publishable-api-key'] = MEDUSA_PUBLISHABLE_KEY;
    }
    return nextHeaders;
  }

  function readLocalePreference() {
    try {
      var raw = localStorage.getItem('wlc_sel');
      if (!raw) return { country: '', lang: '' };
      var parsed = JSON.parse(raw);
      return {
        country: String(parsed && parsed.country || '').trim(),
        lang: String(parsed && parsed.lang || '').trim(),
      };
    } catch (_) {
      return { country: '', lang: '' };
    }
  }

  function setMessage(form, message, tone) {
    var messageEl = form.parentElement && form.parentElement.querySelector('[data-newsletter-message]');
    if (!messageEl) return;
    messageEl.textContent = message;
    messageEl.classList.remove('is-success', 'is-error');
    if (tone) messageEl.classList.add('is-' + tone);
  }

  function setBusy(form, busy, label) {
    var button = form.querySelector('button[type="submit"]');
    if (!button) return;
    if (!button.dataset.originalLabel) {
      button.dataset.originalLabel = button.textContent || '';
    }
    button.disabled = busy;
    button.textContent = busy ? (label || 'Subscribing…') : button.dataset.originalLabel;
  }

  forms.forEach(function(form) {
    form.addEventListener('submit', function(event) {
      event.preventDefault();

      if (!MEDUSA || !MEDUSA_PUBLISHABLE_KEY) {
        setMessage(form, 'Newsletter is not configured yet.', 'error');
        return;
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      var emailInput = form.querySelector('input[type="email"]');
      var email = emailInput ? String(emailInput.value || '').trim() : '';
      if (!email) return;

      var locale = readLocalePreference();
      var source = form.getAttribute('data-newsletter-source') || 'storefront';

      setBusy(form, true, 'Subscribing…');
      setMessage(form, 'Submitting your subscription…', '');

      fetch(MEDUSA + '/store/newsletter/subscribers', {
        method: 'POST',
        headers: medusaHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify({
          email: email,
          source: source,
          storefront_origin: window.location.origin,
          page_url: window.location.href,
          page_title: document.title,
          locale_country: locale.country || undefined,
          locale_language: locale.lang || undefined,
          metadata: {
            pathname: window.location.pathname,
          },
        }),
      })
      .then(function(response) {
        return response.json().catch(function() { return {}; }).then(function(data) {
          if (!response.ok) {
            throw new Error(data && data.message ? data.message : 'Could not subscribe right now.');
          }
          return data;
        });
      })
      .then(function(data) {
        form.reset();
        setMessage(
          form,
          data && data.already_subscribed
            ? 'This email is already subscribed to our newsletter.'
            : 'Thank you. You are now subscribed to our newsletter.',
          'success'
        );
      })
      .catch(function(error) {
        setMessage(
          form,
          error && error.message ? error.message : 'Could not subscribe right now. Please try again.',
          'error'
        );
      })
      .finally(function() {
        setBusy(form, false);
      });
    });
  });
})();
</script>

