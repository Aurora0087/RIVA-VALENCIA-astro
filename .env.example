# Shopify Storefront API credentials
# Copy this file to .env and fill in your values

# Your Shopify store domain (without https://)
# Example: my-store.myshopify.com
PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token
# Get it from: Shopify Admin → Apps → Develop apps → Your app → Storefront API access token
# Required permissions: unauthenticated_read_product_listings, unauthenticated_read_product_inventory
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token

# Customer Account API OAuth client ID
# Shopify Admin -> Sales channels -> Headless/Hydrogen -> Customer Account API settings
# Add your production/tunnel callback URL in Shopify:
# https://your-domain.example/account/callback
PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-customer-account-api-client-id
PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_SCOPE=openid email customer-account-api:full

# Optional: paste these from Shopify Customer Account API settings if discovery is blocked.
# PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_AUTHORIZATION_ENDPOINT=https://shopify.com/authentication/{shop_id}/oauth/authorize
# PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_ENDPOINT=https://shopify.com/authentication/{shop_id}/oauth/token
# PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_ENDPOINT=https://shopify.com/authentication/{shop_id}/logout
# PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_GRAPHQL_ENDPOINT=https://your-store.myshopify.com/customer/api/2026-04/graphql
